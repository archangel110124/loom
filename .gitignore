/target
*.spv
/assets/test/**/*.actual.png

# Scene write machinery: a lock sidecar sits beside any scene that gets
# written, and an interrupted atomic write can leave its temporary behind.
.*.lock
.*.tmp

# Stray renders from manual checks. Renders belong in a temp dir.
render.png

# Worktrees live inside the repo but are separate checkouts, never content.
.claude/worktrees/

# `loom render --frames` writes telemetry beside its output, so a relative
# `--out` lands one of these at the repo root. Harmless, and not content.
telemetry.csv
