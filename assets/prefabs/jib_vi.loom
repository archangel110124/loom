[[asset]]
key = "chest_lid"
id = "ed4ccc5c-c6e2-4330-b6c1-3deb28ac3b1a"
path = "../meshes/jib_vi_chest_lid.obj"

[[asset]]
key = "green"
id = "c4ea1dcc-ae44-4753-9fe2-8832d92f6d0b"
path = "../meshes/jib_vi_green.obj"


# hull_white — albedo is the exporter's own Kd, restated here because the
# engine never reads the .mtl.
[[node]]
name = "hull_white"
parent = "Boat"

  [node.components.MeshRenderer]
  mesh = { asset = "hull_white" }

  [node.components.Material]
  albedo = [0.9, 0.9, 0.88]
  roughness = 0.42
  metallic = 0.0

