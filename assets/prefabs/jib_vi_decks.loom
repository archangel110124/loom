# --- the deckhouse, as a shell with a door in it ---------------------------
#
# One box became five. Every outboard face is exactly where the solid box's
# was — |z| = 1.50, x = -6.20 and 2.20, y 0.39 to 3.05 — so **the side deck is
# the 1.20 m it always was** and nothing outside the house moved. What changed
# is that the inside is now inside.
#
# The inboard faces sit on the drawn inner skin at |z| = 1.22, which leaves the
# salon 2.44 m across. The sole under it is already there: `col_deck_aft`
# reaches x = -6.05, `col_deck_mid` -6.15 to 0.05 and `col_deck_fwd` on to
# 2.65, so the threshold and the whole room are floored. The deckhead is
# `col_fly_deck` at 2.78 — 2.16 m over the sole.

[[node]]
name = "col_house_port"
parent = "Decks"
transform = { pos = [-2.00, 1.72, -1.36] }

  [node.components.BoxCollider]
  half_extents = [4.20, 1.33, 0.14]

[[node]]
name = "col_house_stbd"
parent = "Decks"
transform = { pos = [-2.00, 1.72, 1.36] }

  [node.components.BoxCollider]
  half_extents = [4.20, 1.33, 0.14]

# The after bulkhead, in two pieces with the doorway between them. The drawn
# opening is z +0.16 to +1.08; these stop at exactly those numbers, so the
# collider gap and the hole in the mesh are the same hole. 0.92 m of it against
# a 0.70 m capsule — 0.11 m of clearance a side, which is a door you walk
# through rather than one you aim at.
[[node]]
name = "col_house_aft_port"
parent = "Decks"
transform = { pos = [-6.15, 1.72, -0.72] }

  [node.components.BoxCollider]
  half_extents = [0.05, 1.33, 0.78]

[[node]]
name = "col_house_aft_stbd"
parent = "Decks"
transform = { pos = [-6.15, 1.72, 1.34] }

  [node.components.BoxCollider]
  half_extents = [0.05, 1.33, 0.16]

# **No header box over the door, deliberately.** The drawn header is at 2.60
# and a capsule standing on a 0.62 sole reaches 2.42, so the strip above it is
# unreachable by walking; jumping into it arrives inside the room, which is
# where the door leads anyway. A box there would collide with nothing.

# The forward end of the salon, across the full house width. `col_house_fwd`
# below is only |z| <= 1.05, so without this a player could walk forward out of
# the salon at |z| 1.05-1.22 and end up inside the drawn cabin side.
[[node]]
