# --- THE HULL BELOW THE DECK, WHICH HAD NO COLLIDER AT ALL -----------------
#
# > "Up under the ship, if you get in the water, you don't collide with the
# > side of the ship and can literally just go up under it and see all the
# > insides."
#
# **True, and it was total rather than leaky.** The hull's own `BoxCollider` in
# `jib_vi.loom` is demoted to mass-only the moment this file attaches a plate
# (ADR 0060, `play.rs::demote_to_mass_only`) — which is right, or the deck is a
# lid a metre in the air — and every box above this line starts **at or above
# y = 0.30**: the plates at 0.315 and the bulwarks at 0.30. The waterline is 0.
# So from the keel at -1.65 up to 0.30 the boat was open water, along her whole
# length and both sides.
#
# Measured, before these boxes existed. A swimmer spawned two metres off her
# port topside at `assets/test/rig_underhull.loom`, holding one key:
#
#   tick   30   z -15.185      <- outside her
#   tick   60   z -14.234
#   tick   90   z -13.285      <- her drawn topside is at -13.75
#   tick  150   z -11.385      <- amidships, inside the hull
#   tick  300   z  -6.635      <- out the far side and under the rig
#
# 1.9 m/s all the way through, not a tick of deceleration anywhere.
#
# **Sized to the waterline beam, not the maximum beam, because the swimmer's
# eye is at the waterline.** `deeper_player.rhai` floats a capsule at centre
# -0.70 with its head at +0.20 and its feet at -1.60, so the eye rides at
# +0.05 and the only section he can ever see or touch is the one there. Each
# box takes the drawn half-beam at y = +0.10 over its own span, marched off the
# shipped meshes:
#
#   x    -9.4  -7.9  -6.4  -4.9  -3.4  -1.9  -0.4   1.1   2.6   4.1   5.6
#   |z|  2.30  2.46  2.56  2.64  2.70  2.71  2.65  2.47  2.11  1.49  0.75
#
# Below that they are wider than the hull — at the keel, much wider — and that
# is deliberate and costs nothing: a swimmer cannot dive. `vy` in the water is
# `(FLOAT_Y - y) * FLOAT_RATE` and nothing else, so -0.70 is a ceiling *and* a
# floor and there is no input that reaches the turn of the bilge.
#
# **They stop at y = +0.40**, which overlaps the deck plates and the bulwark
# feet rather than meeting them, so there is no seam at the sheer for a capsule
# to find. Above that the existing boxes own the walk.
#
# `ponytail:` seven axis-aligned boxes against a hull that tapers. Worst
# overshoot is at the fat end of a segment — 0.33 m at x = 5.1 and about 0.5 m
# near the stem, where the drawn hull is a knife edge and any box overshoots.
# Everywhere aft of x = 2 it is under 0.16 m, which is inside the capsule's own
# radius. Yaw them in pairs like the bulwarks if that ever has to be tighter.
#
# **Every one weighs nothing** — `attach_box` builds them with
# `ColliderMassProps::Mass(0.0)` — so `jib_vi.loom`'s stability arithmetic is
# untouched, exactly as it is by the plates above.

[[node]]
name = "col_hull_stern"
parent = "Decks"
transform = { pos = [-8.225, -0.65, 0.0] }

  [node.components.BoxCollider]
  half_extents = [1.325, 1.05, 2.40]

[[node]]
name = "col_hull_quarter"
parent = "Decks"
transform = { pos = [-5.15, -0.65, 0.0] }

  [node.components.BoxCollider]
  half_extents = [1.75, 1.05, 2.60]

[[node]]
name = "col_hull_mid"
parent = "Decks"
transform = { pos = [-1.65, -0.65, 0.0] }

  [node.components.BoxCollider]
  half_extents = [1.75, 1.05, 2.66]

[[node]]
name = "col_hull_fwd"
parent = "Decks"
transform = { pos = [1.10, -0.65, 0.0] }

  [node.components.BoxCollider]
  half_extents = [1.00, 1.05, 2.42]

[[node]]
name = "col_hull_shoulder"
parent = "Decks"
transform = { pos = [2.85, -0.65, 0.0] }

  [node.components.BoxCollider]
  half_extents = [0.75, 1.05, 1.98]

[[node]]
name = "col_hull_bow"
parent = "Decks"
transform = { pos = [4.35, -0.65, 0.0] }

  [node.components.BoxCollider]
  half_extents = [0.75, 1.05, 1.35]

[[node]]
name = "col_hull_forefoot"
parent = "Decks"
transform = { pos = [6.00, -0.65, 0.0] }

  [node.components.BoxCollider]
  half_extents = [0.90, 1.05, 0.55]

