# =============================================================================
# DEEPER — the demo
# =============================================================================
#
#     loom run assets/games/deeper_demo.loom --play
#
# That is the whole thing. `--play` is not optional: without it `run` opens the
# read-only viewer, paused, and every `Hud` here is `only_in_play`, so you get a
# frozen diorama with no instructions on it. `--play` alone builds no editor
# panels; add `--edit` if you want them.
#
# **You do not start on the deck.** `--play` opens on the title screen: the rig
# seen from 50 m off with the sun behind it, the word DEEPER over the water, and
# Start and Quit. Escape there closes the window, which the screen says out
# loud. Start runs a 1.5-second curtain — half a second to black, a quarter of
# black while the world is built, then eight tenths back up on your own eyes —
# and the window opens *black* and lifts into the shot, so the half second this
# scene takes to load happens behind a curtain rather than as a stall. See THE
# FRONT END at the foot of this file for the camera, and `loom_cli::hud` for the
# curtain. Nothing in it is simulated: the front end is a camera, a rectangle
# and two buttons, and the sea moves behind it because the water's clock is the
# wall clock and always has been.
#
# **Play it in a window at least 960 px wide.** Both HUD rows are centre-
# anchored, so a narrower window clips them at both ends. The longest line the
# game can say lays out at 840 px, and
# `loom_cli::hud::the_longest_demo_caption_fits_the_narrowest_documented_window`
# is the test that keeps it that way.
#
# There are **four things in this demo and no fifth**: a hub, a boat you can
# drive, fishing you can do, and four slots to carry things in. It is a demo. It
# is playable end to end and it is not a game.
#
# The hub is the GDD's §7 — a rusted floating platform lashed to the surface
# above the trench, part oil rig, part fishing wharf. Early game it is the cozy
# tonal baseline, so it is bright, warm and low-fog: the "before" the rest of
# the game is measured against.
#
#
# -----------------------------------------------------------------------------
# THE CONTROLS
# -----------------------------------------------------------------------------
#
#   on the rig       W A S D walk, SHIFT sprint, SPACE jump
#
#   on `HelmMat`     W ahead, S astern, A wheel to port, D wheel to starboard.
#                    **SPACE is hands off the wheel** and gives you your legs
#                    back. Nothing pressed is neutral; she coasts to a stop.
#
#   anywhere aboard  **CLICK casts, and clicks again to set the hook. SHIFT
#                    reels. The rod is in your hands**, so there is no station
#                    to stand at — cast from the cockpit, the foredeck or the
#                    salon door. Both keys are refused ashore, by never being
#                    sent rather than by a rule that says no.
#
#   in the water     W A S D swim, at under half walking pace. The caption
#                    names the nearer of the two ramps and the compass word for
#                    where it lies, computed from where you are.
#
#   **E**            use what you are standing at, and it is the only key in
#                    this demo that works ashore as well as aboard. What it
#                    does is decided by where you are, in this order:
#
#                      at the crate, with a catch below   the trip closes
#                      at the yellow fish box             it goes below
#                      a fish on the line                 into your hands
#
#   **ESC**          the pause menu — Resume and Quit, over a scrim — and in
#                    its top right, ROOM CODE with a twelve-symbol code under
#                    it, drawn fresh from the operating system every time the
#                    window opens. **Nothing can join it yet.** The code is the
#                    front end of a multiplayer decision that has been made and
#                    not built: host-authoritative with input replication, and
#                    the next step is a second local player, not a socket. See
#                    `docs/decisions/0065-a-room-is-named-before-it-can-be-joined.md`.
#
# **THE CATCH IS SOMETHING YOU DO NOW, AND IT USED TO BE SOMETHING THAT
# HAPPENED.** A landed fish arrived in a slot on the tick it came over the rail
# and was put below because the player had walked near a box. Both were written
# when the engine had five digital channels — `move_x`, `move_z`, `jump`,
# `sprint`, `fire` — and no sixth to bind a verb to, so a *place* was the only
# budget there was. There is a sixth now, `interact` on E, and the whole tail of
# the loop is on it: she hangs off the rod tip until you take her off, and she
# goes below when you ask.
#
# **The helm and the four supplies are deliberately still places.** The helm is
# a stance rather than an action and already has its own way out (SPACE); the
# supplies lie along the one gesture this demo teaches, and putting them on a
# key would mean a first-timer who holds W arrives at the boat with an empty
# hold. Converting either is a decision, not a gap.
#
# **Reel is SHIFT, not W** — W is the throttle at the wheel and your legs
# everywhere else. The cost, stated: aboard, SHIFT is reel *and* still sprint,
# so sprinting round the cockpit with a fish on loads the line. That is a dozen
# ticks of stress on a hundred-point meter.
#
# **SPACE on the mat is the only control here that is not a place**, and it
# exists because the alternative was worse: with no legs on the mat, the only
# way off was jump-plus-a-direction, and that direction was simultaneously the
# wheel — so leaving the helm put you in the sea twelve metres astern of a boat
# you had just spun.
#
#
# -----------------------------------------------------------------------------
# THE LOOP, IN THE ORDER YOU MEET IT
# -----------------------------------------------------------------------------
#
#   1. You spawn on the rig facing a boat, and **hold W**. Four supplies lie
#      along the walk, alternating sides of the lane, so the taught gesture
#      fills the whole hold on the way. Aboard by tick 180, at the wheel by 356.
#   2. You are at the wheel and under way; channel marks stream past to port
#      about one every 2.7 s, which is how you can see that you are moving.
#      `Rig/Boat.x` reaches 29.89 by tick 900.
#   3. **SPACE.** You have let go of the wheel and the caption changes.
#   4. **CLICK.** The rod in your hands casts — from wherever you are standing,
#      because it is in your hands. Wait, and a fish takes it — the float goes
#      clean under for the 600 ms the take is answerable in.
#   5. **CLICK again inside that window** to set the hook, then hold SHIFT to
#      reel and let go when she runs. The blank bends with the load: all
#      twenty-four joints read `state.stress`. **Off beats on** — every cadence
#      that lands a fish has more release than pull, which is the skill.
#   6. Land it and **she hangs off the rod tip**, swinging, with the line still
#      through her. **Press E** and she comes off into your hands — into the
#      slot the bait she ate has just freed, and the bottom row shows `[ ><> ]`
#      where that bait was. SPACE, then follow the caption: it names the yellow
#      fish box in metres in *your* frame, and the bait box is between you and
#      it, so the walk is a dogleg. **E again at the box** and she goes below.
#
#      With all four slots full she stays on the line and the caption says so.
#      That is recoverable rather than a loss: E at the fish box takes a catch
#      off the line as well as out of your hands, so the box is always the way
#      out of a full hold. Nothing is ever thrown back.
#   7. Take her home. **You left ahead, so astern is how you come back**, and
#      the helm caption carries `HOME nn m — hold S`. Step off over the boarding
#      steps and walk west along the wharf to the crate. **E**, and `CRATE` goes
#      up. Then take bait and go again.
#
# The bait is what makes it a loop rather than a checklist: the fish eats yours
# at the take, and there is none at sea.
#
#
# -----------------------------------------------------------------------------
# SHE IS A SOLID OBJECT NOW, AND SHE WAS NOT
# -----------------------------------------------------------------------------
#
# Three things a player found in one sitting, and they were one bug: the hull
# was **drawn** solid and **collided** as a lid with a deckhouse-shaped brick on
# it. The hull's own `BoxCollider` is demoted to mass-only the moment
# `jib_vi_decks.loom` attaches a deck plate (ADR 0060) — which is right, or you
# stand on an invisible lid a metre above the deck — and every box in that
# prefab started at or above y = 0.30 against a waterline of 0.
#
#   * **You could swim through her.** Not leak through: *through*. Two metres
#     off her port topside, holding one key, a swimmer crossed the hull at a
#     flat 1.9 m/s and came out thirteen metres the other side. Seven underbody
#     boxes now carry her section from the keel up to the sheer.
#   * **You could not get into the salon**, which is the best-looking room on
#     the boat and visible through her windows the whole time. Her after
#     bulkhead has a 0.92 m door in it and 2.2 m of headroom behind it; the
#     collider was one solid block, authored on a headroom measurement taken
#     off the *previous* hull mesh.
#   * **You could not get back aboard.** `Rig/Boat/SternLadder` is the answer
#     and it is the only thing here that is new geometry rather than corrected
#     collision. The caption in the water names it when it is the nearer way
#     out, which at the fishing ground it always is — the rig is 88 m away.
#
# Each has a row in `scripts/green.sh` and a scene of its own:
# `rig_underhull.loom`, `rig_salon.loom`, `rig_reboard.loom`.
#
#
# -----------------------------------------------------------------------------
# FOUR DECISIONS WORTH KNOWING BEFORE YOU CHANGE ANYTHING
# -----------------------------------------------------------------------------
#
# **1. What the player is.** `Rig/Player` is a `CharacterController` 1.8 m tall,
# driven by `../scripts/deeper_player.rhai`, with `Rig/Player/Eye` carrying the
# `Camera` as its child. That parenting is not decoration:
# `World::player_character` walks *up* from the active camera to the nearest
# ancestor with a `CharacterController`, so **parenting the camera to the
# character is what makes it the player**, and it is also what makes the rig
# first person. There is no `Player` flag component and there must not be one.
#
# The movement script is not `fps.rhai` because that one detonates a 5 m blast
# where the view ray lands on `fire`, and the centrepiece of this scene is a
# 43,776 kg dynamic rigid body. `fire` arrives here unspent, for fishing.
#
# **The scene is turned, not the camera.** `Play::start` takes its opening yaw
# from the eye node's authored rotation and then writes yaw onto the character,
# leaving the eye's own yaw underneath — so an authored eye yaw is counted twice
# and an authored character yaw is overwritten. Neither can express "start
# facing this way". So the berth is on −Z, which is where yaw 0 looks, and
# `loom render` and `loom run` agree about the opening shot. (That double-count
# is a real engine wrinkle and worth an issue; it was not worth an engine change
# inside a demo round.)
#
# **2. Where the four slots live.** In `GameRules` state, as `state.hold` and
# `state.carried`, owned by `../scripts/deeper_rules.rhai` — the alternatives
# (a movement script's `memory`, the event log) are weighed and rejected in that
# file's header. Short version: `memory` is invisible to both `loom sim --assert`
# and the `Hud`, and the event log is a record rather than a container.
#
# The slots are also four named numbers — `bait`, `line`, `lantern`, `thermos` —
# beside `infish`, `stowed` and `full`, with the events `pickup`, `spend`,
# `stow`, `refused` and `deliver`. **The cost, stated:** `state` is not in
# `state_hash`, so `cargo test` and `cargo xtask repeat` are blind to the hold
# and `--assert` is its only detector. Same bargain the fight makes.
#
# **3. The sea is the safety device, not the railing.** The rig was sealed on
# four sides in round 1 and the seal leaked anyway: walk into any rail at
# walking pace, keep pressing, and hop — the capsule's rounded foot catches the
# cap bar's inner edge at the jump apex and climbs over. A taller rail cannot
# fix it (the height a solid wall would need is above the player's own eye) and
# the berth has to open anyway or nobody can board. So instead:
# `deeper_player.rhai` **floats** a capsule that goes under, the slipway at the
# east end lets it walk back out, and `assets/test/rig_overboard.loom` asserts
# both with the real player model and no teleport. The rails are set dressing.
#
# **4. The helm is a place, and the layout exists so nobody has to be told.**
# The player spawns at x = −3.70 facing the gap in the berth railing; the gap is
# where the boat's cockpit is; the cockpit is where `HelmMat` is drawn. Walk
# forward and you board her, arrive at the wheel and get under way, on one key.
# The boarding lane is **24 degrees wide** — `move_x` from −0.21 to +0.21 all
# reach the wheel by tick 600 — and the whole hold fills across −0.15 to +0.15.
#
#
# -----------------------------------------------------------------------------
# DELIBERATELY ABSENT
# -----------------------------------------------------------------------------
#
# * **Selling, money, progression, quests, NPCs, day/night.** Out of scope. This
#   is four features and no fifth.
# * **A second fishing spot, a second boat, a second fish species.** The demo
#   proves the loop, not its variety.
# * **A line from the rod tip to the float, or to the fish hanging off it.** It
#   is a second node whose length is a scale, and it is the obvious next thing —
#   more obvious now than it was, because the rod is in your hands and its tip
#   is a metre and a half from the camera rather than eight metres away. At six
#   metres to the float a real one is thinner than a pixel; to the fish it would
#   not be.
# * **A dead man's handle.** Not needed: leaving the mat makes `at_helm` false
#   while `aboard` stays true, so `deeper_player.rhai` writes zero thrust on the
#   next tick. Measured on `rig_drive` with `--hold "jump=1,move_z=1"`: x = 3.0002
#   at tick 300, 2.9998 at 900, 3.0004 at 1800, from a berth at 3.0.
# * **Moving wheel, throttle and shifter.** All four movable parts in
#   `jib_vi.loom` are separate meshes with no transform of their own, so each
#   one's pivot is the hull's origin up to nineteen metres away and rotating the
#   node swings the part across the boat. The *scripting* half is solved — a node
#   `Script` reads the rules script's numbers, which is what bends the rod — so
#   what is missing is mesh work and only mesh work.
#
#
# -----------------------------------------------------------------------------
# KNOWN ISSUES — what a player will hit that is NOT fixed
# -----------------------------------------------------------------------------
#
# Ranked by how likely a first-timer is to meet it. None is a stopper; all are
# seams.
#
# 0. **Nobody has watched the title screen.** Every part of it that can be
#    checked without a window is checked — the shot is rendered and looked at,
#    the curtain's curve, the menu's words, the layer it is painted in and its
#    refusal to eat clicks are all unit tests — and none of that is the same as
#    seeing it. `loom run` needs a real window and this box has no Xvfb, so the
#    pace of the fade, whether 96 pt Ubuntu-Light reads as a title or as a debug
#    overlay, whether the pointer hand-off at the bottom of the curtain is
#    clean, and whether a still shot with a moving sea reads as alive are all
#    unanswered. Three durations, one scrim and one offset are the knobs; expect
#    to move them.
# 1. **You drive home stern-first at a wharf you cannot see.** The berth faces
#    the way it faces, so the leg the demo teaches leaves ahead and returns
#    astern with the destination behind the camera. Photographed at the arrival
#    beat: sea, sky and a rod, with the rig 180 degrees behind. The caption
#    answers it with a range and a key, which is the cheap half. The real fix is
#    geometric — berth her bow-in, or give the helm a stern view — and it turns
#    every pinned drive number in `scripts/green.sh` from an X into a Z, and
#    lands the helmsman a metre from the after face of the deckhouse. That is a
#    round, not a bullet.
# 2. **The landed fish reads as a mitten.** It tracks your hands correctly and
#    it is in your own frame now rather than off her port beam, so turning no
#    longer swings it out over the sea. What is left is the mesh: a grey-green
#    body with five splayed rays. Mesh work, not a scene edit.
#
#    **And it is still attached to nothing**, in both poses. On the line it
#    hangs at the rod tip with a metre of air where the line should be; in your
#    hands there is no hand. See DELIBERATELY ABSENT.
# 3. **Every close render is dense salt-and-pepper.** That is ADR 0019's
#    eight-ray AO dither. Two sweeps found no scene-level knob that reaches it —
#    ambient is flat across 2.4x, the sun about a ninth of it — and the cure is
#    the quad-wide sample share in that ADR, which moves all 54 references.
# 4. **A hard turn to port stops the boat.** The channel marks are static
#    colliders nine and a half metres to port — the side the demo teaches you to
#    watch — so the same input mirrored has two outcomes. `state.pinned` says so
#    in the caption (`PUSHING ON SOMETHING   S to back off`) but does **not** cut
#    the throttle: she grinds on the buoy until you press S. Cutting it is a
#    force-path change and wants its own ADR.
# 5. **`state.aboard` is stale by about eighty ticks** after you step ashore, so
#    the arrival caption uses the aboard branch while you stand on the wharf.
#    Both branches now say the same useful thing, so it is cosmetic.
# 6. **A hard turn can bounce the helmsman off the mat.** `at_helm` flickers for
#    about seventy-five ticks and the caption drops back to the teaching line —
#    which also resets `state.pinned`, so issue 4's warning can flicker mid-jam.
#    He is never in danger and steps back on by himself.
# 7. **Hold W and SPACE together from the spawn and you wedge for ever.** SPACE
#    on the mat is hands-off, so the throttle never opens and the pair pushes
#    into the cockpit geometry. Releasing either key clears it.
# 8. **Wedged aboard with an empty hold, `BLOCKED` still says `go round it`**
#    without naming what has you. There are **thirty-seven** colliders on that
#    hull now and nobody has worked out which. The likeliest new one is the
#    salon door: press starboard-and-slightly-aft while standing in it and the
#    capsule can catch the jamb, which is why the collider gap is 1.12 m
#    against a drawn opening of 0.92 — see `jib_vi_decks.loom`.
# 9. **The deck is beige and the hub reads pale.** A palette pass, not a boat.
# 10. **You walk through the settees, the tables and the wheelhouse console.**
#    The deckhouse is collided as a shell and its furniture is not, on the
#    grounds that colliding the console costs the wheelhouse outright: the
#    passages either side of the drawn one are 0.14 m clear against a 0.70 m
#    capsule. So the salon is a room you can walk into and the fittings in it
#    are painted on. `jib_vi_decks.loom` states the trade where the boxes are.
# 11. **The rod is a view-model and clips.** It is posed 0.55 m in front of the
#    eye and 0.45 m below it — a first-person cheat, because the anatomically
#    right grip at chest height is 76 degrees below a 37.5 degree half-FOV and
#    entirely off the bottom of the frame. Two metres of blank at that offset
#    reaches 2.3 m ahead of the eye, so **anything nearer than that is inside
#    it**, and nothing depth-biases a view-model here.
#
#    **Stated from the geometry, not from a reproduction.** Two attempts to
#    walk into the deckhouse and photograph it went round the outside instead;
#    what is measured is the offset and the blank length, not a screenshot of
#    the artifact.
#
# 12. **The rod does not point where you look in pitch, only in yaw.** A rules
#    script publishes the player's flat heading and nothing else, so the blank
#    sits at a fixed 60 degrees of elevation whether you are looking at the sky
#    or at your feet. It reads fine because a real rod is held at an angle to
#    the eye anyway, and fixing it means publishing a pitch nothing else wants.
#
# 13. **The stern ladder adds 3.4 m to her length and it is always there.**
#    A 45 degree ramp from y = -1.80 to her transom cap is 3.42 m of run and
#    nothing shortens it (that file's block says what else was measured). A
#    real one folds; this one cannot, because a node script may write a
#    transform and there is no key left to ask it with.
#
#
# -----------------------------------------------------------------------------
# HOW THIS IS TESTED
# -----------------------------------------------------------------------------
#
# Section 6 of `scripts/green.sh` — 18 scenes and 7 blocks of deliberately wrong
# input, about two minutes. It runs the whole trip on **this file** from a
# keyboard tape (`--hold "<tick>:<keys>"`, the same field `loom run` writes when
# a human holds a key) and asserts `state.delivered == 1` at the end of it.
#
# **The tape now presses E three times and the ticks are measured, not chosen.**
# `DEMO_FIGHT` / `DEMO_BOX` / `DEMO_HELM` / `DEMO_HOME` are declared once in
# that file and nest; eight rows used to carry a verbatim copy of the same
# forty-key cadence. Aiming a press also found a stale claim: the comment on the
# `rig_trip` row said the catch was stowed at tick 1310 on the walk across the
# cockpit, and the closest that walk ever comes to the hatch is **2.08 m**
# against a `RANGE` of 2.0 — the proximity stow it described was actually firing
# on the way ashore, six hundred ticks later. A place fires wherever you happen
# to be; a key has to be aimed, so it says where you are.
#
# `assets/test/rig_*.loom` are **not forks.** Each is an `extends` of this file —
# `rig_trip.loom` is 16 non-comment lines, `rig_adrift.loom` is 24 — adding one
# node and inheriting everything else, so they cannot drift from it. An earlier
# note here called them "1,900-line forks" and that was simply wrong.
# `rig_trip.loom` adds a `Pilot` so the fight plays itself while a tape sails the
# boat; `rig_adrift.loom` leaves her 21 m off the crate and swims the player home,
# which is the control that proves the crate refuses a hull that is not alongside.
#
# **What no gate can see:** the overlay. `Hud` draws only in `loom run`, so a
# headless render shows neither row, and a `grep` on `game.message` proves a
# string was produced — never that it was legible or drawn. The one measurement
# that exists is the width test named at the top of this file.
#
[scene]
format = 1
id = "b2a43f8f-314a-4d92-b4aa-322411869fcd"

# The hull, its paint and its twelve pontoons, from the file that owns them.
[[prefab]]
key = "jib_vi"
id = "3c7a5e12-8b64-4f09-a2d3-6e1b90c47f58"
path = "../prefabs/jib_vi.loom"

# The deck a person stands on. See that file's header: the hull's own collider
# is its inertia and its lid is a metre above the deck, so without this the
# boat is a brick you stand on top of.
[[prefab]]
key = "jib_vi_decks"
id = "3c7a5e12-8b64-4f09-a2d3-6e1b90c47f59"
path = "../prefabs/jib_vi_decks.loom"

# The rod and its reel, from the file that owns them. Twenty-four of its nodes
# carry `../scripts/rod_bend.rhai`, so it loads up when the fight does, and its
# root carries `../scripts/rod_hold.rhai`, so it is in the player's hands.
[[prefab]]
key = "rod"
id = "7f2c14a9-63d8-4e51-b0a7-2d9e5c81f430"
path = "../prefabs/fishing_rod.loom"

# The channel marks. See "THE MARKS", below.
[[prefab]]
key = "buoy"
id = "1a6f42d7-58b0-4e93-9c21-7d4b6e0f3a85"
path = "../prefabs/channel_buoy.loom"

# The catch, in the two meshes it ships as: `_chrome` is the body and
# `_coral` is every fin and the tail. Rendering only the body gives a pale
# featureless lozenge, which is what the first attempt looked like.
# 0.10 m nose to tail as it ships, so `fish_hang.rhai` scales it.
[[asset]]
key = "gleamsprat"
id = "6537b1f4-2257-44de-9ba2-a4b0b56d7085"
path = "../meshes/gleamsprat_chrome.obj"

[[asset]]
key = "gleamsprat_fins"
id = "b3a90c47-1f52-4d68-9e04-5c7218ab3d61"
path = "../meshes/gleamsprat_coral.obj"

[[asset]]
key = "box"
path = "box"

[[asset]]
key = "cylinder"
path = "cylinder"

# ---------------------------------------------------------------------------
# THE WORLD
# ---------------------------------------------------------------------------

[[node]]
name = "Rig"

  [node.components.GameRules]
  path = "../scripts/deeper_rules.rhai"

  # Bright, warm, low sun. The GDD asks the hub to be the cozy baseline, and
  # every later escalation is a change to these seven numbers rather than to
  # the geometry.
  [node.components.Environment]
  sun_direction = [0.42, 0.46, -0.78]
  sun_strength = 1.25
  sun_color = [1.0, 0.93, 0.80]
  ambient = 0.45
  sky_zenith = [0.16, 0.30, 0.52]
  sky_horizon = [0.74, 0.72, 0.66]
  fog_density = 0.0028
  fog_falloff = 0.05

  # Light air. Enough to move the surface; far too little to trouble the boat.
  [node.components.Wind]
  direction_degrees = 20.0
  speed = 3.0
  gustiness = 0.25
  turbulence = 0.15

# **`deterministic`, not `cinematic`.** ADR 0053's cinematic tier is read back
# off the GPU and `loom sim` refuses the whole run rather than answer a `water@`
# assertion approximately. A scene the demo's tests are run against gets the
# height-field tier; the beauty shot can have its own file.
[[node]]
name = "Water"
parent = "Rig"

  [node.components.WaterBody]
  kind = "ocean"
  simulation = "deterministic"
  surface_height = 0.0
  density = 1000.0
  drag = 2.0

# ---------------------------------------------------------------------------
# YOU
# ---------------------------------------------------------------------------

# Deck top is 1.40 and the capsule's origin is its centre, 0.90 above its feet,
# so 2.30 is standing. 2.40 is a 10 cm drop onto the deck on the first tick,
# which is how every character scene in this repository starts: it proves the
# floor is there rather than assuming it.
[[node]]
name = "Player"
parent = "Rig"
transform = { pos = [-4.30, 2.40, 0.90] }

  [node.components.CharacterController]
  height = 1.8
  radius = 0.35
  # **0.10, not the default 0.35, and this is the other half of the rail.**
  # `step_height` is what the controller will silently lift the capsule onto,
  # and it applies in mid-air: at the top of a hop the capsule's feet are
  # within a step of the rail cap, so the controller mounts it, walks the
  # 0.2 m cap and drops off the far side into the sea. Measured, on
  # `rig_walk` — the pilot crossed x = 11.50 at y = 3.61, rose to 3.75 over
  # the next eight ticks, and was at y = -970 by tick 900.
  #
  # Nothing on this rig is a stair, so the step buys nothing here and costs
  # that. **The boarding round will want it back** — the bulwark is a 0.22 m
  # rise from the wharf — and when it raises this number it has to re-check
  # the rail against the same sum: rail top must exceed the jump apex's foot
  # height plus this. Today that is 2.733 + 0.10 against a cap at 2.90.
  step_height = 0.25

  [node.components.Script]
  path = "../scripts/deeper_player.rhai"

[[node]]
name = "Eye"
parent = "Rig/Player"
transform = { pos = [0.0, 0.75, 0.0] }

  [node.components.Camera]
  fov_y_degrees = 75.0

# ---------------------------------------------------------------------------
# THE RIG
#
# A 24 x 14 m deck on six pilings, railed the whole way round. Every
# piece here is a `box` or a `cylinder` with a `MeshRenderer` and no collider:
# a renderable node with no dynamic ancestor becomes a static collider from its
# own drawn bounds, so what is walked on is exactly what is seen. That
# equivalence is the whole reason nothing here is an invisible ramp.
# ---------------------------------------------------------------------------

[[node]]
name = "Deck"
parent = "Rig"
transform = { pos = [0.0, 1.20, 0.0], scale = [12.0, 0.20, 7.0] }

