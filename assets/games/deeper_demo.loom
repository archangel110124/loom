# ---------------------------------------------------------------------------
# THE MIRROR — a material, not a feature. Nothing was built for this.
# ---------------------------------------------------------------------------
#
# `scene.slang` calls `tracedEnvironment` unconditionally for every opaque
# fragment — ADR 0019 measured a roughness cutoff on it and DELETED it — and
# mixes the result in as `environment * f0 * (1 - roughness*0.7)`. At
# `metallic = 1.0` the `f0` IS the albedo, so a light grey metal at roughness 0
# returns ~95% of the traced radiance. That is the mirror. No planar pass, no
# second camera, no mirrored-projection matrix, no ADR.
#
# **One traced ray carries 97% of the direct view's high-frequency detail**, and
# the knee is between roughness 0.10 and 0.20:
#
#     roughness  0.00  0.05  0.10  0.20  0.35  0.55
#     detail      97%   90%   85%   63%   43%   25%
#
# So it ships at 0. ADR 0061's reflection jitter does not apply — every line of
# it is inside the cinematic marched-water lane — and a flat mirror's lobe is a
# delta function that one ray samples exactly.
#
# **IT FACES INWARD, AND THAT IS THE WHOLE PLACEMENT ARGUMENT.**
# `build_instances` filters the TLAS to MESHES. Water, grass, rain, fire, smoke
# and every particle are generated from `SV_VertexID` and are not in the
# acceleration structure at all, so a mirror pointed at the sea reflects a hole
# where the sea is. Pointed at the shed it reflects the deck, the rail, the
# crates, the mast, the boat — and you. It is on the shed's north face
# (z = 2.60), 1.7 m due south of the spawn point and dead centre.
#
# **The frame is not decoration.** Without it the glass is invisible wherever it
# reflects sky, because that sky is the same sky behind the wall.
#
# Two limits, both real. A reflected hit is shaded diffuse-only, so the
# reflection comes back several times darker than the direct view — which is
# why this character is built out of one bright feature (the sou'wester) and one
# secondary (the hands) against near-black. And a reflected hit has no
# reflection of its own: two facing mirrors give one bounce, then flat albedo.
#
# **THE FRAME GOES BEHIND THE GLASS, AND GETTING THAT BACKWARDS COSTS AN HOUR.**
# A `box` frame 30 mm proud all round, drawn 5 mm in FRONT of the mirror, does
# not read as a border — it is a lid. Rendered that way the panel is a flat
# dark rectangle with a barely-readable ghost in it, and every reasonable next
# move makes it worse: four lamp positions and four intensities were measured
# against that panel and all of them were measuring the FRAME, whose roughness
# of 0.72 returns about 40% of the traced detail through a diffuse surface.
# **The numbers from that sweep are void.** The frame's front face must sit
# behind the mirror's front face — here 2.570 against 2.550 — and the border
# comes from the frame being larger in x and y, not from it being nearer.
#
# With that right the reflection needs no help at all: at the demo's own hub
# lighting the glass carries the sou'wester, both mittens, the oilskin, the
# waders, the boots, the crates, the rail, the boat and the flag, sharp.
#
# **Do not add a lamp for it.** Anything bright enough to lift a man 1.7 m away
# also lights the deck he is standing on and the glass itself, so it raises the
# panel's mean and not its contrast.

[[node]]
name = "MirrorFrame"
parent = "Rig"
transform = { pos = [-4.30, 2.600, 2.585], scale = [0.46, 1.060, 0.015] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

  [node.components.Material]
  albedo = [0.34, 0.26, 0.19]
  roughness = 0.72
  porosity = 0.40

[[node]]
name = "Mirror"
parent = "Rig"
transform = { pos = [-4.30, 2.600, 2.560], scale = [0.40, 1.000, 0.010] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

  [node.components.Material]
  albedo = [0.95, 0.96, 0.97]
  metallic = 1.0
  roughness = 0.0
  porosity = 0.0

[[node]]
name = "ShedRoof"
parent = "Rig"
transform = { pos = [-4.0, 3.95, 4.60], scale = [4.9, 0.15, 2.40] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

  [node.components.Material]
  albedo = [0.22, 0.24, 0.25]
  roughness = 0.75
  metallic = 0.4

