# **DEEPER — the demo. Round 2: the Rig, and a boat you drive off it.**
#
#   loom run assets/games/deeper_demo.loom
#   loom render assets/games/deeper_demo.loom --out /tmp/rig.png
#   loom sim assets/games/deeper_demo.loom --ticks 900 --hold move_z=1 \
#     --assert "Rig/Boat.x > 30.0"      # walk forward. That is the whole demo.
#
# The hub of the GDD's §7 — a rusted floating platform lashed to the surface
# above the trench, part oil rig, part fishing wharf. Early game it is meant to
# be the cozy tonal baseline, so it is bright, warm and low-fog: the "before"
# the rest of the game is measured against. Nothing here curdles yet.
#
# There are four things in this demo and no fifth: **a hub, a boat you can
# drive, fishing you can do, and four slots to carry things in.** Round 1 built
# the hub and stood the player on it. Round 2 makes the boat boardable and
# drivable, and makes going into the water something you come back from.
#
# ---------------------------------------------------------------------------
# THE CONTROLS, IN FULL
# ---------------------------------------------------------------------------
#
#   on the rig      W A S D walk, Shift sprint, Space jump
#   on `HelmMat`    W ahead, S astern, A wheel to port, D wheel to starboard,
#                   nothing pressed is neutral and she coasts to a stop
#   in the water    W A S D swim, at under half walking pace
#
# **The helm is a place, not a keybinding**, and the whole scene is laid out so
# that one fact does not have to be explained. The player spawns at x = -3.70
# facing the gap in the berth railing; the gap is where the boat's cockpit is;
# the cockpit is where `HelmMat` is drawn. **Walk forward and you board her,
# arrive at the wheel and get under way, on one key.** Measured: aboard by
# tick 180, on the mat and moving by tick 240, 34 m clear by tick 900.
#
# That mapping spends none of the engine's five digital channels — `jump` is
# still jump and `fire` is still unspent, for fishing — and there is no fifth
# channel to spend on a "take the helm" button.
#
# ---------------------------------------------------------------------------
# DECISION 1 — WHAT THE PLAYER IS
# ---------------------------------------------------------------------------
#
# **`Rig/Player`**: a `CharacterController` 1.8 m tall and 0.35 m in radius,
# driven by `../scripts/deeper_player.rhai`, with `Rig/Player/Eye` carrying the
# `Camera` as its child.
#
# That last part is not decoration. `World::player_character` walks *up* from
# the active camera to the nearest ancestor with a `CharacterController`, so
# **parenting the camera to the character is what makes it the player** — and
# it is also what makes the rig first person, because `Play::apply_look` puts
# yaw on the character and pitch on the eye. There is no `Player` flag
# component to set and there must not be one; the hierarchy already says it.
#
# The movement script is `deeper_player.rhai` and not `fps.rhai` for one
# reason, written at the top of that file: `fps.rhai` detonates a 5 m blast
# where the view ray lands when `fire` is pressed, and the centrepiece of this
# scene is a 43,776 kg dynamic rigid body. `fire` is also the binding fishing
# spends. It arrives here unspent.
#
# **The player faces the boat at yaw 0, and the whole rig is laid out around
# that.** `Play::start` takes its opening yaw from the *eye node's* authored
# rotation and then writes yaw onto the *character*, leaving the eye's own yaw
# in place underneath — so an authored eye yaw is counted twice the moment play
# begins, and an authored character yaw is overwritten by it. Neither can
# express "start facing this way". So the scene is turned instead of the
# camera: the berth is on −Z, which is where yaw 0 looks, and `loom render` and
# `loom run` therefore agree about the opening shot. (The double-count is a
# real engine wrinkle and worth an issue; it is not worth an engine change
# inside a demo round.)
#
# ---------------------------------------------------------------------------
# DECISION 2 — WHERE THE FOUR INVENTORY SLOTS LIVE
# ---------------------------------------------------------------------------
#
# **In `GameRules` state**, as `state.hold` (the list) and `state.carried` (its
# length), owned by `../scripts/deeper_demo.rhai`. The alternatives — a
# movement script's `memory`, and the event log — are weighed and rejected in
# that file's header, which is where the decision belongs because that is where
# a reader arrives when the hold misbehaves. The short version: `memory` is
# invisible to both `loom sim --assert` and the `Hud`, and the event log is a
# record rather than a container.
#
# The one cost, stated: `state` is not in `state_hash`, so `cargo test` and
# `cargo xtask repeat` are blind to the hold and `--assert` is its only
# detector. Same bargain the fight makes.
#
# ---------------------------------------------------------------------------
# DECISION 3 — THE SEA IS THE SAFETY DEVICE, NOT THE RAILING
# ---------------------------------------------------------------------------
#
# Round 1 sealed the rig on four sides and the seal leaked anyway. Walk into any
# rail at plain walking speed, keep pressing, and hop: the capsule's rounded
# foot catches the cap bar's inner edge at exactly the jump apex and is climbed
# over it. Traced, on the east rail — tick 315 pressed against it at y 2.318,
# tick 335 at the ballistic apex 3.617 with its feet at 2.717 inside `CapEast`'s
# 2.68-to-2.92 band, tick 345 at 3.839 standing *on* the cap, tick 350 outboard,
# tick 600 at y = -202.17 and still falling.
#
# **A taller rail cannot fix that**: the height a solid wall would need is the
# jump apex plus the step height, which is above the player's own eye, and a
# 1.5 m parapet was already rejected in round 1 for hiding the boat. The berth
# has to open anyway or nobody can board. So the railing stops being what keeps
# the player safe:
#
#   * `deeper_player.rhai` **floats** a capsule that goes under, at the surface;
#   * the **slipway** at the east end lets it walk back out;
#   * and `assets/test/rig_overboard.loom` asserts both, with the real player
#     model and no teleport.
#
# The rails are still rails — they stop a walk — and they are now set dressing
# rather than the thing a life depends on.
#
# ---------------------------------------------------------------------------
# WHAT IS THIN, AND KNOWN
# ---------------------------------------------------------------------------
#
# * **The wheel, the throttle and the shifter do not move.** All four movable
#   parts in `jib_vi.loom` are separate meshes with **no transform of their
#   own**, so each one's pivot is the hull's origin up to nineteen metres away
#   and rotating the node swings the part across the boat. Animating them is a
#   mesh-authoring job — each part wants its geometry re-centred on its own
#   pivot — and no scene edit can substitute. Beyond that, a node `Script` is a
#   pure function of `tick` and cannot see the throttle setting, so even with
#   pivots there is no seam yet from "the helm is open" to "the lever leans".
# * **Releasing the throttle is not directly asserted.** `loom sim --hold` is
#   one constant for a run, so "hold W then let go" needs a schedule that does
#   not exist. What is asserted is the pair either side of it: zero thrust
#   leaves her exactly where she is (`rig_drive` run 1), and stepping off the
#   mat writes zero thrust every tick (`deeper_player.rhai`'s `else if aboard`).
# * **A player who jumps off the boat while she is under way leaves her
#   running.** The helm only writes thrust while somebody is standing on the
#   body, so there is nobody to write the zero. In life that is correct and in a
#   demo it is a way to lose your boat. The fix is a rules-script dead man's
#   handle, which is a fifth thing.
# * **No fishing yet.** `assets/games/fishing.loom` has the loop; it is not
#   wired in here, and `deeper_demo.rhai` currently holds the scene's one
#   `GameRules` slot that `fishing_fight.rhai` will also want.
# * **The four slots fill and nothing empties them.** Walking up to a supply
#   puts it in the hold; there is no way to put it back and no reason to want
#   one until there is a fish to make room for. Selling is not built.
# * **The `Hud` line is unverified as pixels.** `Hud` draws only in `loom run`
#   and a headless render cannot show it, so what is checked is the string the
#   rules script produces (`game.message` in `loom sim`'s output), not the
#   overlay. Those are different claims and only the first one is tested.
# * **The deck is still beige and the hub still reads pale.** It was called out
#   after round 1 and it is a palette pass, not a boat.

[scene]
format = 1
id = "b2a43f8f-314a-4d92-b4aa-322411869fcd"

# The hull, its paint and its twelve pontoons, from the file that owns them.
[[prefab]]
key = "jib_vi"
id = "3c7a5e12-8b64-4f09-a2d3-6e1b90c47f58"
path = "../prefabs/jib_vi.loom"

# The deck a person stands on. See that file's header: the hull's own collider
# is its inertia and its lid is a metre above the deck, so without this the
# boat is a brick you stand on top of.
[[prefab]]
key = "jib_vi_decks"
id = "3c7a5e12-8b64-4f09-a2d3-6e1b90c47f59"
path = "../prefabs/jib_vi_decks.loom"

[[asset]]
key = "box"
path = "box"

[[asset]]
key = "cylinder"
path = "cylinder"

# ---------------------------------------------------------------------------
# THE WORLD
# ---------------------------------------------------------------------------

[[node]]
name = "Rig"

  [node.components.GameRules]
  path = "../scripts/deeper_demo.rhai"

  # Bright, warm, low sun. The GDD asks the hub to be the cozy baseline, and
  # every later escalation is a change to these seven numbers rather than to
  # the geometry.
  [node.components.Environment]
  sun_direction = [0.42, 0.46, -0.78]
  sun_strength = 1.25
  sun_color = [1.0, 0.93, 0.80]
  ambient = 0.45
  sky_zenith = [0.16, 0.30, 0.52]
  sky_horizon = [0.74, 0.72, 0.66]
  fog_density = 0.0028
  fog_falloff = 0.05

  # Light air. Enough to move the surface; far too little to trouble the boat.
  [node.components.Wind]
  direction_degrees = 20.0
  speed = 3.0
  gustiness = 0.25
  turbulence = 0.15

# **`deterministic`, not `cinematic`.** ADR 0053's cinematic tier is read back
# off the GPU and `loom sim` refuses the whole run rather than answer a `water@`
# assertion approximately. A scene the demo's tests are run against gets the
# height-field tier; the beauty shot can have its own file.
[[node]]
name = "Water"
parent = "Rig"

  [node.components.WaterBody]
  kind = "ocean"
  simulation = "deterministic"
  surface_height = 0.0
  density = 1000.0
  drag = 2.0

# ---------------------------------------------------------------------------
# YOU
# ---------------------------------------------------------------------------

# Deck top is 1.40 and the capsule's origin is its centre, 0.90 above its feet,
# so 2.30 is standing. 2.40 is a 10 cm drop onto the deck on the first tick,
# which is how every character scene in this repository starts: it proves the
# floor is there rather than assuming it.
[[node]]
name = "Player"
parent = "Rig"
transform = { pos = [-3.70, 2.40, 0.90] }

  [node.components.CharacterController]
  height = 1.8
  radius = 0.35
  # **0.10, not the default 0.35, and this is the other half of the rail.**
  # `step_height` is what the controller will silently lift the capsule onto,
  # and it applies in mid-air: at the top of a hop the capsule's feet are
  # within a step of the rail cap, so the controller mounts it, walks the
  # 0.2 m cap and drops off the far side into the sea. Measured, on
  # `rig_walk` — the pilot crossed x = 11.50 at y = 3.61, rose to 3.75 over
  # the next eight ticks, and was at y = -970 by tick 900.
  #
  # Nothing on this rig is a stair, so the step buys nothing here and costs
  # that. **The boarding round will want it back** — the bulwark is a 0.22 m
  # rise from the wharf — and when it raises this number it has to re-check
  # the rail against the same sum: rail top must exceed the jump apex's foot
  # height plus this. Today that is 2.733 + 0.10 against a cap at 2.90.
  step_height = 0.25

  [node.components.Script]
  path = "../scripts/deeper_player.rhai"

[[node]]
name = "Eye"
parent = "Rig/Player"
transform = { pos = [0.0, 0.75, 0.0] }

  [node.components.Camera]
  fov_y_degrees = 75.0

# ---------------------------------------------------------------------------
# THE RIG
#
# A 24 x 14 m deck on six pilings, railed the whole way round. Every
# piece here is a `box` or a `cylinder` with a `MeshRenderer` and no collider:
# a renderable node with no dynamic ancestor becomes a static collider from its
# own drawn bounds, so what is walked on is exactly what is seen. That
# equivalence is the whole reason nothing here is an invisible ramp.
# ---------------------------------------------------------------------------

[[node]]
name = "Deck"
parent = "Rig"
transform = { pos = [0.0, 1.20, 0.0], scale = [12.0, 0.20, 7.0] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

  [node.components.Material]
  albedo = [0.19, 0.17, 0.15]
  roughness = 0.92

[[node]]
name = "PilingNW"
parent = "Rig"
transform = { pos = [-10.5, -0.20, -5.5], scale = [0.35, 1.20, 0.35] }

  [node.components.MeshRenderer]
  mesh = { asset = "cylinder" }

  [node.components.Material]
  albedo = [0.24, 0.17, 0.13]
  roughness = 0.95

[[node]]
name = "PilingNC"
parent = "Rig"
transform = { pos = [0.0, -0.20, -5.5], scale = [0.35, 1.20, 0.35] }

  [node.components.MeshRenderer]
  mesh = { asset = "cylinder" }

  [node.components.Material]
  albedo = [0.24, 0.17, 0.13]
  roughness = 0.95

[[node]]
name = "PilingNE"
parent = "Rig"
transform = { pos = [10.5, -0.20, -5.5], scale = [0.35, 1.20, 0.35] }

  [node.components.MeshRenderer]
  mesh = { asset = "cylinder" }

  [node.components.Material]
  albedo = [0.24, 0.17, 0.13]
  roughness = 0.95

[[node]]
name = "PilingSW"
parent = "Rig"
transform = { pos = [-10.5, -0.20, 5.5], scale = [0.35, 1.20, 0.35] }

  [node.components.MeshRenderer]
  mesh = { asset = "cylinder" }

  [node.components.Material]
  albedo = [0.24, 0.17, 0.13]
  roughness = 0.95

[[node]]
name = "PilingSC"
parent = "Rig"
transform = { pos = [0.0, -0.20, 5.5], scale = [0.35, 1.20, 0.35] }

  [node.components.MeshRenderer]
  mesh = { asset = "cylinder" }

  [node.components.Material]
  albedo = [0.24, 0.17, 0.13]
  roughness = 0.95

[[node]]
name = "PilingSE"
parent = "Rig"
transform = { pos = [10.5, -0.20, 5.5], scale = [0.35, 1.20, 0.35] }

  [node.components.MeshRenderer]
  mesh = { asset = "cylinder" }

  [node.components.Material]
  albedo = [0.24, 0.17, 0.13]
  roughness = 0.95

# **The rails, in two parts, and both heights were measured rather than picked.**
#
# A metre of solid bulwark (1.40 to 2.40) and a thin cap bar floating above it
# (2.68 to 2.92), with a 0.28 m gap between. It began as one solid metre and
# `assets/test/rig_walk.loom` walked its pilot straight over the east one: a hop
# at `deeper_player.rhai`'s numbers puts the capsule's feet at 2.733, so a 1.0 m
# rail is something you clear. The run ended at y = -974 and still falling,
# because nothing in this engine catches a character in water.
#
# Raising it to one solid 1.4 m wall did **not** fix it, and that is the
# interesting half: feet at 2.733 against a cap at 2.80 is clear by seven
# centimetres, and the controller stepped the capsule up onto the cap anyway,
# because `step_height` applies in the air as readily as on a stair. Both
# numbers had to move — the cap out of reach, and the character's step down to
# 0.10.
#
# It is a bar rather than a taller wall because a 1.5 m wall **hid the boat**.
# The player's eye is at 3.05 and the thing this hub exists to point at is a
# hull floating 0.9 m off the edge; a parapet the height of a man turns that
# into a superstructure behind a fence. The gap sees the water, the bar stops
# the jump, and a capsule 1.8 m tall always spans the bar's band whatever part
# of a hop it is in — that last clause is why the gap is safe rather than a
# second hole.
#
# **Closed on the berth side too, for now.** The way aboard is the round that
# builds a gangway; until then a gap in this railing is a hole a player falls
# through into an unrecoverable state, and a demo must not have one. The two
# bollards in front of it are what say "berth" instead.

[[node]]
name = "RailSouth"
parent = "Rig"
transform = { pos = [0.0, 1.90, 6.90], scale = [12.0, 0.50, 0.10] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

  [node.components.Material]
  albedo = [0.30, 0.21, 0.16]
  roughness = 0.85

[[node]]
name = "RailWest"
parent = "Rig"
transform = { pos = [-11.90, 1.90, 0.0], scale = [0.10, 0.50, 7.0] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

  [node.components.Material]
  albedo = [0.30, 0.21, 0.16]
  roughness = 0.85

# **Split for the slipway: 2.8 m of gap at z = +2.0 to +4.8.**
#
# Off-centre, and that is not arbitrary. `assets/test/rig_walk.loom`'s pilot
# crosses the deck along z = +0.90 with its lateral velocity pinned to zero, so
# a gap on the centreline is a gap it walks straight out of — and its
# `Player.y > 2.2` assertion, which means "still on the deck", would then be
# failed by the pilot doing something perfectly correct. The gap is a pace
# south of that lane instead.

[[node]]
name = "RailEastNorth"
parent = "Rig"
transform = { pos = [11.90, 1.90, -2.50], scale = [0.10, 0.50, 4.50] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

  [node.components.Material]
  albedo = [0.30, 0.21, 0.16]
  roughness = 0.85

[[node]]
name = "RailEastSouth"
parent = "Rig"
transform = { pos = [11.90, 1.90, 5.90], scale = [0.10, 0.50, 1.10] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

  [node.components.Material]
  albedo = [0.30, 0.21, 0.16]
  roughness = 0.85

# **The berth side is open between the bollards, and that is the way aboard.**
# 3.8 m of gap at x -6.9..-3.1, which is the two bollards' own span plus a pace
# either side. Round 1 closed it because a hole in the railing was an
# unrecoverable fall; the slipway at the east end is what makes falling in
# recoverable, and it had to exist before this could be opened.

[[node]]
name = "RailNorthWest"
