# ---------------------------------------------------------------------------
# THE FOUR SLOTS' WORTH OF SUPPLIES
#
# `../scripts/deeper_rules.rhai` names these four paths and puts each into the
# hold when the player comes within 1.7 m horizontally. They are stations, not
# objects: you take a handful of bait from a barrel and the barrel is still a
# barrel, which is what lets the picture stay honest in an engine that cannot
# remove a node at runtime.
#
# They stand in a line along z ~= +2.2, a pace clear of the shed's north face
# at z = +2.6, so the walk from the west ladder to the berth passes all four.
# ---------------------------------------------------------------------------

[[node]]
name = "Bench"
parent = "Rig"
transform = { pos = [-1.0, 1.70, 2.30], scale = [2.60, 0.30, 0.45] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

  [node.components.Material]
  albedo = [0.44, 0.35, 0.24]
  roughness = 0.9

[[node]]
name = "BaitBarrel"
parent = "Rig"
transform = { pos = [-5.85, 1.85, -1.60], scale = [0.45, 0.45, 0.45] }

  [node.components.MeshRenderer]
  mesh = { asset = "cylinder" }

  [node.components.Material]
  albedo = [0.20, 0.34, 0.30]
  roughness = 0.85

[[node]]
name = "LineSpool"
parent = "Rig"
transform = { pos = [-3.35, 1.70, -3.50], scale = [0.40, 0.30, 0.40] }

  [node.components.MeshRenderer]
  mesh = { asset = "cylinder" }

  [node.components.Material]
  albedo = [0.72, 0.68, 0.58]
  roughness = 0.6

[[node]]
name = "Lantern"
parent = "Rig"
transform = { pos = [-5.85, 1.68, -5.40], scale = [0.16, 0.28, 0.16] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

  [node.components.Material]
  albedo = [0.85, 0.72, 0.24]
  roughness = 0.35
  metallic = 0.7

[[node]]
name = "Thermos"
parent = "Rig"
transform = { pos = [-3.35, 1.65, 0.30], scale = [0.13, 0.25, 0.13] }

  [node.components.MeshRenderer]
  mesh = { asset = "cylinder" }

  [node.components.Material]
  albedo = [0.72, 0.24, 0.18]
  roughness = 0.45

# ---------------------------------------------------------------------------
# THE CRATE — where a trip ends, and the only thing in this demo that counts
#
# **Four features in one scene is not a loop.** You could board, drive, fish and
# fill four slots, and none of it added up to anything: the boat went out and
# there was no reason to come back, and a demo with no reason to come back is a
# sandbox with a boat in it.
#
# So: land a fish, stow it in the cockpit, bring her alongside, step ashore, and
# walk to this crate. `state.delivered` goes up and the HUD's top row says so.
# That is the whole close, deliberately — a counter and a line of text. The
# thing that makes it a loop is not the reward, it is that the **bait is on the
# rig**: `BaitBarrel` is eight metres from here, the fish eats your bait at the
# take, and there is no bait at sea. Going out again means coming back first.
#
# **Both halves are checked, and the second is what makes it "bring her back"
# rather than "walk over here".** `deeper_rules.rhai` refuses unless `Rig/Boat`
# is within `ALONGSIDE` of this crate — 14.0 m, against 11.5 m for a boat in
# her berth and 35.7 m for one left where `rig_drive.loom` puts her. Swimming
# ashore with the catch still in a hull thirty metres out gets a caption saying
# so, not a delivery.
#
# **Where, and why not on the taught path.** x = -7.60 is three and a quarter
# metres west of the walk-forward lane, so a player following the one gesture
# the demo teaches never comes within `RANGE` of it on the way out and never
# walks into it — everything here is drawn without a dynamic ancestor and is
# therefore a static collider, and a crate in the middle of the berth gap would
# have broken the demo's only gesture. It sits between the ladder's landing and
# the west bollard, which is the ground you cross coming *off* the boat.
# ---------------------------------------------------------------------------

[[node]]
name = "FishCrate"
parent = "Rig"
transform = { pos = [-7.60, 1.70, -5.90], scale = [0.55, 0.30, 0.45] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

  [node.components.Material]
  albedo = [0.18, 0.29, 0.31]
  roughness = 0.7
  metallic = 0.25

# ---------------------------------------------------------------------------
# THE BOAT
#
# Alongside, in the berth, bow to +X. Her mass brick reaches |z| = 3.30 from
# her centre, so at z = -11.2 the hull's inboard side sits 0.90 m off the
# wharf's edge at z = -7.0 — close enough to step across and far enough that
# forty-three tonnes on a light chop is not leaning on the pilings. She is at
# x = -5 rather than amidships because that is where the player's opening view
# at yaw 0 puts her: the shot the demo opens on is a boat, not an empty sea.
# ---------------------------------------------------------------------------

[[node]]
name = "Boat"
parent = "Rig"
prefab = "jib_vi"
transform = { pos = [3.0, 0.0, -10.45] }

# ---------------------------------------------------------------------------
# THE HOLD AND THE LINE, AND THEY ARE TWO `Hud`s
#
# **Round 3 believed `Hud` was one line and it is not.** `hud.rs`'s
# `interpolate` resolves `{status}`, `{message}` and then *any* number the rules
# script is keeping — `state.number(name)` — and a scene may carry as many `Hud`
# nodes as it likes (`proving_ground.loom` has five). Believing otherwise cost
# the demo its inventory display: the helm caption overwrote `{message}`, so the
# player lost sight of what he was carrying at exactly the moment he took it to
# sea, and round 4 would have had the fight's stress meter fighting for the same
# string.
#
# So there are two rows. The top one is the hold and it is always true; the
# bottom one is situational and whoever has most to say owns it.
#
# **The empty slots draw as `0` deliberately.** Three of the four supplies are
# behind the spawn, in the direction the demo tells you not to walk, so a player
# who follows the one taught gesture arrives at the boat carrying one thing. A
# counter that shows `bait 1 line 0 lantern 0 thermos 0` tells him there are
# three more somewhere; `HOLD 1/4` alone tells him nothing he can act on.
#
# **Drawn only in `loom run`** — a headless render will not show either row, so
# what a gate can check is the string the rules script produced (`game.message`
# in `loom sim`'s output) and the numbers behind it, never the overlay.
# ---------------------------------------------------------------------------

[[node]]
name = "Hold"
parent = "Rig"

  [node.components.Hud]
  anchor = "bottom_center"
  offset = [0.0, 88.0]
  text = "HOLD {carried}/4   bait {bait}  line {line}  lantern {lantern}  thermos {thermos}  fish {infish}      BELOW {stowed}   CRATE {delivered}"
  size = 19.0
  color = [0.86, 0.89, 0.82]
  only_in_play = true

[[node]]
name = "Line"
parent = "Rig"

  [node.components.Hud]
  anchor = "bottom_center"
  offset = [0.0, 56.0]
  text = "{message}"
  size = 22.0
  color = [0.95, 0.93, 0.86]
  only_in_play = true

[[node]]
name = "Decks"
parent = "Rig/Boat"
prefab = "jib_vi_decks"

# ---------------------------------------------------------------------------
# THE ROD, IN A HOLDER ON THE PORT BULWARK, AND IT IS THE FRAME'S ONLY SUBJECT
# ---------------------------------------------------------------------------
#
# **Where, and why here.** The butt sits on the aft port bulwark cap —
# `col_bulwark_aft_port` is 0.30 m of bulwark centred on boat-local z = -2.86
# with its top at 1.62 — and the blank leans 45 degrees outboard, putting its
# tip 1.4 m over the water at y = 3.25. From the helm mat the eye is at
# boat-local (-7.30, 2.29, -1.775) looking down -Z, so the butt is 31 degrees
# below the centre of frame and 15 degrees to the left, and the tip is 19
# degrees above it. **The rod arcs across the middle of the shot the player
# actually has.**
#
# That is the whole reason it is here rather than in his hands. The measured
# complaint about this demo is that the helmsman's frame is "two rod holders, a
# strip of red gunwale and an empty horizon" that does not change over 45 m of
# travel. A rod in that frame that visibly loads up when a fish runs is the
# first thing in this scene the player can watch answer him.
#
# **In his hands was tried and refused, on the engine.** A renderable node whose
# ancestors contain no *dynamic* body becomes a static collider from its drawn
# bounds (`play.rs`) — and a `CharacterController` is not a dynamic body. So a
# rod parented to `Rig/Player/Eye` would bake twenty-four boxes of world scenery
# at the spawn point and the player would walk into his own tackle. Under the
# hull there is a dynamic ancestor, the arm above it needs an authored
# `BoxCollider` the rod does not have, and the result is geometry with no
# physics at all — which is what a rod should be. Held gear needs an engine
# exemption and that is an ADR, not a demo round.
#
# It bends because every one of the chain's twenty-four joints carries
# `rod_bend.rhai`, which reads `state.stress` off the rules script. Nothing in
# this scene authors that link; it is in the prefab, so it works here and in
# `fishing.loom` and is a rest pose everywhere else.
[[node]]
name = "Rod"
parent = "Rig/Boat"
prefab = "rod"
transform = { pos = [-7.60, 1.62, -2.90], rot_euler = [-45.0, 0.0, 0.0] }

# ---------------------------------------------------------------------------
# THE FLOAT — the only thing in the player's own frame that says he is fishing
# ---------------------------------------------------------------------------
#
# **Measured, and it is the finding this round is built on.** Rendered from
# `Rig/Player/Eye` at the tick the HUD reads `LINE OUT, BAITED`, at eight
# headings 45 degrees apart, the frame is: two rods standing in their holders,
# a strip of red-and-white bulwark, open sea. It is the *same frame* as before
# the cast and the same frame a fish runs in. The rod does bend — 0.44 of full
# travel at stress 100 — but at this distance the blank is a dark line among
# three identical rods, and the two things the loop turns on, the take and the
# run, are text and nothing else.
#
# So: a mark on the water, at the one place the player already looks. It sits
# and bobs while the bait waits, it **dunks for the six hundred milliseconds
# the take is answerable in**, and it goes under and swings wide with the load
# while the fish runs. `float_bob.rhai` is the whole of it and the geometry is
# worked out in its header.
#
# Under `Rig/Boat` for two reasons: she carries it to sea, and a renderable
# node with a dynamic ancestor bakes no static collider — the same rule that
# lets the rod exist without the player walking into his own tackle. A float
# you can stand on would be worse than no float.
#
# **`sphere`, not `box`.** A 0.4 m cube at 8.7 m reads as a crate; the round
# silhouette is what makes it a float rather than flotsam, and orange is the
# only colour in this scene that is not hull, sea, deck or sky.
[[node]]
name = "Float"
parent = "Rig/Boat"
transform = { pos = [-7.60, 1.50, -3.05], scale = [0.045, 0.045, 0.045] }

  [node.components.MeshRenderer]
  mesh = { asset = "sphere" }

  [node.components.Material]
  albedo = [0.94, 0.35, 0.04]
  roughness = 0.55
  metallic = 0.0

  [node.components.Script]
  path = "../scripts/float_bob.rhai"

# ---------------------------------------------------------------------------
# THE CATCH — the payoff, which until now was a sentence
# ---------------------------------------------------------------------------
#
# `LANDED   it is in your hands` and `IN THE CRATE   that is a trip` were both
# a string over a frame identical to the one before it. Rendered from the
# player's own eye at those two ticks, there is no fish anywhere in the shot,
# because there was no fish anywhere in the scene.
#
# It hangs in the cockpit from the tick it comes over the rail to the tick it
# goes in the box — `state.infish`, which is exactly that interval — and the
# geometry is in `fish_hang.rhai`. Under `Rig/Boat` so she carries it home, and
# so no static collider is baked from it.
[[node]]
name = "Catch"
parent = "Rig/Boat"
transform = { pos = [-7.62, 1.56, -2.98], scale = [0.09, 0.09, 0.09] }

  [node.components.MeshRenderer]
  mesh = { asset = "gleamsprat" }

  [node.components.Material]
  albedo = [0.30, 0.37, 0.42]
  roughness = 0.38
  metallic = 0.18

  [node.components.Script]
  path = "../scripts/fish_hang.rhai"

# The fins and tail, which are a second mesh in the same model. No script: it
# is a child, so `fish_hang.rhai` moves both by moving the parent.
[[node]]
name = "Fins"
parent = "Rig/Boat/Catch"

  [node.components.MeshRenderer]
  mesh = { asset = "gleamsprat_fins" }

  # **Not orange, and that is a bug report rather than a preference.**
  # `gleamsprat_fins` is a splayed, forked shape, and at flesh-orange
  # ([0.70, 0.34, 0.18], what it shipped as) it reads as a human fist at every
  # scale — `tests/references/gleamsprat.png` is a blessed reference showing a
  # sea full of them, and here it arrives at eye level, half a metre from the
  # camera, holding a pale grey teardrop. The mesh is the real defect and is
  # not this round's to fix; taking the skin tone out of it is one line and
  # stops the read.
  [node.components.Material]
  albedo = [0.15, 0.19, 0.21]
  roughness = 0.5
  metallic = 0.0

# ---------------------------------------------------------------------------
# THE SLIPWAY — the way out of the water, and the reason the railings can open
#
# **A demo must not contain an unrecoverable state.** Round 1 sealed the rig on
# all four sides and still leaked: walk into any rail, keep pressing, and hop —
# the capsule's bottom cap catches the cap bar's inner edge at exactly the jump
# apex and is climbed over it. Traced on the east rail, at plain walking speed:
#
#   tick 315  y 2.318  x 11.417   pressed against the rail, on the deck
#   tick 335  y 3.617  x 11.502   jump apex, exactly ballistic (2.318 + 1.172
#                                 plus a half-step of Euler bias). Feet at
#                                 2.717, and `CapEast` spans 2.68 to 2.92.
#   tick 345  y 3.839  x 11.776   no longer ballistic: standing on the cap
#   tick 350  y 3.799  x 12.126   outboard, and falling
#   tick 600  y -202.17           still falling
#
# **The rail is not the fix and a taller one is not either.** That arms race
# was already lost twice — a 1.0 m rail is hopped, a 1.4 m one is *stepped
# onto* — and the height a solid wall would need is the jump apex plus the step
# height, which is above the player's own eye. So the wall stops being the
# safety device and this ramp becomes it. Fall in anywhere, swim to it, walk
# up: that is `deeper_player.rhai`'s swim clause and this slab, together.
#
# 4.6 m of run and 3.2 m of fall — 34.8 degrees against the controller's 50
# degree limit. It reaches y = -1.80 because a swimmer floats with its capsule
# centre at -0.70 and its feet at -1.60, so the ramp has to pass under the feet
# of someone already in the water: a slipway that stops at the waterline is a
# wall to anybody below it. It also fills the east end, which was 12 m of bare
# deck with nothing in it.

[[node]]
name = "Slipway"
parent = "Rig"
transform = { pos = [14.10, -0.20, 3.40], rot_euler = [0.0, 0.0, -34.8], scale = [2.80, 0.09, 1.20] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

  [node.components.Material]
  albedo = [0.26, 0.25, 0.23]
  roughness = 0.95

# Two stringers down its sides. They are not railings — they stand 0.24 m
# proud, which is under the step height, so they are walked over rather than
# stopping anyone. They are here because a bare grey slab at 35 degrees reads
# as a fault in the geometry, and a slipway with kerbs reads as a slipway.

[[node]]
name = "SlipwayKerbNorth"
parent = "Rig"
transform = { pos = [14.10, -0.05, 2.12], rot_euler = [0.0, 0.0, -34.8], scale = [2.80, 0.12, 0.08] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

  [node.components.Material]
  albedo = [0.34, 0.26, 0.21]
  roughness = 0.8
  metallic = 0.4

[[node]]
name = "SlipwayKerbSouth"
parent = "Rig"
transform = { pos = [14.10, -0.05, 4.68], rot_euler = [0.0, 0.0, -34.8], scale = [2.80, 0.12, 0.08] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

  [node.components.Material]
  albedo = [0.34, 0.26, 0.21]
  roughness = 0.8
  metallic = 0.4

# ---------------------------------------------------------------------------
# THE LADDER — the way out of the water on the side you actually fall in on
#
# **The measured defect.** The taught gesture is one key, and twelve degrees of
# aim to port of it walks you past the boat's transom into open water. Round 5
# gave that state a caption — "IN THE WATER   swim east, to the ramp at the end
# of the rig" — and the caption was a second lie. The miss leaves the player at
# **(-9.70, -0.70, -26.17)**: nineteen metres north of the deck's own edge and
# twenty-six from the slipway, which is at the *east* end and descends toward
# +X, so it is climbable only heading west from about x = +17. Holding east
# from the miss point for sixty simulated seconds travels 114 m into empty sea
# with the same sentence on the screen the whole way. There was no bearing that
# worked, and the one named did not.
#
# The old `rig_overboard.loom` could not see it: it started the swimmer at
# (18.0, 0.60, 3.40), four metres from the ramp's foot on the only workable
# bearing, and asserted a four-metre swim. It is now started where the miss
# leaves him, and that row is the one that can fail.
#
# So the berth side gets its own way up, at the far west end of it — 2.0 m of
# gap cut in `RailNorthWest`, clear of the boat's transom at x = -6.5 by nearly
# two metres. Same slope as the slipway (34.8 degrees against the controller's
# 50) and the same reach below the surface: it ends at y = -1.80 because a
# swimmer floats with his feet at -1.60, and a ramp that stops at the waterline
# is a wall to anyone under it.
#
# **Rotated about X rather than Z**, because this one runs athwart the rig: the
# +Z end is 2.30 m south and 1.60 m up, landing at (z = -6.60, y = 1.40) — the
# deck's own top, with 0.40 m of overlap so there is no gap to step across.
#
# **And the caption stopped naming a bearing at all.** `deeper_rules.rhai` now
# takes the nearer of the two ramps and prints the compass word for the
# direction it lies in, from wherever the swimmer actually is. A hard-coded
# bearing is right from one place and wrong from the rest of the sea.
# ---------------------------------------------------------------------------

[[node]]
name = "Ladder"
parent = "Rig"
transform = { pos = [-9.30, -0.20, -8.90], rot_euler = [-34.8, 0.0, 0.0], scale = [0.85, 0.09, 2.80] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

  [node.components.Material]
  albedo = [0.26, 0.25, 0.23]
  roughness = 0.95

# Two stringers, 0.24 m proud and therefore under `step_height` — walked over,
# not a rail. Same reason the slipway has them: a bare slab at 35 degrees reads
# as a fault in the geometry and a ramp with edges reads as a ramp.

[[node]]
name = "LadderKerbWest"
parent = "Rig"
transform = { pos = [-10.07, -0.05, -8.90], rot_euler = [-34.8, 0.0, 0.0], scale = [0.08, 0.12, 2.80] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

  [node.components.Material]
  albedo = [0.34, 0.26, 0.21]
  roughness = 0.8
  metallic = 0.4

[[node]]
name = "LadderKerbEast"
parent = "Rig"
transform = { pos = [-8.53, -0.05, -8.90], rot_euler = [-34.8, 0.0, 0.0], scale = [0.08, 0.12, 2.80] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

  [node.components.Material]
  albedo = [0.34, 0.26, 0.21]
  roughness = 0.8
  metallic = 0.4

# ---------------------------------------------------------------------------
# THE MARKS — eight buoys, and they are the answer to "am I moving?"
#
# **The measured defect they exist for.** From the helm the eye looks over her
# port beam: the bow is ninety degrees to starboard, nothing on the boat
# forward of the wheel is in shot, and the wake trails astern — `water@` reads
# 0.103 of foam three metres behind her and **0.000 abeam**, so even the foam
# the hull is making is outside the frame. Round 4 measured a frame 285 m from
# the berth against one half a second old and the two differed *less* than two
# consecutive frames of the same moving boat. The picture carried no position
# information at all, and round 4's honest answer was to print `state.knots` in
# the caption, which is a readout and not a view.
#
# **The fix that is not this one is to berth her stern-to**, so that the bow is
# dead ahead from the wheel. That moves every pinned drive number in
# `scripts/green.sh` from an X to a Z, moves the boarding steps from her
# starboard side to her transom — and lands the player looking at the after
# face of the deckhouse a metre away, because `col_house` ends at local x =
# -6.20 and the mat is at -7.80. It is a round with a mesh question in it.
#
# **What a line of marks does instead is put something in the frame he already
# has.** They are laid nine and a half metres off her track, on the side he is
# facing, sixteen metres apart. At three knots one sweeps out of shot about
# every five seconds, and a fresh one is already on the horizon ahead. It is
# the oldest speed cue there is and it costs one prefab.
#
# Nine and a half metres, not five: they are **static colliders** like
# everything else drawn without a dynamic ancestor, so a boat that runs one
# down stops on it. That is right for a navigation mark and wrong for the demo
# to walk into by accident on the taught gesture, which is dead straight.
#
# **They hang off one `Marks` node** so a test scene can shove the whole line
# out of the way with a single override — `rig_drive.loom` turns hard both ways
# and was measuring a buoy: its starboard-turn run stopped on one at z = -27.3
# and put the rider in the sea.
#
# **Ten of them, and the length is a bounds decision.** The line reaches x = 84
# — 24 s of driving, a mark passing every 2.7 s — and stops there because
# anything that frames a scene from its *bounds* rather than from its camera
# (`cargo xtask shimmer`, `cargo xtask flythrough`, `loom render --yaw`) pulls
# back to hold the whole line, and that is the exact trap the grass phase spent
# a night on: a metric that frames automatically silently stops containing the
# subject.
#
# **Checked, and it is not this line's doing.** `loom render --yaw 30
# --pitch -25` on this scene renders from *under water* — and so does the same
# command on `assets/games/fishing.loom`, which nothing here touches. An
# `ocean` `WaterBody`'s own bounds already dominate any of these scenes, so
# bounds-framing was broken for the whole family before there were any marks.
# The length is still kept short, because the trap is real even where it has
# already sprung.
# ---------------------------------------------------------------------------

[[node]]
name = "Marks"
parent = "Rig"

[[node]]
name = "Mark1"
parent = "Rig/Marks"
prefab = "buoy"
transform = { pos = [12.0, 0.0, -20.0] }

[[node]]
name = "Mark2"
parent = "Rig/Marks"
prefab = "buoy"
transform = { pos = [20.0, 0.0, -20.0] }

[[node]]
name = "Mark3"
parent = "Rig/Marks"
prefab = "buoy"
transform = { pos = [28.0, 0.0, -20.0] }

[[node]]
name = "Mark4"
parent = "Rig/Marks"
prefab = "buoy"
transform = { pos = [36.0, 0.0, -20.0] }

[[node]]
name = "Mark5"
parent = "Rig/Marks"
prefab = "buoy"
transform = { pos = [44.0, 0.0, -20.0] }

[[node]]
name = "Mark6"
parent = "Rig/Marks"
prefab = "buoy"
transform = { pos = [52.0, 0.0, -20.0] }

[[node]]
name = "Mark7"
parent = "Rig/Marks"
prefab = "buoy"
transform = { pos = [60.0, 0.0, -20.0] }

[[node]]
name = "Mark8"
parent = "Rig/Marks"
prefab = "buoy"
transform = { pos = [68.0, 0.0, -20.0] }

[[node]]
name = "Mark9"
parent = "Rig/Marks"
prefab = "buoy"
transform = { pos = [76.0, 0.0, -20.0] }

[[node]]
name = "Mark10"
parent = "Rig/Marks"
prefab = "buoy"
transform = { pos = [84.0, 0.0, -20.0] }

# ---------------------------------------------------------------------------
# THE FISH BOX — where the catch goes, and the only way anything leaves the
# hold
#
# **A place, not a key**, exactly like the helm mat and for the same reason:
# the engine has five digital channels, `jump` is the helm release, `fire` and
# `sprint` are the rod, and there is no sixth. Walk up to the hatch and
# everything in the hold that is a fish goes below.
#
# **It was not a walk, and the arithmetic said so.** Round 5 drew it on top of
# `col_engine_box` at local (-7.80, 0.0) and claimed 1.84 m from the helm mat's
# *centre* against a `RANGE` of 2.0. The mat is not a point: `at_helm` is a
# 3.4 x 1.75 m rectangle, its starboard edge is at z = -0.90, and the closest
# helm position to that hatch was **0.90 m** away. So a landed fish was stowed
# on the tick it was landed — traced on `rig_fish.loom`, `notice` went 2 -> 3 in
# one tick and `state.infish` was 0 at every sample. The capacity rule the whole
# round was built around held a slot for a single frame, and no assertion in
# `scripts/green.sh` could ever see it occupied.
#
# It is now on the starboard side of the aft cockpit, at local (-8.30, 1.42),
# on `col_deck_aft` (x -9.55..-6.05, z +/-2.62, top 0.64) and just forward of
# `StepLow`. The nearest point of the helm rectangle is 2.32 m away against a
# `RANGE` of 2.0 — **0.32 m of margin, and the margin is the feature**: you let
# go of the wheel, cross the cockpit and put the fish below, which is three
# seconds of doing something rather than a number that changes itself.
#
# **ROUND 8: IT HAD NO PIXELS, AND THAT IS WHY THE INSTRUCTION FAILED.**
#
# It was a 0.55 x 0.30 m plate, eight centimetres thick, in albedo
# [0.14, 0.20, 0.22] — dark slate on a dim sole. Rendered from the player's own
# eye at the landing tick at eight headings 45 degrees apart, **nothing in any
# of the eight frames reads as a fish box**: the aft view is boarding treads, a
# hose coil, a lifebuoy and dark deck where the hatch is. So the caption after
# the demo's climax named a target the player could not see, in a frame he was
# not standing in ("to starboard" is true of the *boat*), and the one gesture it
# implied walked him into `col_engine_box`.
#
# It is now a **fish box rather than a hatch**: the same 1.10 x 0.60 m footprint
# it always had, but half a metre tall instead of sixteen centimetres, in a
# worked yellow, with a pale lid overhanging it. The caption names the colour
# and `deeper_rules.rhai::toward` names the bearing in *his* frame with the
# distance in metres, so the two halves — see it, and be told where it is —
# arrive together.
#
# **`scale` on a `box` is the HALF-extent**, which cost a render to find out:
# `primitives.rs::box_mesh` puts its vertices at ±1 on every axis, so a scale of
# 0.90 is 1.80 m of box. The first draft of this node read 0.90 x 0.40 x 0.60 as
# metres, drew a 1.8 x 0.8 x 1.2 m chest across the cockpit, and swallowed the
# lid whole — the lid node loaded, `--assert` found it at local_y 1.06, and it
# was invisible because it was *inside*. Found by painting each node a flat
# primary and re-rendering: the body turned cyan, the lid changed nothing.
# `HelmMat` two nodes down states the same convention from the other side —
# scale 1.70 for a mat the file calls 3.4 m.
#
# So: body x -8.85..-7.75, z 1.12..1.72, y 0.64..1.14 — standing on the sole,
# not sunk into it. Lid x -8.88..-7.72, z 1.09..1.75, y 1.14..1.22.
#
# **Its footprint clears the bait box it stands behind.** `col_engine_box` is
# x -8.40..-7.20, z ±0.78, so the nearest approach is 0.31 m in z, and the
# starboard bulwark's inner face is at z = 2.56.
#
# **Deliberately not moved.** The stow `RANGE` is 2.0 m from the *helm
# rectangle's* nearest point, and that rectangle is 3.4 x 1.75 m centred at
# (-7.80, -1.775) — so everything within 2 m of it is excluded, and on this deck
# (x -9.55..-6.05, z ±2.62) the only remaining ground is the starboard strip at
# z > 1.10. The placement is forced by the geometry, not chosen; what was wrong
# was that you could not see it.
#
# Drawn only. Under a dynamic ancestor, so no *collider* is baked from it and
# the box underneath is what the capsule meets — the same rule as `HelmMat`,
# stated twice in this file because it is the likeliest thing to get wrong when
# a third one is wanted. Its height is therefore free of collision: half a metre
# of yellow is a landmark and not a kerb to trip on.
#
# **But it is NOT free of the simulation, and this file used to say it was.**
# Moving this node one millimetre changes `deeper_demo.loom`'s physics hash —
# with no input at all, the hull moored and the player standing on the rig
# thirty metres away. So does moving `HelmMat` one millimetre. Repainting either
# does not, so it is the transform and not the material. That is measured and
# the mechanism is not found: `loom_ecs` sets `collider_half_extents` only from
# an authored `BoxCollider` (neither node has one), and `play.rs`'s three arms
# then give a drawn node under a dynamic body no rigid-body collider at all, so
# the path it takes into the solver is somewhere else — the water body's ground
# or obstacle bake are the untested suspects.
#
# **What that costs, and what it does not.** Nothing pins this scene's hash, the
# observable paths are identical to four decimal places at ticks 100, 300 and
# 600, every pinned number in `scripts/green.sh` holds, and three fresh
# processes are byte-identical — there is a row for that now. What it means is
# that **authoring a drawn prop on this hull is a simulation change**, so the
# gameplay block has to be re-run for a decoration, and "it is only a mesh" is
# not a reason to skip it. Worth an engine round; it is not a demo round's
# to fix.
[[node]]
name = "FishHold"
parent = "Rig/Boat"
transform = { pos = [-8.30, 0.89, 1.42], scale = [0.55, 0.25, 0.30] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

  [node.components.Material]
  albedo = [0.52, 0.38, 0.05]
  roughness = 0.55
  metallic = 0.0

# The lid, and it is a second node because one flat slab reads as a crate
# rather than as a box you put something *in*. Proud by eight centimetres and
# overhanging by three, which is what makes it read as a lid rather than as a
# painted line.
#
# **The lid carries the yellow and the body is the darker tone, which is the
# way round it had to be.** The first version was a bright body with a pale
# lid, and from the player's own eye at the landing — standing, looking down at
# a box whose top is 0.50 m off the deck — the lid is nearly all of what he can
# see and the yellow was a sliver on one side. The caption says YELLOW FISH BOX,
# so the face he actually looks at is the face that has to be yellow. Rendered
# both ways before choosing.
[[node]]
name = "FishHoldLid"
parent = "Rig/Boat"
transform = { pos = [-8.30, 1.18, 1.42], scale = [0.58, 0.04, 0.33] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

  [node.components.Material]
  albedo = [0.90, 0.72, 0.10]
  roughness = 0.65
  metallic = 0.0

[[node]]
name = "HelmMat"
parent = "Rig/Boat"
transform = { pos = [-7.80, 0.63, -1.775], scale = [1.70, 0.02, 0.875] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

  # **Grey rubber, because there were two olive-yellow slabs on one deck and the
  # caption names a colour.** The mat was [0.62, 0.44, 0.12] at 3.4 x 1.75 m —
  # five times the fish box's area and the same hue family one stop down. A
  # stranger told to find "the YELLOW FISH BOX" was looking at the thing he
  # steers from. Repainting does not move this scene's physics hash; moving
  # either node does. See the fish box's note.
  [node.components.Material]
  albedo = [0.20, 0.22, 0.24]
  roughness = 0.9
  metallic = 0.0

# ---------------------------------------------------------------------------
# THE BOARDING STEPS — the way *off* her, and the hole round 2 left
#
# Round 2 shipped a boat you could walk onto and could not walk off. The
# geometry was one-way and the three numbers say exactly why:
#
#   rig deck top          1.40      world, hull at rest
#   bulwark cap top       1.62      `col_bulwark_aft_stbd`, y 0.96 +/- 0.66
#   cockpit sole top      0.64      `col_deck_aft`, y 0.49 +/- 0.15
#
# Rig -> boat is a 0.22 m rise against `step_height = 0.25`, so you walk it
# without noticing it happened. Boat -> rig is a **0.98 m** climb, four times
# the step, so you cannot — traced before these treads existed, holding "toward
# the rig" from the cockpit: 0.70 m of travel and then a dead stop at
# z = -8.25 held for fourteen seconds, the capsule pressed against the inside
# of the bulwark. With `jump` held the same run reaches the rig in 240 ticks,
# and nothing anywhere says so. **A door you have to guess is not a door.**
#
# **Three treads, each riser one the controller will step.** 0.64 -> 0.88 ->
# 1.13 -> 1.38 -> 1.62 is four rises of 0.24 / 0.25 / 0.25 / 0.24, every one
# inside `step_height`. Boxes rather than a ramp because a ramp is one
# `rot_euler` whose sign convention has to be right, and a tread is a number
# you can subtract from its neighbour and check by reading.
#
# **They sit in the boarding lane** — boat-local x -8.70 to -6.50, hard against
# the starboard bulwark's inner face at z = 2.56. `col_engine_box` (the bait
# box) spans x -8.40..-7.20 and z -0.78..0.78, so it shares x with these and
# never z, and `HelmMat` is at z -2.65..-0.90, four metres further forward.
#
# **2.2 m wide rather than the 1.2 m the walk actually uses**, because the lane
# is narrow and this is the cheapest metre of forgiveness in the scene. Held
# from the spawn with a lateral drift, walking forward the whole way:
#
#   move_x    +0.5  +0.3  +0.2  +0.1  +0.05    0   -0.05  -0.1  -0.2  -0.3
#   boards?     no    no    no    no     no  yes     yes   yes   part    no
#
# **Both edges of that band fail softly and differently.** Drift east and
# `RailNorthEast` stops you *on the rig*, which is why that rail is staying
# where it is even though it is only 0.25 m off the player's shoulder: a rail
# you bump into is a better boundary than a hole you fall through, and moving
# it east would replace one with the other. Drift west and you walk past her
# aft end into the sea, which is what the swim clause and the slipway are for.
# Neither is a lost game; both are a second try. Widening the treads does not
# change that band — it is set by the cockpit's own x extent — but it does mean
# a player who is *nearly* in the lane still lands on a stair rather than on
# the bulwark cap.
#
# **Each carries its own `BoxCollider`, and that is not decoration.** A
# renderable node under a *dynamic* ancestor is not given a static collider
# from its drawn bounds — that is exactly what makes `HelmMat` paint instead of
# a kerb — so a tread that is only drawn is a tread you fall through. Same rule
# stated twice in this file, and the likeliest thing to get wrong when a fourth
# one is wanted.
#
# They improve boarding as a side effect: you used to drop a metre into the
# cockpit and now you walk down.
# ---------------------------------------------------------------------------

[[node]]
name = "StepLow"
parent = "Rig/Boat"
transform = { pos = [-8.00, 0.76, 1.81], scale = [1.50, 0.12, 0.15] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

  [node.components.BoxCollider]
  half_extents = [1.50, 0.12, 0.15]

  [node.components.Material]
  albedo = [0.31, 0.27, 0.22]
  roughness = 0.85

[[node]]
name = "StepMid"
parent = "Rig/Boat"
transform = { pos = [-8.00, 0.885, 2.11], scale = [1.50, 0.245, 0.15] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

  [node.components.BoxCollider]
  half_extents = [1.50, 0.245, 0.15]

  [node.components.Material]
  albedo = [0.31, 0.27, 0.22]
  roughness = 0.85

[[node]]
name = "StepHigh"
parent = "Rig/Boat"
transform = { pos = [-8.00, 1.01, 2.41], scale = [1.50, 0.37, 0.15] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

  [node.components.BoxCollider]
  half_extents = [1.50, 0.37, 0.15]

  [node.components.Material]
  albedo = [0.31, 0.27, 0.22]
  roughness = 0.85

# ---------------------------------------------------------------------------
# ROUND 9 — SOUND, INSIDE WHAT THE ENGINE ACTUALLY HAS
# ---------------------------------------------------------------------------
#
# **The demo was silent.** No `AudioSource` anywhere, `loom audio` reporting
# `rms 0.0`, and a hub whose whole tonal job in the GDD is to be the cozy
# baseline the rest of the game is measured against.
#
# **What the engine has is autoplay loops and nothing else, and that is a hard
# limit rather than a gap to route around.** `sound.rs:131` builds a `Voice`
# only inside `if flag("autoplay", ..)`; a source with `autoplay = false` is
# registered for occlusion solving and never gets a voice, and no other call
# site starts one. Node scripts may write `position`, `rotation` and `scale`
# and nothing else. So **nothing in the fishing loop can make a noise** — not
# the cast, not the bite, not the hookset, not the landing, not the lid of the
# box — and the one moment that most wants one, the 300 ms `BITE!  CLICK NOW`
# window, is exactly the moment audio provably cannot reach. That is an engine
# round with an ADR in it, and it is not this one.
#
# **So the state a loop follows is its DISTANCE**, which is the one thing a
# script can write. `AudioSource.range` is linear (the schema says why), so a
# node that moves is a volume fader with occlusion attached — and the fade is
# measured through the actual level rather than authored, which is the whole
# point of this engine's audio.
#
# Three sources, and the third is the only one that moves:
#
#   * `SeaWash` — the hub's bed, at the waterline in the berth. 55 m of range
#     covers the rig and the near sea.
#   * `Boat/Wash` — the same clip on the hull, so the sea does not fade out
#     when you leave. Quieter and shorter-ranged; alongside they sum, which is
#     what water between a hull and a rig leg actually does.
#   * `Boat/Engine` — `hum` under the cockpit sole, driven by `engine_note.rhai`
#     off `state.knots`. **Moored, she is silent, and that is correct rather
#     than a limitation**: the engine is not running. It swells as she gathers
#     way and dies as she coasts, which is a loop following a state.
#
# **`sea.wav` is synthesised and `scripts/make-sea-wav.py` is how.** There is no
# sea recording in this repository — there are two clips in it, a hum and a
# rain — and passing the rain bed off as a sea would be a lie in a scene file
# that nobody could hear was one. It is eight seconds of pink-weighted noise
# built in the frequency domain over exactly the loop length, so every partial
# is an integer harmonic and the loop has no seam, under a three-harmonic
# swell so it breathes instead of hissing.
#
# **None of this is in any gate and that is stated rather than hidden.**
# `loom audio` measures the weather bed and does not mix `AudioSource` at all
# (checked: `loom audio assets/games/proving_ground.loom` reports `rms 0.0`
# on a scene that has one). There is no headless path to a mixed frame, so
# what is verified here is that the scene loads, that the clip decodes, and
# that `Engine`'s transform tracks `knots` — `--assert` can read the last of
# those, and there is a row for it. How it *sounds* is one human with
# headphones, and no round should pretend otherwise.

[[asset]]
key = "sea"
id = "a51c7d92-3e64-4f08-b7a1-2d96c40e8b73"
path = "../audio/sea.wav"

[[asset]]
key = "hum"
id = "e70c4b18-25a9-4f36-8d51-3b6e9a0c7f42"
path = "../audio/hum.wav"

# The berth's waterline, between the rig legs and the hull. Not on the player:
# an ambient bed parented to the listener is a constant, and a constant is the
# one thing this engine's audio is not for.
[[node]]
name = "SeaWash"
parent = "Rig"
transform = { pos = [0.0, -0.25, -5.20] }

  [node.components.AudioSource]
  clip = { asset = "sea" }
  volume = 0.70
  range = 55.0
  looping = true

# The same wash on the hull, so thirty metres out is not silence. Boat local,
# amidships, just under the waterline.
[[node]]
name = "Wash"
parent = "Rig/Boat"
transform = { pos = [0.0, -0.35, 0.0] }

  [node.components.AudioSource]
  clip = { asset = "sea" }
  volume = 0.50
  range = 35.0
  looping = true

# **The engine, and the only thing in this demo whose loudness answers to
# gameplay.** It travels straight down, so it is always *below* her rather than
# swinging round her — the hull stays between it and the helmsman at every
# setting and only the distance changes. See `engine_note.rhai`.
[[node]]
name = "Engine"
parent = "Rig/Boat"
transform = { pos = [-7.80, -12.0, 0.0] }

  [node.components.AudioSource]
  clip = { asset = "hum" }
  volume = 0.85
  range = 14.0
  looping = true

  [node.components.Script]
  path = "../scripts/engine_note.rhai"
