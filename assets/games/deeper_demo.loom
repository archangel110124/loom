# **DEEPER — the demo. Round 6: the four features became one trip.**
#
#   loom run assets/games/deeper_demo.loom --play     <- THE DEMO. `--play` is
#                                                        not optional: without
#                                                        it `run` opens the
#                                                        read-only editor,
#                                                        paused, and every
#                                                        `Hud` in this file is
#                                                        `only_in_play`, so a
#                                                        stranger who types the
#                                                        line at the top of the
#                                                        file gets a frozen
#                                                        diorama with no
#                                                        instructions on it.
#                                                        This line used to be
#                                                        the version without
#                                                        the flag. **It also
#                                                        used to open the
#                                                        Hierarchy, Inspector
#                                                        and Console around a
#                                                        game in 39% of the
#                                                        window**; `--play`
#                                                        without `--edit` now
#                                                        builds no panels.
#   loom render assets/games/deeper_demo.loom --out /tmp/rig.png
#   loom sim assets/games/deeper_demo.loom --ticks 900 --hold move_z=1 \
#     --assert "Rig/Boat.x > 29.0"      # walk forward. That is the whole demo.
#   loom sim assets/games/deeper_demo.loom --ticks 900 --hold "move_z=1,fire=1" \
#     --assert "events.bite >= 1"       # ...and click. That is the other half.
#
# **Both of those lines are gate rows in `scripts/green.sh`, and until round 9
# neither was.** The first one shipped as `> 30.0` against an actual 29.888 and
# exited 1 with a wall of hint text — the only documentation this demo has,
# with its headline command failing. Two of the three numbers in "Measured:"
# below were stale by the same amount. A documented command that is not in a
# gate is a claim, not a fact.
#
# The hub of the GDD's §7 — a rusted floating platform lashed to the surface
# above the trench, part oil rig, part fishing wharf. Early game it is meant to
# be the cozy tonal baseline, so it is bright, warm and low-fog: the "before"
# the rest of the game is measured against. Nothing here curdles yet.
#
# There are four things in this demo and no fifth: **a hub, a boat you can
# drive, fishing you can do, and four slots to carry things in.** Round 1 built
# the hub and stood the player on it. Round 2 made the boat boardable and
# drivable, and going into the water something you come back from. Round 3 was
# the seam in both directions — off her on foot, off the wheel on foot, and
# arriving at a quay without driving your own hull under it. Round 4 put a rod
# on the boat that bends.
#
# **Round 5 is the three things that stopped a stranger playing it.**
#
#   * **The boarding lane was six degrees wide** and the one gesture the demo
#     teaches sat on its right-hand edge: `move_x = 0.05` — three degrees of
#     aim — boarded nothing. The spawn is 0.9 m further west, the boarding
#     treads are 3.0 m instead of 2.2 and the helm mat 3.4 m instead of 2.6.
#     Measured at 600 ticks, the wheel is reached from **-0.21 to +0.21**,
#     which is 24 degrees, symmetric. (Round 5 wrote "-0.18 to +0.25" here off
#     a coarser sweep; re-swept at 0.01 steps in round 6, both edges are 0.21.
#     The width claim survives and got better on the left.)
#   * **Outside that lane the HUD used to lie.** Both failures — pressed into
#     her topsides, and swimming — printed "WALK FORWARD TO THE BOAT" for ever.
#     `deeper_player.rhai` now states both facts and the caption has a branch
#     for each.
#   * **You could not see that you were moving.** A line of channel marks lies
#     nine and a half metres off her track, on the beam the helmsman faces. See
#     "THE MARKS", below, for the measurement and for the fix that is not this
#     one.
#
# And the fourth thing became an inventory rather than a checklist: bait is
# **spent** and changes a number, a landed fish **takes a slot**, four slots
# are reached by playing, and the fish box in the cockpit is what empties
# them. `assets/scripts/deeper_rules.rhai` has the four rules and why.
#
# **Round 6 is the loop closing, which is three things.**
#
#   * **There is a reason to come back, and it is one node.** `FishCrate` on
#     the wharf takes what is in her hold, `state.delivered` counts it, and the
#     HUD's top row prints it. It refuses unless she is alongside — the catch
#     is in a hull, and a hull thirty metres out is not a delivery. The thing
#     that makes it a *loop* rather than a reward is that the **bait is on the
#     rig**: the fish eats yours at the take and there is none at sea.
#   * **Nothing you do is unrecoverable any more.** `Ladder` is a second ramp,
#     on the berth side, in a 2.0 m gap cut in `RailNorthWest` — because the
#     one gesture the demo teaches, missed by twelve degrees to port, put a
#     player 26 m from the only way out and the caption sent him the other way.
#     See its own block below for the measurement.
#   * **And the caption stopped strobing and stopped lying.** `aboard` latches
#     across airborne frames (it flipped six times in forty ticks climbing over
#     the bait box, telling the player to walk to a boat he was standing on and
#     silently eating his `fire` presses); the landing sentence can actually be
#     drawn, which it could not; and the swim bearing is computed from where
#     the swimmer is rather than written down once.
#
# `assets/test/rig_trip.loom` is the whole thing in one process — out, a fish,
# stowed, home, ashore, in the crate — and `assets/test/rig_adrift.loom` is the
# control that says the crate needs the boat.
#
# **Round 8 is telling the player what is happening, and every defect it found
# was a feedback defect rather than a missing feature.**
#
#   * **The one instruction the demo gave after its climax pointed the wrong
#     way.** `LANDED   the fish box is to starboard` is true about the *boat*
#     and useless to a man standing in his own frame with his back to it —
#     measured, the box is 3.4 m behind him — and the target it named had no
#     pixels at all. Both halves are fixed: `deeper_rules.rhai::toward` states
#     the bearing and the distance in the player's frame, off a `heading` the
#     movement script emits, and the box is a yellow box on the sole instead of
#     a dark hatch flush with it.
#   * **The fight is twenty-two of a round's twenty-three seconds and it had no
#     picture.** `float_bob.rhai`'s load term dragged the float *under* — at
#     stress 59, 72 and 82 the only object in the shot was not in the shot. The
#     load now sets a rate and an amplitude instead of a depth, so the float
#     bucks harder the harder the fish pulls.
#   * **`BLOCKED` could not fire where a player actually gets blocked.** It was
#     gated ashore-only, measured as a per-tick rate that contact jitter defeats,
#     and it sat *below* `aboard` in the caption ladder. All three.
#   * **The line at the top of this file did not start the demo** — without
#     `--play`, `run` opens the paused editor and every `Hud` here is
#     `only_in_play`.
#   * **Four pickups in 1.3 seconds, in silence**, and a helm that listed its
#     bindings without ever saying what the two controls were set to.
#
# The whole demo, in the order a stranger meets it:
#
#   1. spawn on the rig facing a boat. Walk forward — past four supplies laid
#      along the way, which is the whole hold filled by the taught gesture.
#   2. you are aboard, at the wheel, and channel marks stream past to port.
#      The caption still carries `state.knots`, because a mark every 2.7 s is a
#      sense of speed and not a number.
#   3. press SPACE. You have let go of the wheel — and the caption *changes*,
#      which in round 3 it did not.
#   4. click. The rod on the port bulwark casts. Wait, and a fish takes it.
#   5. click again inside 300 ms to set the hook, then hold SHIFT to reel and
#      let go when it runs. The blank bends with the load, because all
#      twenty-four joints of it read `state.stress`.
#   6. land it and it takes a slot — which the bait it ate has just left free.
#      Land a second without stowing the first and the hold is full and says
#      so. **SPACE, then follow the caption**: it names the yellow fish box, in
#      metres, in your own frame — `3 m dead behind you` — and keeps saying so
#      for as long as the fish is in your hands. The box is on the starboard
#      side of the cockpit and the bait box is between you and it, so the walk
#      is a dogleg; press into the bait box for four seconds and the caption
#      says that too. It is 2.32 m from the wheel against a `RANGE` of 2.0,
#      which is the difference between a walk and a number that changes itself.
#   7. take her home — **you left ahead, so astern is how you come back**, and
#      the helm caption carries `CRATE nn m` for as long as there is a fish
#      below so the number tells you which. (This line said the opposite for
#      three rounds. Measured: W at the wheel takes `Rig/Boat.x` from 3.00 to
#      29.89.) Step off over the boarding steps, and walk west along
#      the wharf to the crate. `CRATE` on the HUD goes up. Then take bait, and
#      go again.
#
# ---------------------------------------------------------------------------
# THE CONTROLS, IN FULL
# ---------------------------------------------------------------------------
#
#   on the rig      W A S D walk, Shift sprint, Space jump
#   on `HelmMat`    W ahead, S astern, A wheel to port, D wheel to starboard,
#                   **Space is hands off the wheel** and gives you your legs
#                   back; nothing pressed is neutral and she coasts to a stop
#   anywhere aboard **CLICK casts, sets the hook and takes a rhythm window;
#                   SHIFT reels.** Both are refused ashore, and refused by
#                   never being sent rather than by a rule that says no.
#   in the water    W A S D swim, at under half walking pace. The caption names
#                   the **nearer of the two ramps** and the compass word for the
#                   direction it lies in, computed from where the swimmer is —
#                   round 5's named one bearing, which was right from one corner
#                   of the sea and 114 m wrong from the other.
#   at the fish box the catch goes below. **A place, not a key** — the same
#                   decision the helm mat is, and for the same reason: there is
#                   no sixth digital channel.
#   at the crate    what is below goes ashore and `CRATE` goes up, but only with
#                   the boat alongside. Same decision again, and it is the only
#                   rule in the demo that needs you to have been somewhere and
#                   come back.
#
# **Reel is SHIFT and not W, and that is a change from `fishing.loom`.** There
# the angler is a post whose movement model pins him to the deck, so W is free.
# Here W is the throttle at the wheel and his legs everywhere else, and binding
# reel to it would mean either walking off the boat while playing a fish or a
# third stance with its own way in and its own way out. `sprint` was unspent and
# "hold to reel" survives the move intact. The cost: aboard, SHIFT is reel *and*
# still sprint, so sprinting round the cockpit with a fish on loads the line.
# That is a dozen ticks of stress on a hundred-point meter.
#
# **Space is the only control in this scene that is not a place**, and it is
# here because the alternative was worse rather than because a fifth binding
# was wanted. Round 2 made `speed` zero on the mat, so your legs did not exist
# and the only exit was jump-plus-a-direction — a direction that was
# simultaneously the wheel, which put the player in the sea twelve metres
# astern of a boat he had just spun. It spends nothing: `fire` is still
# untouched and belongs to fishing, and `jump` still jumps everywhere in the
# scene except on this one 1.3 x 0.9 m patch of deck.
#
# **Fishing is a state, not a place, and that is deliberate asymmetry.** The
# helm has to be a place because W/S/A/D mean something different there and a
# player must be able to stop meaning it; the rod spends two channels that mean
# nothing else anywhere, so it needs no station to step off. Aboard is the only
# condition, and it is enforced in `deeper_player.rhai` by not emitting the
# event at all — a rod cast from the wharf is a thing that never reaches the
# fight rather than a refusal the fight has to carry.
#
# **The helm is a place, not a keybinding**, and the whole scene is laid out so
# that one fact does not have to be explained. The player spawns at x = -3.70
# facing the gap in the berth railing; the gap is where the boat's cockpit is;
# the cockpit is where `HelmMat` is drawn. **Walk forward and you board her,
# arrive at the wheel and get under way, on one key.** Measured: aboard by
# tick 180, at the wheel at tick **356**, and `Rig/Boat.x` at **29.89** by tick
# 900 — 26.9 m of travel from her berth at 3.00. (Round 5 wrote "on the mat and
# moving by tick 240, 34 m clear"; re-measured tick by tick in round 9, helm
# first latches at 356 and `knots` there is 0.06. Both rows are now in
# `scripts/green.sh`, which is why they will not go stale again.)
#
# That mapping spends none of the engine's five digital channels — `jump` is
# still jump and `fire` is still unspent, for fishing — and there is no fifth
# channel to spend on a "take the helm" button.
#
# ---------------------------------------------------------------------------
# DECISION 1 — WHAT THE PLAYER IS
# ---------------------------------------------------------------------------
#
# **`Rig/Player`**: a `CharacterController` 1.8 m tall and 0.35 m in radius,
# driven by `../scripts/deeper_player.rhai`, with `Rig/Player/Eye` carrying the
# `Camera` as its child.
#
# That last part is not decoration. `World::player_character` walks *up* from
# the active camera to the nearest ancestor with a `CharacterController`, so
# **parenting the camera to the character is what makes it the player** — and
# it is also what makes the rig first person, because `Play::apply_look` puts
# yaw on the character and pitch on the eye. There is no `Player` flag
# component to set and there must not be one; the hierarchy already says it.
#
# The movement script is `deeper_player.rhai` and not `fps.rhai` for one
# reason, written at the top of that file: `fps.rhai` detonates a 5 m blast
# where the view ray lands when `fire` is pressed, and the centrepiece of this
# scene is a 43,776 kg dynamic rigid body. `fire` is also the binding fishing
# spends. It arrives here unspent.
#
# **The player faces the boat at yaw 0, and the whole rig is laid out around
# that.** `Play::start` takes its opening yaw from the *eye node's* authored
# rotation and then writes yaw onto the *character*, leaving the eye's own yaw
# in place underneath — so an authored eye yaw is counted twice the moment play
# begins, and an authored character yaw is overwritten by it. Neither can
# express "start facing this way". So the scene is turned instead of the
# camera: the berth is on −Z, which is where yaw 0 looks, and `loom render` and
# `loom run` therefore agree about the opening shot. (The double-count is a
# real engine wrinkle and worth an issue; it is not worth an engine change
# inside a demo round.)
#
# ---------------------------------------------------------------------------
# DECISION 2 — WHERE THE FOUR INVENTORY SLOTS LIVE
# ---------------------------------------------------------------------------
#
# **In `GameRules` state**, as `state.hold` (the list) and `state.carried` (its
# length), owned by `../scripts/deeper_rules.rhai`. The alternatives — a
# movement script's `memory`, and the event log — are weighed and rejected in
# that file's header, which is where the decision belongs because that is where
# a reader arrives when the hold misbehaves. The short version: `memory` is
# invisible to both `loom sim --assert` and the `Hud`, and the event log is a
# record rather than a container.
#
# **The four slots are also four numbers** — `state.bait`, `state.line`,
# `state.lantern`, `state.thermos` — because the `Hud` can draw a number and
# could always draw several. Round 5 adds `state.infish` (fish in the slots),
# `state.stowed` (fish put below) and `state.full`, and the events `spend`,
# `stow` and `refused` beside `pickup`. **Eight of those are asserted in
# `scripts/green.sh`**, which is the requirement an inventory nobody can read
# from outside the game fails.
#
# The one cost, stated: `state` is not in `state_hash`, so `cargo test` and
# `cargo xtask repeat` are blind to the hold and `--assert` is its only
# detector. Same bargain the fight makes.
#
# ---------------------------------------------------------------------------
# DECISION 3 — THE SEA IS THE SAFETY DEVICE, NOT THE RAILING
# ---------------------------------------------------------------------------
#
# Round 1 sealed the rig on four sides and the seal leaked anyway. Walk into any
# rail at plain walking speed, keep pressing, and hop: the capsule's rounded
# foot catches the cap bar's inner edge at exactly the jump apex and is climbed
# over it. Traced, on the east rail — tick 315 pressed against it at y 2.318,
# tick 335 at the ballistic apex 3.617 with its feet at 2.717 inside `CapEast`'s
# 2.68-to-2.92 band, tick 345 at 3.839 standing *on* the cap, tick 350 outboard,
# tick 600 at y = -202.17 and still falling.
#
# **A taller rail cannot fix that**: the height a solid wall would need is the
# jump apex plus the step height, which is above the player's own eye, and a
# 1.5 m parapet was already rejected in round 1 for hiding the boat. The berth
# has to open anyway or nobody can board. So the railing stops being what keeps
# the player safe:
#
#   * `deeper_player.rhai` **floats** a capsule that goes under, at the surface;
#   * the **slipway** at the east end lets it walk back out;
#   * and `assets/test/rig_overboard.loom` asserts both, with the real player
#     model and no teleport.
#
# The rails are still rails — they stop a walk — and they are now set dressing
# rather than the thing a life depends on.
#
# ---------------------------------------------------------------------------
# WHAT IS THIN, AND KNOWN
# ---------------------------------------------------------------------------
#
# * **The wheel, the throttle and the shifter do not move.** All four movable
#   parts in `jib_vi.loom` are separate meshes with **no transform of their
#   own**, so each one's pivot is the hull's origin up to nineteen metres away
#   and rotating the node swings the part across the boat. Animating them is a
#   mesh-authoring job — each part wants its geometry re-centred on its own
#   pivot — and no scene edit can substitute. **The second half of that bullet
#   has stopped being true**: a node `Script` now reads the rules script's
#   numbers (that is what bends the rod), so `state.knots` or a throttle
#   setting could drive a lever the moment the pivots exist. What is missing is
#   the mesh work, and only the mesh work.
# * **Releasing the throttle is not directly asserted.** `loom sim --hold` is
#   one constant for a run, so "hold W then let go" needs a schedule that does
#   not exist. What is asserted is the pair either side of it: zero thrust
#   leaves her exactly where she is (`rig_drive` run 1), and stepping off the
#   mat writes zero thrust every tick (`deeper_player.rhai`'s `else if aboard`).
# * ~~A player who jumps off the boat while she is under way leaves her
#   running.~~ **Not reproducible, and this bullet was wrong.** Leaving the mat
#   makes `at_helm` false while `aboard` stays true, so `else if aboard` in
#   `deeper_player.rhai` writes the zero on the very next tick — it was already
#   correct when this was written. Measured on `rig_drive` with
#   `--hold "jump=1,move_z=1"`: x = 3.0002 at tick 300, 2.9998 at 900, 3.0004
#   at 1800, from a berth at 3.0. **No dead man's handle is needed and none is
#   being built.**
# * **YOU CAN SEE THAT YOU ARE MOVING NOW, AND ONLY BECAUSE SOMETHING WAS PUT
#   IN THE FRAME.** The geometry is unchanged and still wrong: the mat faces
#   her beam, the bow is ninety degrees to starboard, the wake trails astern
#   and `water@` reads **0.000 of foam abeam** against 0.103 three metres
#   behind her, so the boat itself still contributes nothing to the picture.
#   What changed is that a line of channel marks passes nine and a half metres
#   to port. Measured on the settled helm view at 480x300, `loom compare`
#   against the tick-600 frame:
#
#       0.5 s apart (the ripple floor)   mean  6.41
#       3.0 s apart                      mean  8.68
#       4.0 s apart                      mean 11.68
#       6.0 s apart                      mean 11.34
#
#   **Read that honestly: it is a weak instrument here.** The mean is dominated
#   by water ripple, and the same four rows with the marks shoved 400 m away
#   read 5.19 / 7.15 / 10.68 / 8.48 — so the marks are worth about 13% of a
#   number that was never mostly about them. The evidence is the picture: at
#   tick 600 one mark is abeam, at 690 two are, at 900 two different ones are.
#   A player watching sees them stream past.
#
#   **And measure the frame at more than one heading before deciding any of
#   this.** Every render of this demo through round 6 was taken at yaw 0,
#   because `--yaw` abandons the scene's camera and orbits the whole-scene
#   bounds instead of turning the player's head, and `--hold` has no look
#   channel. That is one bearing out of a circle a mouse sweeps in half a
#   second, and it is the bearing that produced "the helmsman's frame contains
#   no boat".
#
#   It does not need a new flag. `loom render --frames 8 --spin 45 --step 0
#   --sim <t> --hold "<keys>"` **pans an authored camera about its own eye** —
#   eight frames is the player's eye at eight headings, at one instant of one
#   run, and it has worked since the fly-through learned not to orbit
#   first-person cameras. Rendered that way at the helm the frame contains the
#   side decks, the wheelhouse, the name board, the flag, the transom and the
#   channel marks streaming past. `--help` now says so.
#
#   **The real fix is still to berth her stern-to**, bow at -Z, so the bow is
#   dead ahead from the wheel. It remains a round rather than a bullet: she
#   moves from alongside at z = -10.45 to a hull lying along Z, the boarding
#   steps move from her starboard side to her transom, **every pinned drive
#   number in `scripts/green.sh` becomes a Z number instead of an X one** — and
#   it lands the helmsman looking at the after face of the deckhouse a metre
#   away, because `col_house` ends at local x = -6.20 and the mat is at -7.80.
#   The wheel would have to move to the flybridge or the foredeck with it.
#
#   `state.knots` stays in the caption and `scripts/green.sh` still asserts it
#   both ways. "(bow is to starboard)" also stays, and it is still a workaround
#   shipped as player-facing text: it is *true*, and on a boat whose bow you
#   cannot see it is the one sentence that orients you. It comes out with the
#   berth.
# * **The rod is in a holder, not in your hands.** A renderable node with no
#   *dynamic* ancestor becomes a static collider from its drawn bounds, and a
#   `CharacterController` is not a dynamic body — so a rod parented to the eye
#   would bake twenty-four boxes of scenery at the spawn and the player would
#   walk into his own tackle. Under the hull it is geometry with no physics,
#   which is what a rod should be. Held gear wants an engine exemption for
#   descendants of a character, and that is an ADR.
# * ~~There is no line and no lure.~~ **Half fixed in round 7: there is a
#   float, and there is a fish.** `Float` and `Catch` below are two nodes with
#   node scripts, and between them the four states of the fishing loop are four
#   different pictures instead of four different strings — the float sits and
#   bobs while the bait waits, goes clean under for the six hundred
#   milliseconds the take is answerable in, is dragged deep and wide by the
#   load during the fight, and the fish hangs in the cockpit from the tick it
#   comes over the rail to the tick it goes in the box.
#
#   **There is still no line.** A line from the rod tip to the float is a
#   second node whose length is a scale, and it is the obvious next thing; at
#   six metres a real one is thinner than a pixel anyway. `fishing.loom`'s
#   `Lure` is a world-space `RigidBody` and is still the wrong shape here — a
#   hull at three metres a second leaves it astern inside a second, which is
#   exactly why the float is boat-local instead.
# * ~~The four slots fill and nothing empties them.~~ **Fixed in round 5.**
#   Bait is spent at the take, a landed fish takes a slot, and the fish box
#   empties them. Selling is still not built and is not wanted here.
# * ~~Three of the four supplies are behind the spawn.~~ **Fixed in round 5.**
#   They are strung along the walk to the berth, alternating sides 1.25 m off
#   the lane, and `state.carried == 4` is now asserted on the shipped scene
#   under `--hold move_z=1` rather than on `rig_walk.loom`'s pilot, which knew
#   a route the demo never teaches. `carried == 4` holds across the whole
#   `move_x` band -0.15 .. +0.15.
# * **The bait box is in the middle of the boarding lane and you shoulder past
#   it.** `col_engine_box` is amidships in the cockpit; the lane now runs at it
#   rather than threading the 1.0 m gap between it and the deckhouse, because
#   that gap is the narrowest thing on the route and aiming the demo down it is
#   what made the old lane three degrees wide. Traced at `move_x = 0`: aboard
#   at tick 180, grinding on the box's after face from 180 to 300, at the wheel
#   by 360. A player with a mouse steps round it; a dead-straight headless walk
#   does not. **The trade bought the lane its other twenty-one degrees.**
# * **The `Hud` rows are unverified as pixels.** ~~`Hud` draws only in `loom
#   run` and a headless render cannot show either row.~~ **Photographed in round
#   10 and one of the two rows was invisible**: `HOLD n/4 …` is authored cream
#   (`[0.86, 0.89, 0.82]`) and at the spawn heading it lands on a near-white
#   stone cylinder, so the row naming one of this demo's four features was ghost
#   glyphs. `hud.rs` now paints every line twice — a near-black copy two pixels
#   down-right, then the authored colour on top — which is the only fix
#   available, because `Hud` has `color`, `size`, `offset`, `anchor` and no
#   shadow or scrim field, and no authored colour survives a background that is
#   sky one second and pale deck the next. It draws only in `loom run`, so no
#   reference PNG moved. **What is still untested is everything else about the
#   overlay**: a `grep` on `game.message` proves a string exists and cannot
#   prove it is legible, fits, or is drawn at all.
# * **The deck is still beige and the hub still reads pale.** It was called out
#   after round 1 and it is a palette pass, not a boat.
#
# ---------------------------------------------------------------------------
# ROUND 10 — THE FIRST TWO MINUTES, AND THE EDGES
# ---------------------------------------------------------------------------
#
# Four fixes and an adversarial gate block. Every one of them came from
# somebody running the thing rather than from reading it.
#
#   1. **The one command in this file's header opened an editor.** `loom run
#      --play` drew the Hierarchy, the Inspector, the Console and a toolbar with
#      Delete on it, unconditionally, and left the game 876x576 of a 1440x900
#      window — 39%. `--play` without `--edit` now builds no dock at all and the
#      scene fills the window. `--edit` is unchanged, a bare `loom run` is
#      unchanged (that is M5.5's read-only viewer), and `cargo xtask validate`
#      passes `--edit` on both its windowed rows, so no gate moved.
#   2. **The inventory row was unreadable.** See the bullet above.
#   3. **The helm had no way home on it, and now it names a key.** `CRATE nn m`
#      appeared only with a fish below, so a first-timer — who has caught
#      nothing — held W, the one gesture this demo teaches, and 100 seconds
#      later was at x = 282 in an empty ocean with no number and no landmark.
#      The helm line now carries `HOME nn m — hold S` past sixty metres or with
#      a catch aboard. **The range is the hull's and so is the key**: at the
#      wheel the helmsman faces her beam, so "behind you" is ninety degrees off
#      "astern" and only one of the two is a throttle setting.
#   4. **At the moment the demo pays off it told you to do what you had just
#      done.** Inside `ALONGSIDE` — 14.0 m — the caption said `take her
#      alongside` at six metres and again at two, and no branch anywhere said to
#      get off the boat. It now reads `ALONGSIDE — press SPACE` at the wheel and
#      `SHE IS ALONGSIDE — step off, the crate is 2 m dead behind you` on your
#      feet.
#   5. **A hard turn to port stops the boat dead and nothing said so.** The
#      channel marks are static colliders nine and a half metres to port, so the
#      same input mirrored has two outcomes — starboard is open sea — and port
#      is the side the demo teaches a player to watch. **The existing stall
#      limiter could not see it**: `deeper_player.rhai` measures the helmsman's
#      own speed, and a hull pinned on a buoy pivots on it, so a man standing
#      seven metres off her centre keeps moving at a third of a metre a second
#      while she makes good nothing. `state.pinned` in `deeper_rules.rhai` is
#      the second detector, off her own speed, and it feeds the sentence the
#      first one already had. Measured: 0.89 kn at tick 1250, 0.58 at 2000, at
#      full ahead throughout.
#   6. **`BLOCKED` told a man walking backwards to back up.** The ashore arm was
#      a fixed string — `back up — aboard is the gap between the bollards` — and
#      it fires on any wall from any heading; the aboard arm has been computed
#      since round 9. That asymmetry was the bug. It now names where she is, in
#      his frame, off `Rig/Boat/StepHigh`.
#
# **And `scripts/green.sh` grew section 8: seven blocks of deliberately wrong
# input.** Every row before it is a tape somebody wrote after watching the thing
# work, and a gate assembled that way cannot find the state its author never
# entered — eleven lines of stupidity found three of the six defects above in
# one pass. It also contains **the first `delivered == 1` row on this file**:
# every delivery assertion in the project was on `rig_trip.loom`, a fork, so the
# demo's headline claim was a claim about a different file.
#
# ---------------------------------------------------------------------------
# KNOWN ISSUES — what a player will hit that is NOT fixed
# ---------------------------------------------------------------------------
#
# Ranked by how likely a first-timer is to meet it. None of these is a stopper;
# all of them are seams.
#
# 1. **You drive home stern-first at a wharf you cannot see.** The berth faces
#    the way it faces, so the leg the demo teaches leaves ahead and returns
#    astern with the destination behind the camera. Photographed at the arrival
#    beat: the frame is sea, sky and a rod, and the rig is 180 degrees behind.
#    Round 10 answered it with a *caption* — the range and the key — which is
#    the cheap half. The real fix is geometric (berth her bow-in, or give the
#    helm a stern view) and it moves every pinned number in `scripts/green.sh`.
# 2. **The landed fish still reads as a mitten.** It tracks the player's hands
#    correctly now; the silhouette is a grey-green body with five splayed rays
#    and it hangs in mid-air attached to nothing. Mesh work, not a scene edit.
# 3. **Every close render is dense salt-and-pepper.** That is ADR 0019's
#    eight-ray AO dither. Two sweeps found no scene-level knob that reaches it —
#    ambient is flat across 2.4x, the sun about a ninth of it — and the cure is
#    the quad-wide sample share in that ADR, which moves all 54 references.
# 4. **`state.aboard` is stale by about eighty ticks** after you step ashore, so
#    the arrival caption uses the aboard branch while you are standing on the
#    wharf. Round 10 made both branches say the same useful thing, so it is now
#    cosmetic rather than wrong.
# 5. **The helmsman can be bounced off the mat by a hard turn.** `at_helm`
#    flickers for about seventy-five ticks and the caption drops back to the
#    teaching line. He is never in danger and steps back on by himself.
# 6. **Hold W and SPACE together from the spawn and you wedge for ever.** SPACE
#    on the mat is hands-off, so the throttle never opens and the pair pushes
#    into the cockpit geometry. Releasing either key clears it, and no human
#    holds jump for thirty seconds.
# 7. **`rig_trip.loom` and `rig_adrift.loom` are 1,900-line forks of this file**
#    and they drift every time it changes. `--hold "<tick>:<keys>"` has made
#    them unnecessary since round 5. Round 10 put the first keyboard delivery
#    row on the shipped scene; retiring the forks is the follow-up.

[scene]
format = 1
id = "b2a43f8f-314a-4d92-b4aa-322411869fcd"

# The hull, its paint and its twelve pontoons, from the file that owns them.
[[prefab]]
key = "jib_vi"
id = "3c7a5e12-8b64-4f09-a2d3-6e1b90c47f58"
path = "../prefabs/jib_vi.loom"

# The deck a person stands on. See that file's header: the hull's own collider
# is its inertia and its lid is a metre above the deck, so without this the
# boat is a brick you stand on top of.
[[prefab]]
key = "jib_vi_decks"
id = "3c7a5e12-8b64-4f09-a2d3-6e1b90c47f59"
path = "../prefabs/jib_vi_decks.loom"

# The rod and its reel, from the file that owns them. Twenty-four of its nodes
# carry `../scripts/rod_bend.rhai`, so it loads up when the fight does.
[[prefab]]
key = "rod"
id = "7f2c14a9-63d8-4e51-b0a7-2d9e5c81f430"
path = "../prefabs/fishing_rod.loom"

# The channel marks. See "THE MARKS", below.
[[prefab]]
key = "buoy"
id = "1a6f42d7-58b0-4e93-9c21-7d4b6e0f3a85"
path = "../prefabs/channel_buoy.loom"

# The catch, in the two meshes it ships as: `_chrome` is the body and
# `_coral` is every fin and the tail. Rendering only the body gives a pale
# featureless lozenge, which is what the first attempt looked like.
# 0.10 m nose to tail as it ships, so `fish_hang.rhai` scales it.
[[asset]]
key = "gleamsprat"
id = "6537b1f4-2257-44de-9ba2-a4b0b56d7085"
path = "../meshes/gleamsprat_chrome.obj"

[[asset]]
key = "gleamsprat_fins"
id = "b3a90c47-1f52-4d68-9e04-5c7218ab3d61"
path = "../meshes/gleamsprat_coral.obj"

[[asset]]
key = "box"
path = "box"

[[asset]]
key = "cylinder"
path = "cylinder"

# ---------------------------------------------------------------------------
# THE WORLD
# ---------------------------------------------------------------------------

[[node]]
name = "Rig"

  [node.components.GameRules]
  path = "../scripts/deeper_rules.rhai"

  # Bright, warm, low sun. The GDD asks the hub to be the cozy baseline, and
  # every later escalation is a change to these seven numbers rather than to
  # the geometry.
  [node.components.Environment]
  sun_direction = [0.42, 0.46, -0.78]
  sun_strength = 1.25
  sun_color = [1.0, 0.93, 0.80]
  ambient = 0.45
  sky_zenith = [0.16, 0.30, 0.52]
  sky_horizon = [0.74, 0.72, 0.66]
  fog_density = 0.0028
  fog_falloff = 0.05

  # Light air. Enough to move the surface; far too little to trouble the boat.
  [node.components.Wind]
  direction_degrees = 20.0
  speed = 3.0
  gustiness = 0.25
  turbulence = 0.15

# **`deterministic`, not `cinematic`.** ADR 0053's cinematic tier is read back
# off the GPU and `loom sim` refuses the whole run rather than answer a `water@`
# assertion approximately. A scene the demo's tests are run against gets the
# height-field tier; the beauty shot can have its own file.
[[node]]
name = "Water"
parent = "Rig"

  [node.components.WaterBody]
  kind = "ocean"
  simulation = "deterministic"
  surface_height = 0.0
  density = 1000.0
  drag = 2.0

# ---------------------------------------------------------------------------
# YOU
# ---------------------------------------------------------------------------

# Deck top is 1.40 and the capsule's origin is its centre, 0.90 above its feet,
# so 2.30 is standing. 2.40 is a 10 cm drop onto the deck on the first tick,
# which is how every character scene in this repository starts: it proves the
# floor is there rather than assuming it.
[[node]]
name = "Player"
parent = "Rig"
transform = { pos = [-4.30, 2.40, 0.90] }

  [node.components.CharacterController]
  height = 1.8
  radius = 0.35
  # **0.10, not the default 0.35, and this is the other half of the rail.**
  # `step_height` is what the controller will silently lift the capsule onto,
  # and it applies in mid-air: at the top of a hop the capsule's feet are
  # within a step of the rail cap, so the controller mounts it, walks the
  # 0.2 m cap and drops off the far side into the sea. Measured, on
  # `rig_walk` — the pilot crossed x = 11.50 at y = 3.61, rose to 3.75 over
  # the next eight ticks, and was at y = -970 by tick 900.
  #
  # Nothing on this rig is a stair, so the step buys nothing here and costs
  # that. **The boarding round will want it back** — the bulwark is a 0.22 m
  # rise from the wharf — and when it raises this number it has to re-check
  # the rail against the same sum: rail top must exceed the jump apex's foot
  # height plus this. Today that is 2.733 + 0.10 against a cap at 2.90.
  step_height = 0.25

  [node.components.Script]
  path = "../scripts/deeper_player.rhai"

[[node]]
name = "Eye"
parent = "Rig/Player"
transform = { pos = [0.0, 0.75, 0.0] }

  [node.components.Camera]
  fov_y_degrees = 75.0

# ---------------------------------------------------------------------------
# THE RIG
#
# A 24 x 14 m deck on six pilings, railed the whole way round. Every
# piece here is a `box` or a `cylinder` with a `MeshRenderer` and no collider:
# a renderable node with no dynamic ancestor becomes a static collider from its
# own drawn bounds, so what is walked on is exactly what is seen. That
# equivalence is the whole reason nothing here is an invisible ramp.
# ---------------------------------------------------------------------------

[[node]]
name = "Deck"
parent = "Rig"
transform = { pos = [0.0, 1.20, 0.0], scale = [12.0, 0.20, 7.0] }

