# The same pyre as `plume.loom`, from inside the marched hull's own reach.
#
# **Every other plume row frames the column from far enough back that its rim is
# a few pixels wide, and a rim is where this effect fails.** The soot volume's
# density is a noise field multiplied by an envelope, and the question a still
# has to be able to answer is *which of those two draws the outline*. At 13 m the
# answer is invisible: the outer third of the radius is one or two pixels. Here
# the camera is 5.5 m from a column whose envelope is 4.9 m across, tilted up so
# the boundary is read against sky over most of its height, and the rim is ~40 px
# of the frame.
#
# The failure this catches is a silhouette that stops being the field's. It
# shipped twice: as an upright ellipsoid the march clipped (834db0a), and then as
# `sootEnvelope`'s cone, because the envelope multiplied the density instead of
# raising its threshold, so the support ended exactly on an analytic surface. In
# both cases the boundary was a smooth monotone curve with a faint uniform wash
# inside it, and in both cases `plume`, `plume_gale` and `plume_roof` all matched
# their references. See `SMOKE_RIM` in `scene.slang`.
#
# Nothing else about the scene changes -- same wind, same low sun across the
# column, same wall. Only the camera, because only the camera was ever the
# problem.

[scene]
format = 1
id = "c4f81b37-2ae6-4d05-9f1c-6b0d38e7a512"

[[node]]
name = "Pyre"

  # A low sun across the shot, not behind the camera: a plume lit from the
  # front is a grey cone, and every photograph of smoke that reads as smoke is
  # lit from the side or from behind.
  [node.components.Environment]
  sun_direction = [-0.82, 0.26, -0.51]
  sun_strength = 1.6
  sun_color = [1.0, 0.82, 0.62]
  ambient = 0.30
  sky_zenith = [0.10, 0.16, 0.30]
  sky_horizon = [0.42, 0.40, 0.38]
  fog_density = 0.010
  fog_falloff = 0.05

  # Steady and moderate. The plume's lean is `wind.speed`, so a scene with no
  # wind draws a vertical column and this one draws one that leans.
  [node.components.Wind]
  direction_degrees = 65.0
  speed = 3.2
  gustiness = 0.6
  turbulence = 0.8

[[node]]
name = "Ground"
parent = "Pyre"
transform = { pos = [0.0, -0.25, 0.0], scale = [30.0, 0.25, 30.0] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

  [node.components.Material]
  albedo = [0.30, 0.27, 0.22]
  roughness = 0.95

# Something for the plume to be seen against at its own height, and for the
# low sun to throw a shadow from. A column against nothing but sky reads as a
# decal.
[[node]]
name = "Wall"
parent = "Pyre"
transform = { pos = [4.6, 1.6, -3.2], scale = [0.35, 1.6, 3.4] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

  [node.components.Material]
  albedo = [0.46, 0.42, 0.36]
  roughness = 0.9

[[node]]
name = "Log"
parent = "Pyre"
transform = { pos = [0.0, 0.16, 0.0], rot_euler = [0.0, 32.0, 0.0], scale = [0.75, 0.16, 0.16] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

  [node.components.Material]
  albedo = [0.18, 0.12, 0.09]
  roughness = 0.95

# The fire's light, which is also what lights the underside of the plume.
[[node]]
name = "Firelight"
parent = "Pyre"
transform = { pos = [0.0, 0.75, 0.0] }

  [node.components.Light]
  intensity = 5.0
  color = [1.0, 0.50, 0.17]

# The flame: ADR 0020's marched emission, unchanged.
[[node]]
name = "Flame"
parent = "Pyre"
transform = { pos = [0.0, 0.85, 0.0] }

  [node.components.ParticleEmitter]
  burst = 1
  rate = 0.0
  lifetime = 110.0
  lifetime_jitter = 0.0
  speed = 0.0
  spread_degrees = 0.0
  radius = 0.0
  gravity = 0.0
  drag = 0.0
  turbulence = 0.0
  wind_response = 0.0
  size = [1.7, 1.7]
  alpha = [1.0, 1.0]
  color_start = [1.0, 1.0, 1.0]
  color_end = [1.0, 1.0, 1.0]
  additive = true
  flame = true

# **The plume: `flame = true` with `additive = false`.**
#
# The same one-quad marched-volume machinery with the emission taken out — a
# field that absorbs and scatters instead of one that radiates.
#
# **Its node position is the plume's BASE, and it is parented to the flame at
# the origin, so the hand-over happens exactly where the fire is.** This used to
# be a centre typed at y = 5.5 while the flame's visible tip was at y = 1.3 —
# a metre of clear sky between the two, authored, with nothing in the file or in
# any gate connecting them. The author still controls the base (this node's
# position), the height (`size`), the soot albedo (`color_start`/`color_end`),
# the opacity (`alpha`) and the lean (the scene's shared `Wind`). The author can
# no longer control the centre, the width, or the silhouette.
#
# `color_start`/`color_end` are the soot's albedo and nothing else; the shading
# is the sun, the sky and the fire, integrated through the column.
[[node]]
name = "Plume"
parent = "Pyre/Flame"
transform = { pos = [0.0, 0.0, 0.0] }

  [node.components.ParticleEmitter]
  burst = 1
  rate = 0.0
  lifetime = 110.0
  lifetime_jitter = 0.0
  speed = 0.0
  spread_degrees = 0.0
  radius = 0.0
  gravity = 0.0
  drag = 0.0
  turbulence = 0.0
  wind_response = 0.0
  size = [8.0, 8.0]
  alpha = [1.0, 1.0]
  color_start = [0.30, 0.29, 0.28]
  color_end = [0.30, 0.29, 0.28]
  additive = false
  flame = true

[[node]]
name = "Camera"
parent = "Pyre"
transform = { pos = [0.4, 1.2, 5.5], rot_euler = [18.0, 0.0, 0.0] }

  [node.components.Camera]
  fov_y_degrees = 52.0
