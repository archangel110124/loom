# A stone spout pouring onto a tiled floor — reference image 60.
#
# **The thin end of the nappe, and the reason `Cascade` has one number that
# matters.** `discharge = 0.10` puts the break length at 1.31 m by
# `loom_water::nappe`, and the lip is 2.0 m above the pool — so the sheet is
# coherent for the first two thirds of the fall and opens into strings for the
# last third. That is exactly what the reference photograph shows and it is not
# authored anywhere: no threshold, no fade distance, no second emitter. Raise
# the discharge to 2.0 and the same scene draws `cascade.loom`'s unbroken white
# sheet, because `Z_b` moves to 9.7 m.
#
# **The floor is tiled for the same reason `pool.loom`'s bed is.** A nappe near
# its lip is nearly clear water — aeration is zero at Z = 0 by construction —
# and clear water over a flat colour shows nothing at all. Straight lines behind
# it are what make the refraction and the streaks legible.
#
# The pool is a centimetre deep so the fall lands on water rather than on stone:
# the sheet fades into whatever is behind it over the last 0.3 m, and a hard
# line across a dry floor is the tell that gave the whole effect away.

[scene]
format = 1
id = "5c1a70e8-9b34-4d62-a107-8f5e2d9c41b7"

[[asset]]
key = "box"
path = "box"

[[asset]]
key = "tiles_albedo"
id = "bbce2fd2-83d0-410b-87b8-9e4b62ea4a64"
path = "../textures/tiles_albedo.png"

[[asset]]
key = "tiles_normal"
id = "39180893-483f-46b7-b946-f252aca36f23"
path = "../textures/tiles_normal.png"

[[node]]
name = "Spout"

  [node.components.Environment]
  sun_direction = [0.42, 0.66, 0.62]
  sun_strength = 1.15
  sun_color = [1.0, 0.97, 0.92]
  ambient = 0.6
  sky_zenith = [0.16, 0.26, 0.44]
  sky_horizon = [0.60, 0.64, 0.66]
  fog_density = 0.002
  fog_falloff = 0.05

  # Still air. The nappe is not wind-driven and a breeze would only put a
  # spectrum on the pool, which is not what this scene is photographing.
  [node.components.Wind]
  direction_degrees = 0.0
  speed = 0.0
  gustiness = 0.0
  turbulence = 0.0

# The floor, as a voxel slab so the water has a bed depth at all — the same
# lesson `pool.loom`'s header records at length. Its top face lands on
# world y = -0.14. **Shallow on purpose.** A `WaterBody` is an infinite plane
# with no extent, so the pool this scene needs at the foot of the fall is also
# the water everywhere else in it — and at half a metre the caustic web on the
# tiles takes over the whole frame. Fourteen centimetres reads as a wet floor
# with standing water on it, which is what the reference photograph is.
[[node]]
name = "Floor"
parent = "Spout"
transform = { pos = [-16.0, -16.14, -16.0] }

  [node.components.VoxelVolume]
  voxel_size = 0.5
  chunks = [2, 1, 2]

  [[node.components.VoxelVolume.ops]]
  kind = "box"
  center = [16.0, 8.0, 16.0]
  half_extents = [14.0, 8.0, 14.0]
  mode = "union"

  [node.components.Material]
  albedo = [0.72, 0.68, 0.62]
  roughness = 0.7
  albedo_map = { asset = "tiles_albedo" }
  normal_map = { asset = "tiles_normal" }
  uv_scale = [2.0, 2.0]
  triplanar = true

[[node]]
name = "Water"
parent = "Spout"

  [node.components.WaterBody]
  kind = "lake"
  surface_height = 0.0
  density = 1000.0
  drag = 2.0

# The stone the water comes out of: a heavy block with a chute cut across its
# front face. Purely set dressing — the lip the nappe leaves is authored on the
# `Cascade` below and owes nothing to this geometry — but a waterfall arriving
# out of empty air is the other way to give the effect away.
[[node]]
name = "Block"
parent = "Spout"
transform = { pos = [0.0, 2.35, -0.75], scale = [1.6, 0.7, 0.9] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

  [node.components.Material]
  albedo = [0.30, 0.27, 0.24]
  roughness = 0.85

[[node]]
name = "Chute"
parent = "Spout"
transform = { pos = [0.0, 2.05, -0.28], scale = [1.3, 0.16, 0.6] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

  [node.components.Material]
  albedo = [0.20, 0.18, 0.16]
  roughness = 0.9

# The wall the spout comes out of. Without something solid behind the sheet the
# nappe is seen against the sky, where a nearly-clear top third has nothing to
# refract and the whole upper half of the effect is invisible.
[[node]]
name = "Wall"
parent = "Spout"
transform = { pos = [0.0, 1.4, -1.6], scale = [7.0, 4.0, 0.5] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

  [node.components.Material]
  albedo = [0.38, 0.35, 0.31]
  roughness = 0.9

# **The lip.** `lip_a` is at +X and `lip_b` at −X, which sends the water along
# `cross(lip_b − lip_a, +Y)` = +Z — toward the camera. Swap the two ends and it
# pours away from it.
[[node]]
name = "Fall"
parent = "Spout"
transform = { pos = [0.0, 2.0, 0.0] }

  [node.components.Cascade]
  lip_a = [0.55, 0.0, 0.0]
  lip_b = [-0.55, 0.0, 0.0]
  discharge = 0.10
  spread = 0.03
  breakup = 0.0075

# Face on and low, so the sheet is seen against the far floor rather than from
# above, and the stringy last third is between the camera and the tiles.
[[node]]
name = "Camera"
parent = "Spout"
transform = { pos = [0.0, 1.55, 3.6], rot_euler = [-11.0, 0.0, 0.0] }

  [node.components.Camera]
