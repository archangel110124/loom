# Rain falling on a bounded pool, seen from close to the water.
#
# **This is reference image 59's shot, and it exists because no other scene in
# the repository can hold it.** `squall` and `rain_impact` are landscapes with
# the camera seven metres up; at that distance a splash is a pixel and the
# question "did a drop hit the water or fall through it to the tiles" cannot be
# read off the frame. Here the eye is 0.75 m above the surface looking across a
# twelve-metre pool, which is how far a photograph of rain on water stands.
#
# **The rain and the water are the whole subject.** There is no terrain, no
# grass, no plume: what moves in this frame is drops falling, drops landing, and
# the rings they leave. That makes it the one reference where a regression in
# `rainWaterGap` — the water test in `rain_sim.slang` — shows up as something
# other than a rounding difference.
#
# The bed is tiled for `pool.loom`'s reason and for image 59's: a single-colour
# floor gives the refraction nothing to bend and a ring reads only as a
# specular wobble, while a grid gives it straight lines to distort. It is a
# voxel volume rather than a mesh box because the water's bed depth comes from
# the voxel height field and from nowhere else — a mesh bed reads as bottomless,
# which disables refraction, absorption and the whole depth-driven half of the
# water shader.
#
# **The sea is dead flat on purpose.** `waves` is empty, so every millimetre of
# structure on the surface is the rain's doing and nothing else's. `Wind` is
# small rather than zero: a vertical rain column reads as a screen effect, and
# a slight lean is what makes it weather. It is not enough to move the cloud
# deck visibly across a `--sim 300` run.

[scene]
format = 1
id = "5c9a10f2-7b64-4d3e-91af-2c8e6b70d415"

[[asset]]
key = "box"
path = "box"

[[asset]]
key = "tiles_albedo"
id = "bbce2fd2-83d0-410b-87b8-9e4b62ea4a64"
path = "../textures/tiles_albedo.png"

[[asset]]
key = "tiles_normal"
id = "39180893-483f-46b7-b946-f252aca36f23"
path = "../textures/tiles_normal.png"

[[node]]
name = "Pool"

  [node.components.Environment]
  # A pale overcast, which is what rain comes out of and what image 59 has
  # behind it. The sun is weak and high-ish so the water reads by its own
  # colour rather than by a glitter path, and a white splash has somewhere
  # dark to be white against.
  sun_direction = [0.24, 0.70, -0.67]
  sun_strength = 0.85
  sun_color = [1.0, 0.98, 0.95]
  ambient = 0.70
  sky_zenith = [0.42, 0.50, 0.60]
  sky_horizon = [0.78, 0.81, 0.84]
  fog_density = 0.004
  fog_falloff = 0.05
  # **Authored, so a solid deck is not filled in.** A raining scene that says
  # nothing about cover gets cover 1.0 everywhere, which is uniform rain; 0.85
  # is an overcast with a little structure in it, which is what puts a visible
  # variation in the density across a twelve-metre pool without any part of it
  # going dry.
  cloud_cover = 0.85
  cloud_scale = 90.0

  [node.components.Rain]
  # Heavy. The subject is impacts, and at 4 mm/h there are not enough of them
  # in one frame to read as a pattern on the surface.
  intensity = 20.0

  [node.components.Wind]
  direction_degrees = 200.0
  speed = 2.2
  gustiness = 0.4
  turbulence = 0.3

# The tiled bed, 1.2 m under the surface — the depth `pool.loom` argues for:
# shallow enough that the refraction has something to bend, deep enough that a
# drop's collision with the water is unambiguously not a collision with the
# floor. 24 m square at half-metre voxels.
[[node]]
name = "Bed"
parent = "Pool"
transform = { pos = [-16.0, -17.2, -16.0] }

  [node.components.VoxelVolume]
  voxel_size = 0.5
  chunks = [2, 1, 2]

  [[node.components.VoxelVolume.ops]]
  kind = "box"
  center = [16.0, 8.0, 16.0]
  half_extents = [12.0, 8.0, 12.0]
  mode = "union"

  [node.components.Material]
  albedo = [0.84, 0.84, 0.82]
  roughness = 0.8
  albedo_map = { asset = "tiles_albedo" }
  normal_map = { asset = "tiles_normal" }
  uv_scale = [2.0, 2.0]
  triplanar = true

[[node]]
name = "Water"
parent = "Pool"

  [node.components.WaterBody]
  kind = "lake"
  surface_height = 0.0
  density = 1000.0
  drag = 2.0

# Two posts standing in the water at different distances. They are the fixed
# reference a still needs — without something that does not move, a frame of a
# rained-on surface cannot be told from a frame of a differently-lit flat one —
# and they are also the only thing in the scene that can shelter a patch of it.
[[node]]
name = "Post"
parent = "Pool"
transform = { pos = [2.6, 0.5, -1.5], scale = [0.14, 1.5, 0.14] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

  [node.components.Material]
  albedo = [0.30, 0.27, 0.24]
  roughness = 0.9

[[node]]
name = "FarPost"
parent = "Pool"
transform = { pos = [-3.4, 0.4, -6.0], scale = [0.14, 1.3, 0.14] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

  [node.components.Material]
  albedo = [0.30, 0.27, 0.24]
  roughness = 0.9

# **Low and close, and that is load-bearing rather than style.** Every
# automatic framing tool in this repository — `cargo xtask shimmer`,
# `cargo xtask flythrough` — puts the camera at whole-scene bounds, which here
# is thirty metres back looking down at a blue rectangle. That is a frame with
# no subject in it, which is exactly how the grass phase spent two slices
# reporting a full pass over an absent feature.
[[node]]
name = "Camera"
parent = "Pool"
transform = { pos = [0.0, 2.3, 5.6], rot_euler = [-19.0, 0.0, 0.0] }

  [node.components.Camera]
  fov_y_degrees = 55.0
