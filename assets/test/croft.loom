# The lantern exports as two `o` groups and the scene picks the frame alone —
# the glass is a separate object and would arrive fused to it through glTF.
[[asset]]
key = "mesh_lantern"
id = "91a02be2-80b7-45fe-9f6d-fa337b8a8cad"
path = "../meshes/lantern.obj#WallLanternExterior001_Frame_Geo_LOD0"

[[asset]]
key = "lantern_albedo"
id = "bbfb6594-000d-4716-90c8-807f129ef4c7"
path = "../textures/lantern_albedo.png"

[[asset]]
