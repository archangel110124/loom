# Grass reading the terrain it stands on. P2's third exit criterion, in a still.
#
# Nothing here paints a mask. The scene says "voxel terrain" and "grass field",
# and where the blades end up is decided by the ground: bare on the steep face
# of the hill, ordinary on the flats, lusher in the hollow. The rules live in
# `loom_grass::coverage`; what this file adds is a shape that makes all three
# visible at once.
#
# ORDER MATTERS, as in `cave.loom` — the box lays the ground, the sphere raises
# the hill, and the last op scoops the hollow back out of the slab.

[scene]
format = 1
id = "b7f1c40e-2d95-4a83-8c16-5e07d9a2b431"

[[asset]]
key = "grass_ground_albedo"
id = "247fe03c-9304-4079-9a10-8159cea7db83"
path = "../textures/grass_ground_albedo.png"

[[asset]]
key = "grass_ground_normal"
id = "08873186-0a37-46a1-8fdc-8669cf03f6fb"
path = "../textures/grass_ground_normal.png"

[[node]]
name = "Slope"

  [node.components.Environment]
  sun_direction = [0.42, 0.5, 0.66]
  sun_strength = 1.35
  sun_color = [1.0, 0.96, 0.85]
  ambient = 0.42
  sky_zenith = [0.18, 0.32, 0.52]
  sky_horizon = [0.62, 0.68, 0.70]
  fog_density = 0.006
  fog_falloff = 0.05

  [node.components.Wind]
  direction_degrees = 20.0
  speed = 5.0
  gustiness = 1.2
  turbulence = 0.9

[[node]]
name = "Ground"
parent = "Slope"

  # 32 m across and 24 m tall, in volume-local coordinates. The grass field
  # below is centred on [16, 0, 16] so the two line up.
  [node.components.VoxelVolume]
  voxel_size = 0.25
  chunks = [4, 3, 4]

  # The slab everything sits on. Its top is y = 6.
  [[node.components.VoxelVolume.ops]]
  kind = "box"
  center = [16.0, 3.0, 16.0]
  half_extents = [14.0, 3.0, 14.0]
  mode = "union"

  # The hill. A sphere is the honest test: its flanks pass through every angle
  # from flat to vertical, so the grass has to fade out somewhere rather than
  # answering a yes/no question. The band where it stops is the slope cutoff,
  # drawn by the terrain rather than by a mask.
  [[node.components.VoxelVolume.ops]]
  kind = "sphere"
  center = [9.0, 3.5, 16.0]
  radius = 6.5
  mode = "union"

  # The hollow, scooped out of the flats: a big sphere dipped 1.5 m into the
  # slab, which leaves a basin about 8 m across with gentle walls. Deliberately
  # wide and shallow rather than a tight pit — a pit's walls are steep, and then
  # the slope term zeroes the grass on exactly the ring where the flow term is
  # trying to show. Nothing here is steeper than 30°, so what changes inside the
  # basin is the flow term alone.
  [[node.components.VoxelVolume.ops]]
  kind = "sphere"
  center = [19.5, 11.0, 22.0]
  radius = 6.5
  mode = "subtract"

  # Dark green, not brown — the same rule `meadow.loom` states. Grass thins with
  # distance and on slopes, and the ground it thins into has to already look
  # like a meadow floor or the thinning reads as bare dirt.
  #
  # **This is the scene where that rule stops being enough.** The dome's flank
  # is past `slope_cutoff`, so it carries no blades at all by construction, and
  # a flat colour there is a smooth green shell — the synthetic tell the
  # wandering slope threshold was added to break. Patchy turf gives the bare
  # band something to be, and it is the surface a viewer looks straight at.
  #
  # The albedo stops being the meadow's colour once a map carries that, and
  # becomes a darkening multiplier that keeps the ground under the blades
  # rather than competing with them.
  #
  # `uv_scale = 0.35` is one tile per ~2.9 m, which is about what this texture
  # photographs; against a 4096 map that is 1434 texels/m, past the ~400/m a
  # near field can show. Triplanar because this is terrain and there are no
  # sensible UVs on a marching-cubes surface at all.
  [node.components.Material]
  albedo = [0.60, 0.66, 0.56]
  roughness = 1.0
  albedo_map = { asset = "grass_ground_albedo" }
  normal_map = { asset = "grass_ground_normal" }
  uv_scale = [0.35, 0.35]
  triplanar = true

[[node]]
name = "Field"
parent = "Slope"
transform = { pos = [16.0, 0.0, 16.0] }

  # Covers the whole slab. Every blade's Y comes from the SDF under it, so the
  # field drapes over the hill instead of cutting through it.
  [node.components.Grass]
  half_extent = [13.0, 13.0]
  density = 140.0
  height = 0.40
  # The 0.7 default, deliberately: about 45°, which puts the bare band across
  # the widest part of the dome's flank where it is easiest to see and to
  # regression-test. What keeps that band from reading as a shaved ring is the
  # break-up in `loom_grass::coverage`, not a gentler threshold here.
  width = 0.020
  clump_facing = 0.75
  clump_colour = 0.4

  [node.components.Material]
  albedo = [0.29, 0.44, 0.14]
  roughness = 0.75

# Close, and high enough to see into the basin. Blades fade out between 8 m and
# 55 m — the density falloff in `scene.slang` — so a shot framed from far enough
# to see the whole slab shows the falloff rather than the terrain response, and
# the first attempt at this camera did exactly that. Everything worth looking at
# is inside 20 m of this eye.
[[node]]
name = "Camera"
parent = "Slope"
transform = { pos = [28.0, 11.0, 30.0], rot_euler = [-19.0, 45.0, 0.0] }

  [node.components.Camera]
  fov_y_degrees = 52.0
