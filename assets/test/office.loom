# M1 round-trip fixture. This file is in CANONICAL form (docs/format/README.md §2):
# reading and re-writing it must produce these exact bytes.
#
# These comments are part of the test. The write path preserves them.
#
# DeskLamp used to be a prefab instance with `[node.overrides]` (§5). Nothing
# implements §5, and the parser did not know those words, so the lamp had no
# components at all: it drew nothing, lit nothing, and this file still
# validated. The override values are written directly until prefabs exist.

[scene]
format = 1
id = "0f9c1a3e-4b2d-4c1a-9e7f-8a1b2c3d4e5f"

[[asset]]
key = "office_desk"
id = "a41f0c2e-1b3d-4e5f-8a90-0c1d2e3f4a59"
path = "assets/props/desk.glb"

[[node]]
name = "Office"

[[node]]
name = "Desk"
parent = "Office"
transform = { pos = [0.0, 0.0, -2.5], rot_euler = [0.0, 90.0, 0.0] }

  [node.components.MeshRenderer]
  mesh = { asset = "office_desk" }

  [node.components.BoxCollider]
  half_extents = [0.8, 0.37, 0.4]

[[node]]
name = "DeskLamp"
parent = "Office/Desk"
transform = { pos = [0.55, 0.74, 0.1] }

  # Warmer and dimmer than the ceiling light. **2.5, and it was 420** — a lamp
  # 0.74 m over the desk is fully lit at `0.74^2 / 0.5` = 1.1, so this is a
  # bright local pool and falls to a quarter of it by 1.5 m away, which is what
  # a desk lamp does.
  [node.components.Light]
  intensity = 2.5
  color = [1.0, 0.92, 0.78]

[[node]]
name = "CeilingLight"
parent = "Office"
transform = { pos = [0.0, 2.8, 0.0] }

  # **20, and it was 800.** A 2.8 m ceiling over albedo ~0.5 is fully lit at
  # 15.7. At 800, 27% of this scene's pixels were clipping — the worst in the
  # library — and it looked deliberate, because everything above the ceiling
  # collapses to the same white whatever the excess is.
  [node.components.Light]
  intensity = 20.0
  color = [1.0, 0.98, 0.94]
