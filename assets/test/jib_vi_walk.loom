# Walking the whole boat.
#
# **One capsule and nothing else aboard, which took two goes to get right.** The
# first version of this file also carried the twelve standing stations that are
# now in `jib_vi_stations.loom`, and one of them was parked on the route: two
# 0.35 m capsules stop 0.70 m apart, and the walker halted there and stayed for
# three thousand ticks. A side deck 1.20 m clear does not fit two people abreast,
# so a scene that measures a traverse must not also contain furniture. Same rule
# as drift and traverse being separate — two tools measured as one is not a
# measurement.
#
# **Wind is zero, deliberately.** The route is a list of world-space waypoints,
# because a script is handed its world position and cannot see the boat's frame
# (giving it one would mean handing sandboxed code a borrow of the transform
# hierarchy). On flat water this hull sits within millimetres of where it
# started, so world and boat frame are the same thing to a waypoint. Every
# assertion still reads `local_*`, which is exact either way.
#
# The route, in `boat_patrol.rhai`: aft cockpit, up the starboard side deck,
# round the foredeck to the stem, back down the port side, round the forward end
# of the companionway, aft to its foot, and up it to the bridge deck. It is a
# route a person could not take on the mesh alone — the drawn ladder is 68
# degrees with an 0.08 m tread — which is why there is a plank there.
#
#   loom sim assets/test/jib_vi_walk.loom --ticks 440 \
#     --assert "Sea/Boat/Walker.local_x >= 6.0" \
#     --assert "Sea/Boat/Walker.local_y > 0.45" \
#     --assert "Sea/Boat/Walker.local_z < 3.10"      # at the stem
#
#   loom sim assets/test/jib_vi_walk.loom --ticks 1700 \
#     --assert "Sea/Boat/Walker.local_y >= 3.9" \
#     --assert "Sea/Boat/Walker.local_x >= 3.0" \
#     --assert "Sea/Boat/Walker.local_z < 3.10"      # on the bridge deck
#
# `local_y > 0.45` at every milestone is "never fell through", and it is there
# because a swimmer must not be able to satisfy the endpoint. `local_z < 3.10`
# is "never went outboard"; the walk's own maximum is 2.10.
#
# **Where it gets to, measured.** Peak `local_x` is 6.717 at tick 440, which is
# the stem — the stem block stops the capsule at 7.75 and the waypoint is 7.30.
# It is on the companionway at tick 1100 (`local_y` 2.413, mid-climb), on the
# bridge deck by 1300 (4.049 = the 3.08 deck plus the capsule's 0.95 plus 0.02
# of skin), and settled at its last waypoint from about 1650 on.

[scene]
format = 1
id = "d80fe5a3-1c47-4b62-a9f0-51e6c7d29a84"

[[asset]]
key = "hull_white"
path = "../meshes/jib_vi_hull_white.obj"

[[asset]]
key = "navy"
path = "../meshes/jib_vi_navy.obj"

[[asset]]
