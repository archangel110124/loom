# **The view from under the surface, and the only scene in this repository
# that has one.**
#
# `assets/test/ocean_tropical.loom` is this scene with the lens 1.1 m *above*
# the water; every line below except the camera is copied from it, so the two
# frames are the same sea, the same shelf and the same Jerlov III optics seen
# from either side of one surface. That is the point: what the water is made of
# has to reach the picture the same way from both.
#
# **Why it exists.** `eyeUnderwater()` has been a branch in `scene.slang` since
# W4, and until this file landed nothing in `SCENES` ever took it — so the
# underwater medium could paint itself from two hardcoded constants for as long
# as it liked and every gate reported a full pass. An absent feature is the one
# failure class no gate here can see, and a submerged camera was absent.
#
# **In `SCENES` and deliberately not in `GOLDEN`.** A reference image is the
# human's to bless.
#
# # What to look for
#
# Red goes first. The white carbonate shelf is 5 m down and about 10 m away
# along the slant, and at Jerlov III's `K_d` of 0.3828/m in red against
# 0.0719/m in blue, 2% of the red survives that crossing against 49% of the
# blue. Sand that reads neutral grey here means the medium is attenuating all
# three channels at one rate, which is what it used to do.
#
[scene]
format = 1
id = "3f7c1a90-6d24-4b18-9e52-c0a48b1d7e63"

[[node]]
name = "Sea"

  # **A hazy tropical noon.** The sun is high and on the far side of the water
  # the camera looks at, which is the geometry `scene.slang`'s subsurface term
  # needs: a wave face between the sun and the lens is a thin sheet with the
  # light behind it.
  #
  # The sky is deliberately washed out and the fog is an order of magnitude up
  # on the storm scenes, because the horizon in the reference is haze rather
  # than a line — and because it is what hides the far edge of the shelf below.
  [node.components.Environment]
  sun_direction = [0.18, 0.62, -0.76]
  sun_strength = 1.45
  sun_color = [1.0, 0.97, 0.92]
  ambient = 0.62
  sky_zenith = [0.30, 0.48, 0.72]
  sky_horizon = [0.82, 0.86, 0.88]
  fog_density = 0.016
  fog_falloff = 0.05

  # Beaufort 4. See the header: 6.6 free-stream is U10 5.995 at this drag.
  [node.components.Wind]
  direction_degrees = 200.0
  speed = 6.6
  gustiness = 0.7
  turbulence = 0.6
  ground_drag = 0.45

# **The carbonate shelf: white sand, five metres down, 160 m square.**
#
# One box op at a coarse voxel, because a flat bed is all this needs and the
# cost is cubic in the resolution. The volume's near corner is its node, so this
# spans x −80..80 and z −110..50 — the camera stands at z = 14 and looks toward
# −Z, so there are 124 m of shelf in front of it.
#
# **Its far edge is a discontinuity and the fog is what hides it.** Depth goes
# from 5 m to bottomless in one cell there, which is a visible line in the water
# if you can see it; at `fog_density = 0.016` the edge is 86% fogged out. That
# is the same trap `shore.loom`'s header names — anything reading depth has to
# be saturated, or fogged, by the time the grid runs out.
#
# **Five metres and not three.** At three the caustic web is the loudest thing
# in frame and the water reads as a swimming pool; at five the column has
# absorbed enough red for the bed to arrive as colour rather than as pattern.
[[node]]
name = "Shelf"
parent = "Sea"
transform = { pos = [-80.0, -24.0, -110.0] }

  [node.components.VoxelVolume]
  voxel_size = 1.0
  chunks = [5, 1, 5]

  [[node.components.VoxelVolume.ops]]
  kind = "box"
  center = [80.0, 9.0, 80.0]
  half_extents = [82.0, 10.0, 82.0]
  mode = "union"

  # Carbonate sand. Bright and nearly neutral — the hue in the frame is the
  # water's, and a yellow bed would put it there instead.
  [node.components.Material]
  albedo = [0.74, 0.71, 0.62]
  roughness = 0.92

[[node]]
name = "Water"
parent = "Sea"

  # No `waves` table: the spectrum builds the whole surface, and authoring a
  # wave list beside it is refused at load rather than silently dropped.
  #
  # `attenuation_depth` stays at its default zero, so nothing shoals over the
  # shelf. A 5 m bed under a 0.9 m sea is deep enough that shoaling would be a
  # few percent, and turning it on would be a second thing this scene is
  # demonstrating.
  [node.components.WaterBody]
  kind = "ocean"
  wave_model = "spectrum"
  surface_height = 0.0
  density = 1025.0
  drag = 2.0

    # **Jerlov III, and it is a row of a published table rather than a colour
    # somebody liked.** `WaterOptics`'s documentation carries the whole table,
    # its sources and its derivation; this row is `K_d` and `b_b` for the most
    # turbid of the open-ocean types.
    #
    # **What it does, exactly.** `R∞ = 0.33·b_b/(K_d + b_b)` stays derived in
    # the shader — there is no way to author a colour here — and these two move
    # it from (0.00034, 0.00421, 0.03915) to (0.01150, 0.05609, 0.08991):
    # **green-to-blue 0.108 -> 0.624**, well past the 0.42 where navy becomes
    # teal, and thirteen times as much green coming back out of the column.
    #
    # **Why the most turbid oceanic type rather than a clear tropical one.**
    # See the header: teal over *deep* water is a scattering water, and the
    # clear tropics over an abyss are navy. Over this shelf the two coefficient
    # sets do different jobs — `attenuation` is what the bed is seen through
    # and `backscatter` is the colour of the column itself — and it is Jerlov
    # III's backscatter that turns the pure-water cyan into turquoise.
    #
    # **Attenuation barely moves and that is the point of authoring `K_d`.**
    # Red is 0.341 -> 0.383, so this sea still loses its red in three metres
    # and still goes dark past the shelf. The *beam* coefficient for the same
    # water is 1.42 per metre in blue — fifteen times this — and authoring that
    # here would make the sea black.
    [node.components.WaterBody.optics]
    attenuation = [0.3828, 0.0911, 0.0719]
    backscatter = [0.01382, 0.01866, 0.02694]

# **The lens 1.5 m under still water in a sea whose crests reach 0.9**, so the
# surface is comfortably overhead at every wave phase and the flag never
# flickers between frames of a `--frames` run.
#
# Pitched down 3 degrees, as above the water: the shelf fills the lower half
# and the ceiling — Snell's window, the mirror outside it, the caustic web on
# the underside — fills the upper. Both halves of the underwater branch are in
# one frame, which is what makes this one scene rather than two.
[[node]]
name = "Camera"
parent = "Sea"
transform = { pos = [0.0, -1.5, 14.0], rot_euler = [-3.0, 0.0, 0.0] }

  [node.components.Camera]
  fov_y_degrees = 58.0
