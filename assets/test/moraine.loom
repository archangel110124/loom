[[asset]]
key = "lantern_normal"
id = "f4ebd6c8-9075-40c1-df41-5e6f7a8b9ca4"
path = "../textures/lantern_normal.png"

[[node]]
name = "Moraine"

  # **A low sun across the vale rather than down it**, 18.7 degrees up and 95
  # degrees off the trough's axis, so the west flank is lit and the east flank
  # is not and the landform is read from that difference. There are no shadows
  # in this engine yet (Phase 8), so `n . l` is the *entire* channel a
  # landscape has, and a sun overhead has nothing to say about a 24 m trough.
  #
  # **It was turned 8 degrees toward the camera against a render.** Fully
  # cross-lit, the shed's front face — the one with the door and the lantern on
  # it — was exactly anti-lit and read as a flat black rectangle. At
  # `[0.78, 0.32, -0.54]` that face takes `n . l = 0.13`: a grazing light that
  # shows the stone without turning the vale into the flat frontal lighting a
  # sun behind the camera would give.
  [node.components.Environment]
  sun_direction = [0.78, 0.32, -0.54]
  sun_color = [1.0, 0.95, 0.86]
  sun_strength = 1.9
  ambient = 0.34
  sky_zenith = [0.16, 0.30, 0.52]
  sky_horizon = [0.62, 0.68, 0.72]
  # Aerial perspective, and at 256 m it is doing structural work rather than
  # atmosphere: the far ridgeline is 200 m out, and without haze it reads at the
  # same contrast as the pad 20 m away and the depth collapses.
  fog_density = 0.0035
  fog_falloff = 0.03

  # Grass is the only thing in this scene the wind reaches — no particles, no
  # water. Modest, because a landscape still is judged on shape and a gale
  # bends every blade the same way.
  [node.components.Wind]
  direction_degrees = 115.0
  speed = 4.5
  gustiness = 1.1
  turbulence = 0.8

[[node]]
name = "Ground"
parent = "Moraine"

  # 256 x 64 x 256 m at half-metre voxels: 1024 chunks, the largest volume in
  # the library after `terrain_stress`. 64 m of height is not decoration — the
  # recipe's range is 42 m and `base_y` lifts it 8, so the summits land near 50
  # and the ceiling is headroom rather than a clip. A `height_range` taller
  # than the volume shaves every summit flat, which reads as a mesa.
  [node.components.VoxelVolume]
  voxel_size = 0.5
  chunks = [16, 4, 16]

  # 1. THE LANDFORM. One op, and the whole 2D pipeline behind it: warped fBm,
  #    ridged crests, a 50 m spline-carved trough, a flattened pad, hydraulic
  #    gullies, 34-degree talus, and a corridor whose walkability is a
  #    guarantee rather than a hope.
  #
  #    `rect` places the map, it does not rescale it — it must be the size the
  #    recipe's own `world_scale` claims, and `resolve` refuses it with both
  #    numbers rather than rendering a plausible landscape at the wrong scale.
  #
  #    `base_y = 8.0` because the carve takes the trough floor to -6.8 m in
  #    recipe space and a volume starts at y = 0.
  [[node.components.VoxelVolume.ops]]
  kind = "terrain"
  recipe = "moraine.toml"
  rect = [0.0, 0.0, 256.0, 256.0]
  base_y = 8.0
  mode = "union"

  # 2. THE 3D HALF. A height is one value per column, so it has no overhang, no
  #    undercut and no cave, ever. Everything from here to the erratics is what
  #    that costs to fix, and it is four lines an op.

  # The crag on the shoulder: one displaced, elongated sphere. `elongate`
  # slides the sample point instead of scaling it, so it is still an exact
  # distance field — 26 x 16 x 21 m of fractured bluff from one primitive.
  #
  # **The displacement numbers are the calibrated ones**: amplitude 0.20R makes
  # it lopsided rather than dimpled, frequency 0.6/R puts the coarsest feature
  # at about 1.7 radii, and 3 octaves is the cap `floor(log2(2A/voxel)) + 1`
  # allows — past it an octave's amplitude is under half a voxel and cannot
  # place a vertex the octave above did not.
  [[node.components.VoxelVolume.ops]]
  kind = "sphere"
  center = [58.0, 31.3, 140.0]
  radius = 8.0
  elongate = [5.0, 0.0, 2.5]
  mode = "union"
  displace = { amplitude = 1.6, frequency = 0.075, octaves = 3, seed = 4417, ridged = true }

  # The arch bored through it, on the camera's axis so the far side shows
  # through the hole.
  #
  # **Both ends must clear the crag's own extent, and the first version did
  # not.** `elongate` makes the mass reach `140 +/- (8 + 2.5)` in Z, and a
  # capsule from z = 132 to 148 with r = 2.8 ends 2.7 m *inside* that — it
  # grazed the tip and produced a shallow bite rather than a tunnel, which in a
  # still is indistinguishable from a shadow. Running it 126 to 154 puts both
  # mouths in open hillside and the hole reads as an arch.
  #
  # The floor tracks the ground it passes over, which is knowable because a
  # recipe is a queryable array rather than a noise call: 26.2 against ground
  # 26.65 at the north mouth (a cutting into the slope), 30.8 against 30.7 at
  # the south, and about 5 m of rock over the crown in between.
  [[node.components.VoxelVolume.ops]]
  kind = "capsule"
  a = [58.0, 29.2, 126.0]
  b = [58.0, 33.6, 154.0]
  radius = 3.0
  mode = "subtract"

  # The undercut in the crag's west flank — the overhang no height can carry,
  # and the one shape in this scene that is impossible in the 2D pipeline
  # rather than merely awkward.
  [[node.components.VoxelVolume.ops]]
  kind = "sphere"
  center = [50.5, 30.5, 138.0]
  radius = 4.2
  mode = "subtract"

  # 3. THE BUILT THING, off the axis at last, on the pad the recipe flattened.
  #    At 0.5 m voxels a wall must be >= 1.0 m: surface nets needs two voxels
  #    across a sheet or the sheet vanishes. Walls here are 1.0 m and the roof
  #    is 1.0 m; the floor is the ground, because the inner box's underside is
  #    below it.
  #
  #    `round = 0.35` is a shade under one voxel, and `half_extents` still
  #    means the outer extent — the fillet is taken out of the slab rather than
  #    added to it.
  [[node.components.VoxelVolume.ops]]
  kind = "box"
  center = [68.0, 26.8, 130.0]
  half_extents = [7.0, 3.0, 5.0]
  yaw_degrees = 27.0
  round = 0.35
  mode = "union"

  [[node.components.VoxelVolume.ops]]
  kind = "box"
  center = [68.0, 26.4, 130.0]
  half_extents = [6.0, 2.4, 4.0]
  yaw_degrees = 27.0
  mode = "subtract"

  # The doorway, cut LAST so there are walls to cut it from — order matters in
  # this list exactly as it does in `cave.loom` and `homestead.loom`. Its local
  # Z half-extent is 1.2 m against a 1.0 m wall, so it punches through instead
  # of leaving a membrane a voxel thick.
  [[node.components.VoxelVolume.ops]]
  kind = "box"
  center = [65.73, 26.8, 125.55]
  half_extents = [0.9, 1.15, 1.2]
  yaw_degrees = 27.0
  mode = "subtract"

  # The seat for the big erratic. **The seam where a mesh boulder meets voxel
  # ground is real and no material work hides it under a low sun**; the fix the
  # research names is to sit the rock in a dish the terrain itself carves, so
  # the contact line is a shadowed hollow rather than a straight intersection.
  #
  # Centre 3.25 m above the ground with r = 4.0 leaves a hollow 0.75 m deep and
  # 4.8 m across. **Centred below the ground instead it is a crater** — see the
  # arithmetic in the header; the first attempt dug seven metres.
  [[node.components.VoxelVolume.ops]]
  kind = "sphere"
  center = [59.0, 29.90, 106.0]
  radius = 4.0
  mode = "subtract"

  # **Soil is the base and rock is the layer**, which is the way round every
  # scene but `lanternhead`: `groundLayerWeight` is a slope rule, so dead-flat
  # ground always gets the base. Flats are meadow, steep faces are the bedrock
  # under them — which is exactly where the thermal pass left 34-degree talus.
  [node.components.Material]
  albedo = [0.58, 0.64, 0.52]
  roughness = 1.0
  albedo_map = { asset = "grass_ground_albedo" }
  normal_map = { asset = "grass_ground_normal" }
  uv_scale = [0.35, 0.35]
  triplanar = true

  [node.components.Material.layer]
  albedo = [0.56, 0.55, 0.52]
  roughness = 0.88
  porosity = 0.15
  uv_scale = [2.2, 2.2]
  slope = 0.50
  albedo_map = { asset = "ground_rock_albedo" }
  normal_map = { asset = "ground_rock_normal" }

# --------------------------------------------------------------------------
# 4. THE ERRATICS. Imported meshes, sunk ~0.3 m so the contact line is under
#    the surface: the heightmap is quantised to 1 m/pixel and surface nets
#    rounds the voxel surface by up to a quarter of a voxel, so a prop placed
#    at exactly its probed height stands on a visible gap about as often as not.
#
#    **They are 8 to 25 m from the eye, and that was the second placement.**
#    The first put them on the pad beside the shed at 25 to 40 m, where a 1.5 m
#    boulder is 25 px of a 640-wide frame and the ridge in front hid three of
#    the five outright. A prop at landscape range is not scenery, it is noise;
#    what a prop is for is the near field, where it gives the frame a scale to
#    read the 200 m ridgeline against. Two are scaled up (1.4x, 1.6x) because a
#    glacial erratic that reads as an erratic is bigger than a downloaded rock.
# --------------------------------------------------------------------------

[[node]]
name = "ErraticBeach"
parent = "Moraine"
transform = { pos = [59.0, 25.90, 106.0], rot_euler = [0.0, 34.0, 0.0] }

  [node.components.MeshRenderer]
  mesh = { asset = "mesh_rock_beach" }

  [node.components.Material]
  albedo = [1.0, 1.0, 1.0]
  roughness = 0.88
  albedo_map = { asset = "rock_beach_albedo" }
  normal_map = { asset = "rock_beach_normal" }
  uv_scale = [1.0, 1.0]

[[node]]
name = "ErraticA"
parent = "Moraine"
transform = { pos = [64.0, 24.10, 112.0], rot_euler = [0.0, -62.0, 0.0], scale = [1.6, 1.6, 1.6] }

  [node.components.MeshRenderer]
  mesh = { asset = "mesh_boulder_a" }

  [node.components.Material]
  albedo = [1.0, 1.0, 1.0]
  roughness = 0.9
  albedo_map = { asset = "boulder_a_albedo" }
  normal_map = { asset = "boulder_a_normal" }
  uv_scale = [1.0, 1.0]

[[node]]
name = "ErraticB"
parent = "Moraine"
transform = { pos = [58.0, 26.16, 109.0], rot_euler = [0.0, 118.0, 0.0], scale = [1.4, 1.4, 1.4] }

  [node.components.MeshRenderer]
  mesh = { asset = "mesh_boulder_b" }

  # **B's own atlas.** Using A's smears it — the islands are laid out per model.
  [node.components.Material]
  albedo = [1.0, 1.0, 1.0]
  roughness = 0.9
  albedo_map = { asset = "boulder_b_albedo" }
  normal_map = { asset = "boulder_b_normal" }
  uv_scale = [1.0, 1.0]

[[node]]
name = "Driftwood"
parent = "Moraine"
transform = { pos = [62.0, 25.27, 110.0], rot_euler = [0.0, -24.0, 0.0] }

  [node.components.MeshRenderer]
  mesh = { asset = "mesh_tree_log" }

  [node.components.Material]
  albedo = [1.0, 1.0, 1.0]
  roughness = 0.82
  albedo_map = { asset = "tree_log_albedo" }
  normal_map = { asset = "tree_log_normal" }
  uv_scale = [1.0, 1.0]

[[node]]
name = "Stump"
parent = "Moraine"
transform = { pos = [66.0, 25.65, 118.0], rot_euler = [0.0, 71.0, 0.0] }

  [node.components.MeshRenderer]
  mesh = { asset = "mesh_tree_stump" }

  [node.components.Material]
  albedo = [1.0, 1.0, 1.0]
  roughness = 0.85
  albedo_map = { asset = "tree_stump_albedo" }
  normal_map = { asset = "tree_stump_normal" }
  uv_scale = [1.0, 1.0]

# The lantern beside the doorway. **It is a wall lantern** — a bracket and a
# lamp with no base — so it is mounted against the shed's face, yawed 27 + 180
# degrees so the lamp hangs out from the wall rather than into it.
[[node]]
name = "Lantern"
parent = "Moraine"
transform = { pos = [67.31, 28.10, 124.68], rot_euler = [0.0, -153.0, 0.0], scale = [2.0, 2.0, 2.0] }

  [node.components.MeshRenderer]
  mesh = { asset = "mesh_lantern" }

  [node.components.Material]
  albedo = [1.0, 1.0, 1.0]
  roughness = 0.45
  albedo_map = { asset = "lantern_albedo" }
  normal_map = { asset = "lantern_normal" }
  uv_scale = [1.0, 1.0]

# `d^2 / albedo`: a wall 1.7 m away at albedo 0.5 is fully lit at 6.0. In broad
# daylight that is a warm fill in the doorway and on the stone under the lamp
# and nothing at ten metres, which is what a lantern at noon actually does. The
# 100-800 of the older scenes would put a white disc on the wall.
[[node]]
name = "LanternFlame"
parent = "Moraine"
transform = { pos = [66.9, 27.95, 124.1] }

  [node.components.Light]
  intensity = 6.0
  color = [1.0, 0.72, 0.36]

# --------------------------------------------------------------------------
# 5. GRASS. Nothing paints a mask: coverage is slope, rock and gully flow read
#    off the terrain through `GroundGrid`'s SDF march, so the field thins on
#    the bank into the trough, stops on the crag, and is lush in the hollows.
#    The rectangle only says where to look.
#
#    **The rectangle also covers the shed, and the shed therefore has a turf
#    roof.** `GroundGrid` marches down to the first surface it finds, and the
#    first surface over the pad is the roof — the field has no idea a building
#    is there. Here it is welcome and it is why the shed's top edge is a green
#    line rather than a slab; over a scene's rooftops it would be a bug, and
#    the fix is the rectangle, because there is no mask.
#
#    **Extent x density is capped at 262,144 blades** and the engine warns and
#    drops the overflow in generation order — a hard edge across the field, not
#    a thinner one. 40 x 40 m at 90 lands under it with room.
# --------------------------------------------------------------------------

[[node]]
name = "ShoulderMeadow"
parent = "Moraine"
transform = { pos = [62.0, 0.0, 118.0] }

  [node.components.Grass]
  half_extent = [20.0, 20.0]
  density = 90.0
  height = 0.42
  width = 0.020
  # Equal to `Material.layer.slope` above, and they must stay equal.
  slope_cutoff = 0.50
  clump_facing = 0.75
  clump_colour = 0.4

  [node.components.Material]
  albedo = [0.29, 0.44, 0.14]
  roughness = 0.75

# On the shoulder north of the pad, 4.5 m above the ground: erratics in the
# near field, the shed and the arch across the middle, and the trough opening
# away to the left into 200 m of haze.
#
# **Authored, and it has to be.** `xtask shimmer` and `xtask flythrough` frame
# whole-scene bounds, which for 256 m puts the eye hundreds of metres out, and
# this scene's haze is authored for a 200 m ridgeline. Rendered from the orbit
# it is a blank blue rectangle — checked rather than assumed
# (`loom render --yaw 20 --pitch -55`). A landscape has to say where it is
# looked at from.
#
# **Screen right is *decreasing* bearing**, which is worth writing down because
# three of the compositions above were aimed at the wrong half of the frame.
# Forward is `(-sin yaw, -cos yaw)` — so `rot_euler.y = bearing - 180` — but
# the camera's right is `forward x up`, so a thing further clockwise in world
# bearing appears further LEFT on screen. The trough at bearing 50 degrees is
# on the left; the crag at -3 is on the right.
[[node]]
name = "Camera"
parent = "Moraine"
transform = { pos = [60.0, 31.0, 96.0], rot_euler = [-12.0, -165.0, 0.0] }

  [node.components.Camera]
  fov_y_degrees = 55.0
