# The nineteen-metre boat, under way — the first thing in this repository that
# drives a floating hull.
#
# Everything about the boat comes from `../prefabs/jib_vi.loom`: the sixteen
# pontoons solved from her section curve, the 57,636 kg that is her measured
# displacement at the designed waterline. Nothing about the hull is authored
# here. What is authored here is one thrust.
#
# **This is the scene the shed bug was invisible without.** `swept_volume` took
# a *waterplane* radius — 8.8145 m for this hull — and squared it, so the first
# tick this boat moved it emitted `pi r^2 U dt` = 97.63 m^3 of displaced water
# per packet at 6 m/s, scaled by the submerged fraction to **65.12 m^3**,
# against a hull that displaced 43.78 m^3 in total — the figures are the ones
# of the day, before `mass` and the pontoons were corrected. Sampled at the
# twelve pontoons she then had, that is 5.56 m of trench at 6 m/s and 7.70 m
# at 8 m/s. Nothing had
# ever moved a floating body, so nothing had ever fired it. See ADR 0063 and
# `loom_water::wavelet::a_hull_does_not_dig_a_hole_under_itself`.
#
# **1.9 MN is not a boat engine and the number is honest about why.** Damping
# in `loom_water::buoyancy` is `displaced * (damp_quadratic * v|v| +
# damp_linear * v)`, applied to all three axes with one coefficient. On this
# hull `displaced` is 57,636 kg with `damp_linear` 4.0 per second and
# `damp_quadratic` 1.0, so the water resists surge as hard as it resists
# heave — 57,636 * (v^2 + 4v) newtons, which is **288 kN at one metre a
# second**, as much resistance fore-and-aft as in heave. That is right for
# heave, which is what those numbers were chosen for (`jib_vi_float.loom`'s
# header: an analytic wave field has no dissipation of its own, so an undamped
# pontoon gains amplitude every wave until the boat launches), and wrong for
# surge, where a real hull of this size slips through the water an order of
# magnitude more easily. A pontoon model has no hull
# form, so its resistance is a sphere's; a hull whose resistance knew which way
# it was pointing is a change to the force path and its own ADR. This scene
# pays the honest price instead of hiding it.
#
# **Measured, this build**, from a standing start at x = -34:
#
#   tick  300 ( 5 s)   x = -15.89   y = -0.049
#   tick  600 (10 s)   x =  +2.37   y = -0.054
#   tick  900 (15 s)   x = +20.51   y = -0.067
#   tick 1200 (20 s)   x = +38.69   y = -0.043
#
# so she settles at **3.636 m/s** — seven knots, a working boat's cruise — and
# holds her trim to within 3 cm of it for the rest of the run.
#
# **The thrust moved 1.6 -> 1.9 MN when the hull's mass was corrected, and that
# is the same number rather than a new one.** The damping above scales on
# `displaced`, which went from 43.75 m^3 to the hull's measured 57.64, so the
# force that makes this hull do seven knots went up with it. 1.6 MN on the
# corrected hull reaches 3.334 m/s and is at x = -1.08 at tick 600, which is
# the wrong side of the `x > 0` acceptance below; 1.9 MN puts her at +2.37,
# within 2 cm of the +2.35 this file has always recorded. The wake assertions
# read 0.192 and 0.000 against their 0.15 and 0.02 bounds.
#
# **The submarining ceiling this paragraph used to name is gone, and that is
# the corrected hull rather than a lucky escape.** It said 2.0 MN walked the
# trim and 2.63 MN drove her under by tick 1200. Re-measured: 2.6 MN holds
# y = -0.10, 3.0 MN holds -0.20 and 3.5 MN holds -0.18 at 4.8 m/s. Thrust is
# still in the body frame and a bow that digs in still steers the vector
# downward — the mechanism is real — but a hull that is 32% heavier and whose
# buoyancy is distributed like her sections no longer trims far enough by the
# head to start it. **1.9 MN is a cruise, not a ceiling.**
#
# **There is no `max_speed` on `Propulsion` and there must not be.** The
# terminal speed above is already set by this force against the hull's authored
# damping; a second knob would be a second opinion about one number.
#
# What it measures:
#
#   loom sim assets/test/jib_vi_underway.loom --ticks 600 \
#     --assert "Sea/Boat.x > 0" \
#     --assert "water@-20,1.8.foam > 0.15" \
#     --assert "water@-10,14.foam < 0.02"
#
# A hull with no thrust sits at -34 for ever — the static one drifts 11 mm in
# ten minutes — so nothing passes the first by accident. The second and third
# are the wake: 22 m astern of the hull at tick 600 the water is still marked
# (0.251), and 14 m abeam of the track it has never been touched (0.000).
# **A hull that drags its own foam along with it reads 0.000 at both**, which
# is what shipped until `FOAM_HULL_DRAG` was deleted; this pair is the scene
# half of `loom_water::foam::a_twelve_station_hull_still_leaves_a_wake`.
#
#   loom render assets/test/jib_vi_underway.loom --frames 16 --spin 0 --step 40
#
# is the wake in motion, and no still shows the whole of it. **`--spin 0` and
# `--step 40` are both load-bearing.** `--spin` defaults to 6 deg a frame, which
# swings the camera off the track while the subject is trying to drive across
# it; and sixteen frames of the default step cover 180 ticks, three seconds, in
# which this hull has not yet reached the frame. Forty ticks a frame walks the
# whole 600 the header measures, so the trail grows behind her frame by frame
# with the camera held still — which is the only way to tell a wake that is
# being laid from a texture that is being scrolled.
#
# **The camera is a high oblique from off the starboard quarter, not from
# astern.** Astern is the natural place to stand and the wrong one: it puts the
# trail directly behind the hull, where the hull hides it, and it foreshortens
# the 30 m that are the point of the scene into a few pixels. From above and to
# one side the bow moustache, the waterline and the full length of the trail
# are all in frame at once, which is the shot every reference photograph of a
# boat wake is. The `Post` is on the run so a still can tell a moving boat from
# a parked one.
#
# **The wind is light on purpose**, copied from `jib_vi_float.loom` for the
# same reason: a real sea would make the wake ambiguous. At 3.5 m/s the surface
# has enough texture to see the hull respond and is never the cause.

[scene]
format = 1
id = "5f2a9c14-7e63-4b08-a1d9-3c6b70e58a42"

# The hull, its paint and its sixteen pontoons, from the file that owns them.
[[prefab]]
key = "jib_vi"
id = "3c7a5e12-8b64-4f09-a2d3-6e1b90c47f58"
path = "../prefabs/jib_vi.loom"

[[asset]]
key = "box"
path = "box"

[[node]]
name = "Sea"

  [node.components.Environment]
  sun_direction = [0.34, 0.58, -0.74]
  sun_strength = 1.3
  sun_color = [1.0, 0.97, 0.90]
  ambient = 0.55
  sky_zenith = [0.16, 0.31, 0.55]
  sky_horizon = [0.66, 0.74, 0.80]
  fog_density = 0.0016
  fog_falloff = 0.05

  [node.components.Wind]
  direction_degrees = 20.0
  speed = 3.5
  gustiness = 0.25
  turbulence = 0.15

[[node]]
name = "Water"
parent = "Sea"

  [node.components.WaterBody]
  kind = "ocean"
  surface_height = 0.0
  density = 1000.0
  drag = 2.0

# Started well aft of the origin so the run crosses it, and so the trail the
# assertions read is water the hull has actually been through by tick 600
# rather than water it started on. The foam field is 63.5 m square and anchored
# to the water node — ADR 0045's trap clause: sim state, never the camera — so
# a longer run would simply drive off the end of its own instrument.
[[node]]
name = "Boat"
parent = "Sea"
prefab = "jib_vi"
transform = { pos = [-34.0, 0.0, 0.0] }

  # 1.9 MN along the body's own +X, which is the bow — see the header for why
  # a 58-tonne boat needs 194 tonnes-force to make seven knots. In the body
  # frame, so a hull that yaws on a wave keeps pushing the way her bow now
  # points.
  #
  # An override rather than a component, because the node is a prefab instance
  # and the parser refuses components on one — ADR 0008. The prefab does not
  # carry a `Propulsion` at all, which is correct: a hull is not a hull under
  # power, and every other scene that floats this boat wants it stationary.
  [node.overrides]
  "Propulsion.force" = [1900000.0, 0.0, 0.0]

# A fixed mark on the run, so a still can tell a moving boat from a parked one
# and so the wake has something to be measured against.
[[node]]
name = "Post"
parent = "Sea"
transform = { pos = [6.0, 2.5, -14.0], scale = [0.25, 5.0, 0.25] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

  [node.components.Material]
  albedo = [0.26, 0.24, 0.22]
  roughness = 0.9

# High off the starboard quarter, looking down the track — see the header. The
# boat is at x = +2.35 at tick 600, so this frames her with the whole 30 m of
# trail running away to the left.
[[node]]
name = "Camera"
parent = "Sea"
transform = { pos = [0.0, 22.0, 26.0], rot_euler = [-40.0, -4.4, 0.0] }

  [node.components.Camera]
  fov_y_degrees = 50.0
