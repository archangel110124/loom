# Where the water meets the land. W6, in a still.
#
# Three things happen in this frame that could not happen before it, and each
# is a different half of "depth is real":
#
# 1. **The water stops at the water's edge.** Depth is
#    `surface_height − terrain_height(x, z)` per vertex, out of the height grid
#    baked from this volume's SDF, and the fragment shader discards where it
#    goes negative. Before W6 the sea was a plane and it lay over the island.
# 2. **The waves flatten as they come in.** `attenuation_depth` finally drives
#    something: `tanh(k·d)/tanh(k·D)` per wave, so the long swell offshore
#    arrives at the beach as nothing.
# 3. **The shallows are a different colour**, because the depth the tint reads
#    is the real one rather than the constant 6 m the shader used to be handed.
#
# **The sea floor is six metres down, and the number is not arbitrary.** Outside
# the volume there is no terrain and the water is bottomless, so whatever reads
# depth has to already be saturated at the volume's edge or the grid boundary
# draws itself in the water — a hard-edged rectangle around the terrain, which
# is what the first version of this scene did with its floor four metres down.
# Two things read depth: the shoaling taper, saturated at `attenuation_depth`
# (4 m here), and the shallow-water tint, saturated at `WATER_TINT_DEPTH` in
# `scene.slang` (5 m). Six clears both. **That is the one thing an author has to
# know about this system**, and it is cheaper to say here than to discover in a
# top-down screenshot.

[scene]
format = 1
id = "4a7e93c1-58fd-4d26-9b07-6c1e2a8f5d34"

[[node]]
name = "Shore"

  [node.components.Environment]
  # Low afternoon sun coming across the water toward the camera, which is what
  # puts the glitter path on the sea. Without it the surface is a flat sheet of
  # sky colour and the shoaling is much harder to see.
  sun_direction = [0.16, 0.34, -0.93]
  sun_strength = 1.3
  sun_color = [1.0, 0.93, 0.80]
  ambient = 0.48
  sky_zenith = [0.16, 0.30, 0.54]
  sky_horizon = [0.60, 0.67, 0.72]
  fog_density = 0.004
  fog_falloff = 0.05

  # Blowing onshore. It drives nothing here — the wave list wins — and it is
  # authored so the scene describes one weather rather than two.
  [node.components.Wind]
  direction_degrees = 0.0
  speed = 6.0
  gustiness = 1.2
  turbulence = 0.9

# The island and the sea floor, in one volume. 48 m across at 0.25 m voxels,
# which is a 193² height grid — the bake the water reads its depth from.
#
# ORDER MATTERS, as everywhere else: the slab lays the floor, the sphere raises
# the island out of it.
[[node]]
name = "Ground"
parent = "Shore"

  [node.components.VoxelVolume]
  voxel_size = 0.25
  chunks = [6, 2, 6]

  # The sea floor, top at y = 2.0 — six metres under the still-water line, which
  # is deeper than anything that reads depth. See the note at the top of the
  # file.
  [[node.components.VoxelVolume.ops]]
  kind = "box"
  center = [24.0, 1.0, 24.0]
  half_extents = [26.0, 1.0, 26.0]
  mode = "union"

  # The island. A sphere is the honest shape for a beach: its flank passes
  # through every angle, so the waterline sits where the terrain puts it rather
  # than on a seam somebody authored. Radius 30 centred 23 m down puts the
  # summit at y = 9 — one metre of freeboard — and the waterline at 7.7 m from
  # the middle, on a bed sloping about 1:4. That is a steep beach and a gentle
  # one for a Gerstner surface: the fold bound measured in
  # `a_steep_enough_bed_is_where_shoaling_could_fold` is 1:1.
  [[node.components.VoxelVolume.ops]]
  kind = "sphere"
  center = [24.0, -21.0, 24.0]
  radius = 30.0
  mode = "union"

  # Sand, wet and dry alike — W7 is where a shoreline gets to darken what it
  # has washed over.
  [node.components.Material]
  albedo = [0.52, 0.45, 0.34]
  roughness = 0.9

[[node]]
name = "Water"
parent = "Shore"

  [node.components.WaterBody]
  kind = "ocean"
  surface_height = 8.0
  density = 1025.0

  [node.components.WaterBody.waves]
  # Four metres: the depth at and beyond which a wave is its whole self. Below
  # it every wave flattens, the long ones first. Shallower than the sea floor,
  # deliberately — see the note at the top of the file.
  attenuation_depth = 4.0
  # At least the summed amplitudes, which is what the mesh's bounds are built
  # from.
  max_height = 1.2

  [[node.components.WaterBody.waves.waves]]
  wavelength = 22.0
  amplitude = 0.62
  steepness = 0.35
  direction = [0.1, -1.0]
  speed_scale = 1.0

  [[node.components.WaterBody.waves.waves]]
  wavelength = 13.0
  amplitude = 0.34
  steepness = 0.45
  direction = [-0.3, -1.0]
  speed_scale = 1.0

  [[node.components.WaterBody.waves.waves]]
  wavelength = 8.0
  amplitude = 0.19
  steepness = 0.5
  direction = [0.5, -1.0]
  speed_scale = 1.0

  [[node.components.WaterBody.waves.waves]]
  wavelength = 4.5
  amplitude = 0.08
  steepness = 0.55
  direction = [-0.2, -1.0]
  speed_scale = 1.0

# A post standing in the shallows, with a known silhouette, so the waterline
# has something to be measured against — and so a still can tell water that is
# flattening from water that has simply been moved down.
[[node]]
name = "Post"
parent = "Shore"
transform = { pos = [20.5, 6.6, 34.0], scale = [0.22, 2.6, 0.22] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

  [node.components.Material]
  albedo = [0.20, 0.16, 0.12]
  roughness = 0.85

# Low and offshore, looking up the beach: deep water in the foreground, the
# shoaling shelf across the middle, the shoreline and the island behind it.
[[node]]
name = "Camera"
parent = "Shore"
transform = { pos = [25.0, 10.4, 42.0], rot_euler = [-10.0, 0.0, 0.0] }

  [node.components.Camera]
  fov_y_degrees = 55.0
