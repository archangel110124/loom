# **Walking the Rig.** The demo hub with a pilot at the controls instead of a
# human — a pilot that paces the deck end to end, hops constantly, and never
# looks where it is going.
#
# This is `extends`, not a copy. The deck, the rails, the shed, the supplies,
# the slipway and the boat all come from the demo, and **one field is
# different**: the Player's movement script. Change the hub and this scene
# changes with it, which is the whole reason a test that is a copy of a level
# is worthless by the second week.
#
# The pilot is `../scripts/rig_patrol.rhai`, and its header says why it is not
# `patrol.rhai`: it hops with `deeper_player.rhai`'s own constants, so what it
# proves is a claim about the player rather than about a test script that
# happens to jump 11 cm higher.
#
# It walks along z = +0.90 with its lateral velocity pinned to zero, and that
# lane is load-bearing twice over. The supplies sit within 1.4 m of it, so a
# lap collects all four. And the slipway's gap in the east railing is
# deliberately **off** it, at z = +2.0 to +4.8 — a gap on this lane is a gap the
# pilot walks straight down, and its "still on the deck" assertion would then be
# failed by the pilot doing something perfectly correct.
#
# ---------------------------------------------------------------------------
# WHAT IT MEASURES — three runs, because they are three claims
# ---------------------------------------------------------------------------
#
#   # 1. the hub is crossable: 15 m of deck, still standing on it
#   loom sim assets/test/rig_walk.loom --ticks 220 \
#     --assert "Rig/Player.x > 10.0" --assert "Rig/Player.y > 2.2"
#
#   # 2. and a lap fills the hold
#   loom sim assets/test/rig_walk.loom --ticks 500 \
#     --assert "state.carried >= 4" --assert "events.pickup >= 4" \
#     --assert "Rig/Player.y > 2.2"
#
#   # 3. thirty seconds of hopping into railings, and it is never lost
#   loom sim assets/test/rig_walk.loom --ticks 1800 \
#     --assert "Rig/Player.y > -1.0" --assert "state.carried >= 4"
#
# `Player.y > 2.2` is "on the deck": the deck stands the capsule's centre at
# 2.318 and there is nothing else in this scene at that height.
#
# ---------------------------------------------------------------------------
# RUN 3 USED TO CLAIM SOMETHING ELSE, AND THE CHANGE IS THE POINT
# ---------------------------------------------------------------------------
#
# It used to assert `Player.y > 2.2` at 1800 ticks — "the railing held" — and
# it passed for a reason that had nothing to do with the railing. The pilot
# reverses after ten blocked ticks and hops on `tick % 90`, so it walks *away*
# from a wall before a hop can coincide with being pressed against it: it is
# structurally incapable of producing the failure it was written to detect.
# Pressed continuously into the same rail while hopping, the capsule goes over
# in about thirty-five ticks, at plain walking speed, on the rail this pilot
# already visits. **A test that cannot fail is worse than no test**, and this
# one carried a header claiming it had caught two prior bugs.
#
# The design changed with it, and that is why the assertion is not simply
# tightened. The berth had to open so the boat could be boarded, and the height
# a solid rail would need to beat the jump is above the player's own eye. So
# the rig's guarantee is no longer "you cannot get out" — it is **"you always
# get back"**: `deeper_player.rhai` floats a capsule that goes under and the
# slipway walks it out. `y > -1.0` is that guarantee, and it is a claim this
# pilot can actually fail. `assets/test/rig_overboard.loom` proves the other
# half — that the way back is walkable — with the shipped player model.
#
# Run 3 does go over a rail somewhere between tick 900 and tick 1800, and ends
# the run swimming east at y = -0.6999. That is now expected behaviour rather
# than a defect, which is exactly the sort of sentence a test file has to say
# out loud or the next reader will "fix" it.

[scene]
format = 1
id = "f32eb6a2-8707-4ec9-8c21-b680b06f0644"

[[prefab]]
key = "demo"
id = "b2a43f8f-314a-4d92-b4aa-322411869fcd"
path = "../games/deeper_demo.loom"

[[node]]
name = "Rig"
extends = "demo"

[[node]]
name = "Player"
parent = "Rig"

  # The one field this file changes.
  [node.components.Script]
  path = "../scripts/rig_patrol.rhai"
