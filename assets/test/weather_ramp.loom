# The carry instrument, on a sea that gets up while it runs.
#
# **`jib_vi_drift.loom` with a weather ladder over it, and nothing else
# changed.** That file asks whether five passive riders stay where they were
# put while the deck heaves — the ADR 0060 question — at one hand-picked wind
# speed, and its own header says "the harder sea is a copy of this file with
# `speed` raised". This is that copy, except the raising is authored as a ramp
# rather than as a second file, so one run measures the whole ladder.
#
# **Two features are under test here and neither exists anywhere else.**
#
# 1. `WaterBody.fetch`. Without it the derived sea is fully-developed
#    Pierson-Moskowitz, which is SCALE-INVARIANT: `A` goes as `U²` and `k` as
#    `U⁻²`, so slope is the same at every wind speed there is and raising the
#    wind only makes the waves longer. Measured on `ocean.loom` with its
#    authored waves stripped, realised `mu_max` over a 9x9 grid runs
#    0.112 / 0.105 / 0.090 / 0.047 at Wind.speed 3 / 8 / 12 / 16 — the sea gets
#    *smoother* as the wind rises — and at 20 the shortest wave in the world is
#    94 m and the camera is under the sea. At 3 km the same ladder runs
#    0.143 / 0.174 / 0.175 / 0.202 and `Hs` stays inside half a metre.
#
# 2. `Environment.stages[].wind_speed`, blended by `state.dread` on the fixed
#    tick. `weather_ramp.rhai` moves `dread` linearly over 1800 ticks and does
#    nothing else, so a measurement at tick N reads a known rung.
#
# **The rungs are `dread` 0 / 0.5 / 1.0 and Wind.speed 3.5 / 10 / 20.** 3.5 is
# the wind `jib_vi_drift`'s whole header was characterised on, so `dread = 0`
# here is that instrument unchanged apart from the fetch; 20 is the top and it
# is measured rather than chosen — see the numbers in the commit that added
# this file.
#
# Read it the way `jib_vi_drift` is read, per rider and per axis:
#
#   loom sim assets/test/weather_ramp.loom --ticks 3600 \
#     --assert "Sea/Boat/PortRail.local_x > 9999"
#
# and take `actual` off the failure. **Sweep the tick count**: ADR 0060's
# acceptance has two halves — 50 mm net drift and 30 mm peak-to-peak — and a
# single tick count can only see the first.
#
# **The sea is derived and must stay derived.** Author a wave list on the
# `WaterBody` below and the ladder goes inert: `Sim::reweather` refuses to
# overwrite an authored list, deliberately, because silently deleting the one
# thing a scene said explicitly about its water is worse than an inert knob.
[scene]
format = 1
id = "7c3e91a4-5d20-4b68-9f13-2a86c0d5e714"

[[asset]]
key = "hull_white"
path = "../meshes/jib_vi_hull_white.obj"

[[asset]]
key = "navy"
path = "../meshes/jib_vi_navy.obj"

[[asset]]
key = "deck_grey"
path = "../meshes/jib_vi_deck_grey.obj"

[[asset]]
key = "wood_trim"
path = "../meshes/jib_vi_wood_trim.obj"

[[asset]]
key = "glass"
path = "../meshes/jib_vi_glass.obj"

[[asset]]
key = "metal"
path = "../meshes/jib_vi_metal.obj"

[[asset]]
key = "gold"
path = "../meshes/jib_vi_gold.obj"

[[asset]]
key = "orange"
path = "../meshes/jib_vi_orange.obj"

[[asset]]
key = "red"
path = "../meshes/jib_vi_red.obj"

[[asset]]
key = "box"
path = "box"

[[asset]]
key = "capsule"
path = "capsule"

[[node]]
name = "Sea"

  [node.components.GameRules]
  path = "../scripts/weather_ramp.rhai"

  [node.components.Environment]
  sun_direction = [0.34, 0.58, -0.74]
  sun_strength = 1.3
  sun_color = [1.0, 0.97, 0.90]
  ambient = 0.55
  sky_zenith = [0.16, 0.31, 0.55]
  sky_horizon = [0.66, 0.74, 0.80]
  fog_density = 0.0016
  fog_falloff = 0.05

  # **The base wind, and the ladder's floor.** `wind_speed` on a stage
  # overrides only the speed — direction, gustiness and turbulence stay the
  # scene's, because a rising wind is the same wind harder.
  [node.components.Wind]
  direction_degrees = 20.0
  speed = 3.5
  gustiness = 0.25
  turbulence = 0.15

    [[node.components.Environment.stages]]
    name = "calm"
    at = 0.0
    wind_speed = 3.5

    [[node.components.Environment.stages]]
    name = "making"
    at = 0.5
    wind_speed = 10.0

    [[node.components.Environment.stages]]
    name = "blow"
    at = 1.0
    # **16 is measured, not chosen.** ADR 0060's carry acceptance is 30 mm
    # peak-to-peak in the boat frame, and this scene's five riders swept over
    # ticks 1800-2100 give, by top rung:
    #
    #     Wind.speed   10     12     14     16     18     20
    #     worst p-p  12.9   19.2   23.6   23.9   33.6   38.5  mm
    #
    # Monotone, and it crosses between 16 and 18. 16 keeps a fifth of the
    # budget. **The deck is the binding constraint and not the hull** — the
    # hull is still inside a few centimetres of the water under it at 20, so
    # "the boat completed the trip" is not evidence about this and a wind cap
    # raised without a rider measurement is a cap raised on the wrong organ.
    wind_speed = 16.0

[[node]]
name = "Water"
parent = "Sea"

  [node.components.WaterBody]
  kind = "ocean"
  # Three kilometres of open water upwind. Absent, the sea is fully developed
  # and the ladder above is a zoom knob rather than a weather ramp.
  fetch = 3000.0
  surface_height = 0.0
  density = 1000.0
  drag = 2.0

[[node]]
name = "Boat"
parent = "Sea"
transform = { pos = [0.0, 0.40, 0.0] }

  [node.components.RigidBody]
  dynamic = true
  mass = 43776.0

  [node.components.BoxCollider]
  half_extents = [9.53, 1.66, 3.30]

  [node.components.Buoyancy]
  coefficient = 1.0
  damp_linear = 4.0
  damp_quadratic = 1.0

  [[node.components.Buoyancy.pontoons]]
  offset = [-7.5, -0.247, -1.836]
  radius = 1.093
