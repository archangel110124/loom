# The first asset generated by Hunyuan3D and imported into Loom.
#
# **What this proves is the pipeline, not the tree.** A described object became
# a reference image, a mesh, a baked 2048 atlas, an OBJ on Loom's axis
# convention, and a lit scene — with no hand modelling anywhere. The skill that
# produced it is `~/.claude/skills/hunyuan3d-assets`.
#
#     loom render assets/test/spruce.loom --out spruce.png --size 1280x800
#
# **The species is not an aesthetic choice.** A broadleaf oak was generated
# first and came back as two flat intersecting planes, because Hunyuan3D
# removes the background before it looks at anything and `rembg` shreds a
# canopy with sky visible through it: the trunk survived solid and the leaves
# returned as a ragged, near-transparent smear. The mesh was watertight,
# genus-0 and had a plausible face count — nothing downstream could tell.
#
# A dense conifer has a solid silhouette, so it mattes cleanly and arrives as
# real geometry: 30,000 faces in 8,386 separate needle clusters. `refcheck.py`
# scores that difference before any geometry is sampled (oak 0.052 coverage
# against a 0.037 fringe; this spruce 0.236 against 0.061).
#
# **It is also a better fit for this engine than a downloaded tree.**
# `props.loom` had to leave out the bushes and grass tufts from the same asset
# pack because they are alpha-cutout cards and `fragmentMain` has no `discard`.
# A generated conifer is solid geometry with no alpha to test.
#
# Scale is metres and worth checking first: the mesh arrives normalised to a
# 2-unit box, so the transform sets the real size. At `scale = 2.5` this is a
# 4.98 m tree, and the 1.7 m post beside it is the ruler that says so.

[scene]
format = 1
id = "88e3a940-9334-4a0f-837b-32f2a2cb8167"

[[asset]]
key = "mesh_Spruce"
id = "2791eb80-7cce-40a9-96b5-2caf1a8391a4"
path = "../meshes/spruce.obj"

[[asset]]
key = "spruce_albedo"
id = "c8d87c98-6d50-418a-ac93-8aa87df69230"
path = "../textures/spruce_albedo.png"

[[asset]]
key = "ground_soil_albedo"
id = "10d0531d-4591-4625-ad85-5979851a910e"
path = "../textures/ground_soil_albedo.png"

[[asset]]
key = "ground_soil_normal"
id = "129440b6-066f-4076-9d8b-25b06662d468"
path = "../textures/ground_soil_normal.png"

[[node]]
name = "Stand"

  # Flat and overcast, for the same reason `props.loom` is: this is an import
  # check, and a dramatic key light would flatter the mesh and hide the seams
  # the check exists to find.
  [node.components.Environment]
  sun_direction = [0.40, 0.62, 0.68]
  sun_strength = 2.0
  sun_color = [1.0, 0.97, 0.91]
  ambient = 0.38
  sky_zenith = [0.10, 0.15, 0.24]
  sky_horizon = [0.52, 0.56, 0.58]
  fog_density = 0.0015

[[node]]
name = "Ground"
parent = "Stand"
transform = { pos = [0.0, -0.25, 0.0], scale = [14.0, 0.25, 14.0] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

  [node.components.Material]
  albedo = [0.40, 0.38, 0.31]
  roughness = 0.95
  albedo_map = { asset = "ground_soil_albedo" }
  normal_map = { asset = "ground_soil_normal" }
  uv_scale = [0.6, 0.6]
  triplanar = true

[[node]]
name = "Spruce"
parent = "Stand"
transform = { pos = [0.0, 2.4975, 0.0], scale = [2.5, 2.5, 2.5] }

  [node.components.MeshRenderer]
  mesh = { asset = "mesh_Spruce" }

  # **Rough and unlit-looking on purpose.** The bake already carries the
  # needles' own shading, so a glossy material double-counts it and the tree
  # reads as plastic.
  [node.components.Material]
  albedo = [1.0, 1.0, 1.0]
  roughness = 0.92
  albedo_map = { asset = "spruce_albedo" }

[[node]]
name = "ScaleRef"
parent = "Stand"
transform = { pos = [2.6, 0.85, 1.9], scale = [0.06, 0.85, 0.06] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

  [node.components.Material]
  albedo = [0.86, 0.83, 0.76]
  roughness = 0.6

[[node]]
name = "Camera"
parent = "Stand"
transform = { pos = [0.0, 3.10, 9.40], rot_euler = [-4.0, 0.0, 0.0] }

  [node.components.Camera]
  fov_y_degrees = 52.0
