[[node]]
name = "Rig"

  # The demo's own environment, so this row's picture is comparable to the
  # scene it stands in for. `deeper_demo.loom:668-676`.
  [node.components.Environment]
  sun_direction = [0.42, 0.46, -0.78]
  sun_strength = 1.25
  sun_color = [1.0, 0.93, 0.80]
  ambient = 0.45
  sky_zenith = [0.16, 0.30, 0.52]
  sky_horizon = [0.74, 0.72, 0.66]
  fog_density = 0.0028
  fog_falloff = 0.05

  # The seam is a tide line and needs a tide to line. Unlimited depth is not
  # authored here (no `waves` listed), so `fetch` derives a fetch-limited sea
  # from `Wind.speed` instead of the scale-invariant fully-developed one.
  [node.components.WaterBody]
  surface_height = 0.0
  fetch = 15000.0

  [node.components.Wind]
  speed = 3.0
  direction_degrees = 20.0

[[node]]
name = "Deck"
parent = "Rig"

  [node.transform]
  pos = [0.0, 1.20, 0.0]

  [node.components.MeshRenderer]
  mesh = { asset = "deck_timber" }

