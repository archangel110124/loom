# Eight imported trees, each wearing its own texture.
#
# **This is the scene that proves `file.obj#Object` works.** The pack is one
# OBJ containing eight species in a row spanning a hundred metres, with eight
# materials — one texture atlas each, packing leaf cards and a bark region into
# a single image. One mesh can carry one material, so importing the file whole
# gives eight trees sharing one texture and seven of them wrong. Selecting by
# object name is what makes a downloaded pack usable without an authoring tool.
#
# Each object is recentred on X and Z at import but NOT on Y, so a tree's base
# sits at its origin and the transform below places it on the ground rather
# than through it.

[scene]
format = 1
id = "5d8a37f1-9b04-4e62-a7c3-16e08fb5924d"

[[asset]]
key = "tree_oak"
id = "8a1c7e04-3f52-4d69-b108-72ec9a5f31b6"
path = "../meshes/trees9.obj#Oak_Leav"

[[asset]]
key = "tree_oak_tex"
id = "c39f5a28-6014-47b3-98de-2f5a0b71c4e9"
path = "../textures/trees/Oak_Leav.png"

[[asset]]
key = "tree_walnut"
id = "1b6e94c7-05af-4238-b7d0-9e3418c6520a"
path = "../meshes/trees9.obj#Walnut_L"

[[asset]]
key = "tree_walnut_tex"
id = "7c02d5b9-4e81-4a36-90f2-58ba1e40c73d"
path = "../textures/trees/Walnut_L.png"

[[asset]]
key = "tree_mossy"
id = "e40b17c6-2a95-4f08-b563-c8071d9e26f4"
path = "../meshes/trees9.obj#Mossy_Tr"

[[asset]]
key = "tree_mossy_tex"
id = "3f95c821-7b60-4d14-a2e9-06c5748b1f3a"
path = "../textures/trees/Mossy_Tr.png"

[[asset]]
key = "tree_sonnerat"
id = "92e4a007-5c31-4b78-8f60-1d4e93c0a25b"
path = "../meshes/trees9.obj#Sonnerat"

[[asset]]
key = "tree_sonnerat_tex"
id = "6a17b2f4-8d09-4e53-b41c-70925ecf8360"
path = "../textures/trees/Sonnerat.png"

[[node]]
name = "Grove"

  [node.components.Environment]
  sun_direction = [0.35, 0.72, 0.6]
  sun_strength = 1.25
  sun_color = [1.0, 0.97, 0.9]
  ambient = 0.5
  sky_zenith = [0.17, 0.33, 0.58]
  sky_horizon = [0.62, 0.72, 0.80]
  fog_density = 0.004
  fog_falloff = 0.05

[[node]]
name = "Ground"
parent = "Grove"

  [node.components.VoxelVolume]
  voxel_size = 0.3
  chunks = [6, 1, 6]

  [[node.components.VoxelVolume.ops]]
  kind = "box"
  center = [28.8, 3.0, 28.8]
  half_extents = [30.0, 3.0, 30.0]
  mode = "union"

  [node.components.Material]
  albedo = [0.30, 0.30, 0.26]
  roughness = 0.95

[[node]]
name = "Oak"
parent = "Grove"
transform = { pos = [14.0, 6.0, 30.0], scale = [1.0, 1.0, 1.0] }

  [node.components.MeshRenderer]
  mesh = { asset = "tree_oak" }

  # **White albedo, because the atlas carries the colour.** Anything else tints
  # a photographed leaf toward an authored guess, which is the thing the ground
  # material work already settled.
  [node.components.Material]
  albedo = [1.0, 1.0, 1.0]
  roughness = 0.88
  albedo_map = { asset = "tree_oak_tex" }
  uv_scale = [1.0, 1.0]

[[node]]
name = "Walnut"
parent = "Grove"
transform = { pos = [26.0, 6.0, 26.0] }

  [node.components.MeshRenderer]
  mesh = { asset = "tree_walnut" }

  [node.components.Material]
  albedo = [1.0, 1.0, 1.0]
  roughness = 0.88
  albedo_map = { asset = "tree_walnut_tex" }
  uv_scale = [1.0, 1.0]

[[node]]
name = "Mossy"
parent = "Grove"
transform = { pos = [38.0, 6.0, 32.0] }

  [node.components.MeshRenderer]
  mesh = { asset = "tree_mossy" }

  [node.components.Material]
  albedo = [1.0, 1.0, 1.0]
  roughness = 0.9
  albedo_map = { asset = "tree_mossy_tex" }
  uv_scale = [1.0, 1.0]

[[node]]
name = "Sonneratia"
parent = "Grove"
transform = { pos = [48.0, 6.0, 24.0] }

  [node.components.MeshRenderer]
  mesh = { asset = "tree_sonnerat" }

  [node.components.Material]
  albedo = [1.0, 1.0, 1.0]
  roughness = 0.9
  albedo_map = { asset = "tree_sonnerat_tex" }
  uv_scale = [1.0, 1.0]

[[node]]
name = "Camera"
parent = "Grove"
transform = { pos = [30.0, 14.0, 76.0], rot_euler = [-6.0, 0.0, 0.0] }

  [node.components.Camera]
  fov_y_degrees = 55.0
