# A crate floating on the sea — the scene W5's exit criterion is measured on.
#
#     loom sim assets/test/water_crate.loom --ticks 1800 \
#         --assert "Sea/Crate.bob < 1.3" \
#         --assert "Sea/Crate.y < 1.5" --assert "Sea/Crate.y > -1.5"
#
# **`bob` is the assertion that means something.** It is the peak-to-peak
# vertical travel over the last 300 ticks, and the bounds are the water doc's
# own §5.5 suggestion — which on its own is too weak to catch this, because an
# undamped float passes through its resting height twice a cycle and a check at
# one instant finds it there half the time. Measured: **1.01 m of travel with
# the damping on, 2.73 m with it removed**, on a sea that itself travels 0.97 m
# at that spot. The crate rides the waves; it does not out-travel them.
#
# Thirty seconds of simulated time, because **resonance takes time to show**.
# Buoyancy without damping does not look wrong at t = 5 s; it looks wrong at
# t = 25 s, by which point the crate is leaving the sea. That is the whole
# reason this check is a simulation assertion rather than a screenshot, and it
# is the failure the water doc names in §5.5.
#
# The crate is dropped from four metres rather than started at rest on the
# surface, which is the discriminating start: an entry is what excites the
# oscillation that damping has to kill, and a crate placed exactly at its
# waterline would settle even with the damping switched off.
#
# It authors no `pontoons`, so it gets four — at its horizontal corners, with
# radii summing to the crate's own volume. That default is the answer to both
# halves of §5.6's pontoon trap: one sphere gives no righting torque and the
# crate spins, and four spheres large enough to *look* right around a bounding
# box displace three times what the crate does and it floats like a cork.
[scene]
format = 1
id = "5d81b2c7-3e94-4af6-9b02-7c1e58d3a4f0"

[[node]]
name = "Sea"

  [node.components.Environment]
  sun_direction = [0.3, 0.42, -0.85]
  sun_strength = 1.2
  sun_color = [1.0, 0.95, 0.85]
  ambient = 0.5
  sky_zenith = [0.13, 0.27, 0.5]
  sky_horizon = [0.6, 0.68, 0.74]
  fog_density = 0.005
  fog_falloff = 0.04

  [node.components.Wind]
  direction_degrees = 20.0
  speed = 7.0
  gustiness = 1.1
  turbulence = 0.9

[[node]]
name = "Water"
parent = "Sea"

  # A real sea, not a mirror. A flat surface would let a crate settle even with
  # no damping at all, so the waves are what make the assertion below mean
  # something: they are the infinite energy source §5.5 is about.
  #
  # Fresh water at 1000 kg/m³ and a crate of 300 kg per cubic metre, so it
  # floats with a little under a third of itself under — high enough that the
  # waterline moves visibly, low enough that the corners stay wet.
  [node.components.WaterBody]
  kind = "ocean"
  surface_height = 0.0
  density = 1000.0
  drag = 2.0

  [[node.components.WaterBody.waves.waves]]
  wavelength = 21.0
  amplitude = 0.42
  steepness = 0.35
  direction = [1.0, 0.3]
  speed_scale = 1.0

  [[node.components.WaterBody.waves.waves]]
  wavelength = 13.0
  amplitude = 0.26
  steepness = 0.45
  direction = [0.8, -0.6]
  speed_scale = 1.0

  [[node.components.WaterBody.waves.waves]]
  wavelength = 8.0
  amplitude = 0.14
  steepness = 0.5
  direction = [1.0, 0.7]
  speed_scale = 1.0

[[node]]
name = "Crate"
parent = "Sea"
transform = { pos = [0.0, 4.0, -6.0], rot_euler = [0.0, 12.0, 0.0], scale = [0.6, 0.6, 0.6] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

  [node.components.Material]
  albedo = [0.42, 0.3, 0.18]
  roughness = 0.8

  [node.components.RigidBody]
  dynamic = true
  # 1.2 m cube at 300 kg/m³. Density is what decides the waterline, so this is
  # the number to change if the crate should sit lower or higher.
  mass = 518.0

  # Everything default: four pontoons derived from the crate, Archimedes at
  # full strength, and the damping that makes it settle.
  [node.components.Buoyancy]

# A post standing in the water, so a render has one fixed silhouette to judge
# the crate's motion against. A still cannot tell a floating crate from one
# resting on an invisible floor.
[[node]]
name = "Post"
parent = "Sea"
transform = { pos = [-2.4, 0.7, -7.5], scale = [0.2, 3.0, 0.2] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

  [node.components.Material]
  albedo = [0.2, 0.16, 0.12]
  roughness = 0.85

[[node]]
name = "Camera"
parent = "Sea"
transform = { pos = [0.0, 1.6, 0.5], rot_euler = [-9.0, 0.0, 0.0] }

  [node.components.Camera]
  fov_y_degrees = 55.0
