# A small blockout, to prove the engine renders a real scene rather than a
# hardcoded triangle. Every node with a MeshRenderer becomes a box.
#
# Scale is in metres and Y is up (docs/format/README.md §1.1).

[scene]
format = 1
id = "b10c4f21-7e3a-4d55-9c18-2af6e0d33b77"

[[asset]]
key = "box"
id = "1f0a7c34-5b2e-4d61-8e93-6c0d4a2b9f15"
path = "assets/primitives/box.glb"

[[node]]
name = "Room"

# Floor slab.
[[node]]
name = "Floor"
parent = "Room"
transform = { pos = [0.0, -0.6, 0.0], scale = [6.0, 0.2, 4.0] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

  [node.components.BoxCollider]
  half_extents = [6.0, 0.2, 4.0]

# Two desks in a row, monitors on top.
[[node]]
name = "DeskLeft"
parent = "Room"
transform = { pos = [-2.2, 0.0, 0.0], scale = [1.0, 0.4, 0.7] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

# Monitors are children of Room, not of the desks. A desk is scaled
# [1.0, 0.4, 0.7], and a child inherits that scale — parenting a monitor to it
# would squash the monitor and drag it down to y = 1.4 * 0.4. Non-uniform scale
# on a parent is a real authoring trap; keep scaled blockout boxes childless.
[[node]]
name = "MonitorLeft"
parent = "Room"
transform = { pos = [-2.2, 0.85, 0.0], scale = [0.45, 0.3, 0.06] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

[[node]]
name = "DeskRight"
parent = "Room"
transform = { pos = [2.2, 0.0, 0.0], scale = [1.0, 0.4, 0.7] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

[[node]]
name = "MonitorRight"
parent = "Room"
transform = { pos = [2.2, 0.85, 0.0], scale = [0.45, 0.3, 0.06] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

# Teacher desk, rotated to face the other two.
[[node]]
name = "TeacherDesk"
parent = "Room"
transform = { pos = [0.0, 0.0, -2.4], rot_euler = [0.0, 25.0, 0.0], scale = [1.3, 0.45, 0.8] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

# A pillar, to make occlusion and depth obviously correct in the render.
[[node]]
name = "Pillar"
parent = "Room"
transform = { pos = [3.6, 1.2, -1.2], scale = [0.35, 2.0, 0.35] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

[[node]]
name = "CeilingLight"
parent = "Room"
transform = { pos = [0.0, 3.0, 0.0] }

  [node.components.Light]
  intensity = 800.0
  color = [1.0, 0.96, 0.9]
