# ===========================================================================
# THE DECK A PLAYER STANDS ON — twenty-six hand-authored boxes.
#
# **These are collision only and none of them is drawn.** The one above is the
# hull's inertia and is *not* what anyone walks on: its top face is at y = 1.66
# and the deck is at 0.60, so a capsule aboard this boat used to stand on an
# invisible lid a metre in the air with the deckhouse, bulwarks and rails all
# passable. A `BoxCollider` on a child of a dynamic node is now a collider on
# that body (ADR 0060), which is what makes a set like this expressible at all.
#
# **Every box weighs nothing** — `attach_box` builds them with
# `ColliderMassProps::Mass(0.0)`, which rapier resolves to exactly zero mass,
# zero angular inertia and no centre-of-mass shift. That is the whole reason
# the header's stability numbers above are still true, and the three pinned
# hashes are its tripwire: if any of them moves, mass leaked and the righting
# curve is void.
#
# **Boxes rather than a mesh-derived hull, deliberately.** A `voxelized_mesh`
# or a convex decomposition makes the sim hash a function of the art file, and
# the art file is being detailed further in a parallel effort — an enterable
# wheelhouse, moving controls. Boxes track *architecture*: the sheer, the
# bulwark line, the deckhouse footprint, the flybridge. Those are the numbers
# the header's buoyancy arithmetic already pins, and they survive the mesh
# changing under them. The twelve `local_y` standing stations in
# `jib_vi_walk.loom` are the detector for when they stop matching.
#
# Every number below was measured off `jib_vi_wide.obj` by marching columns
# through it, not read off the header:
#
#   deck at the centreline   0.66 aft, 0.60 amidships, 0.74 at x=4, 1.65 at x=8
#   walkable half-beam       2.55 aft, 2.80 amidships, 2.30 at x=4, 0.65 at x=8
#   bulwark cap              1.52 amidships rising to 2.45 at the stem
#   deckhouse footprint      x -6.2..3.9, |z| <= 1.50 (1.05 forward of x=2.2)
#   flybridge deck           3.08, x -6.5..4.2, |z| <= 2.60; helm console 3.45
#
# **The deckhouse is solid because nobody can get inside it.** Headroom under
# its canopy is 1.49 m and the capsule is 1.90 m, so the drawn floor in there
# is unreachable whatever the collider says. The wheelhouse the mesh effort is
# building needs the superstructure stack lifted about 0.5 m before a person
# fits under it, and that is the message to send them.
#
# `ponytail:` deck plates are rectangles and the bow is a wedge, so the two
# forward plates overhang the drawn hull by up to a metre of nothing. It is
# invisible and unreachable — the tapered bulwark boxes are what bound the
# walk, and they stop the capsule 0.1-0.2 m inboard of the drawn edge. Give the
# plates a yaw each if that margin ever has to be tighter.
# ===========================================================================

# --- the deck, following the sheer -----------------------------------------
#
# **Tilted, not stepped, and that was measured rather than assumed.** With four
# flat plates the walker's eye rose 0.045, 0.064 and 0.070 m as it crossed the
# three seams — autostep takes each over about six ticks, so it reads as a
# doorsill rather than a teleport, but there is no doorsill drawn there. Three
# of these plates sit on a rising sheer, so giving each the slope its own span
# has takes the seams to 0.005, 0.025, 0.000 and 0.000 m for one `rot_euler`
# apiece. The only remaining step is where the flat amidships plate meets the
# forward one, and 25 mm is under the skin thickness of the contact.
#
# `col_deck_mid` stays flat because its span is not a slope: the deck is 0.62 at
# both ends and cambers down to 0.60 in the middle, so a chord across it is
# already the best a single box can do.
#
# Seam-popping is the dominant failure mode of a hand-authored deck and no still
# render can see it, so it is measured here in the file rather than left to the
# fly-through.

[[node]]
name = "col_deck_aft"
parent = "Sea/Boat"
transform = { pos = [-7.8017, 0.49, 0.0], rot_euler = [0.0, 0.0, -0.655] }

  [node.components.BoxCollider]
  half_extents = [1.7501, 0.15, 2.62]

[[node]]
name = "col_deck_mid"
parent = "Sea/Boat"
transform = { pos = [-3.05, 0.465, 0.0] }

  [node.components.BoxCollider]
  half_extents = [3.10, 0.15, 2.82]

[[node]]
name = "col_deck_fwd"
parent = "Sea/Boat"
transform = { pos = [1.3025, 0.5125, 0.0], rot_euler = [0.0, 0.0, 0.955] }

  [node.components.BoxCollider]
  half_extents = [1.3502, 0.15, 2.82]

[[node]]
name = "col_deck_shoulder"
parent = "Sea/Boat"
transform = { pos = [3.506, 0.5751, 0.0], rot_euler = [0.0, 0.0, 2.291] }

  [node.components.BoxCollider]
  half_extents = [1.0008, 0.15, 2.55]

# **The foredeck is tilted slabs, not steps.** It climbs 0.765 -> 1.66 over
# 3.65 m, and cutting that into flat plates puts a 0.37 m riser at the forward
# end — over the step height, so the bow would be unreachable — and three seams
# for a camera to pop across.
#
# **Two slabs and not one, because the sheer is convex and a chord is not a
# curve.** A single 13.9 degree slab matched both ends to 5 mm and stood 0.29 m
# above the drawn deck in the middle, which is a person walking on air over the
# thing they appear to be standing on. Measured against the mesh, the drawn deck
# is 0.77 at x=4.5, 0.80 at 5.0, 0.84 at 5.5, 0.89 at 6.0, 0.98 at 6.5, 1.15 at
# 7.0, 1.37 at 7.5 and 1.65 at 8.0 — nearly flat aft and steep at the stem. Two
# chords hold it to under 5 cm everywhere and meet at the same height at x=6.4,
# so there is no step between them either.
[[node]]
name = "col_foredeck_aft"
parent = "Sea/Boat"
transform = { pos = [5.412, 0.6955, 0.0], rot_euler = [0.0, 0.0, 4.574] }

  [node.components.BoxCollider]
  half_extents = [1.0032, 0.15, 2.30]

[[node]]
name = "col_foredeck_fwd"
parent = "Sea/Boat"
transform = { pos = [7.286, 1.1555, 0.0], rot_euler = [0.0, 0.0, 24.019] }

  [node.components.BoxCollider]
  half_extents = [0.9032, 0.15, 1.30]

# --- bulwarks, following the taper -----------------------------------------
# Inner faces 0.1-0.2 m inboard of the drawn deck edge, so the capsule stops
# just short of the edge and never over it. The two forward pairs are yawed
# because the hull narrows from a 2.45 m half-beam to 0.50 m over six metres,
# and a straight box would either fence off the side deck or hang over the sea.
# Tops sit at the drawn cap height, not above it: a collider taller than the
# rail it represents is an invisible wall, which is the same lie as a missing
# one told the other way.

[[node]]
name = "col_bulwark_aft_port"
parent = "Sea/Boat"
transform = { pos = [-8.00, 0.96, -2.86] }

  [node.components.BoxCollider]
  half_extents = [1.60, 0.66, 0.30]

[[node]]
name = "col_bulwark_aft_stbd"
parent = "Sea/Boat"
transform = { pos = [-8.00, 0.96, 2.86] }

  [node.components.BoxCollider]
  half_extents = [1.60, 0.66, 0.30]

[[node]]
