# Mooring posts standing in the water. **They are what makes the swell
# readable in a still** — the same job `water_crate.loom`'s post does, and the
# reason a floating boat alone is not enough: a still cannot tell a floating
# hull from one resting on an invisible floor.

[[node]]
name = "MooringA"
parent = "Lanternhead"
transform = { pos = [25.0, 8.30, 22.0], scale = [0.13, 1.5, 0.13] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

  [node.components.Material]
  albedo = [0.11, 0.10, 0.08]
  roughness = 0.88

[[node]]
name = "MooringB"
parent = "Lanternhead"
transform = { pos = [23.0, 8.30, 16.0], scale = [0.13, 1.5, 0.13] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

  [node.components.Material]
  albedo = [0.11, 0.10, 0.08]
  roughness = 0.88

[[node]]
name = "MooringC"
parent = "Lanternhead"
transform = { pos = [21.5, 8.30, 11.0], scale = [0.13, 1.5, 0.13] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

  [node.components.Material]
  albedo = [0.11, 0.10, 0.08]
  roughness = 0.88

[[node]]
name = "Dinghy"
parent = "Lanternhead"
transform = { pos = [25.0, 8.2, 14.0], rot_euler = [0.0, 16.0, 0.0], scale = [0.9, 0.35, 2.4] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

  [node.components.Material]
  albedo = [0.34, 0.26, 0.17]
  roughness = 0.80

  # 300 kg/m^3 over the hull's volume, which is what decides the waterline.
  [node.components.RigidBody]
  dynamic = true
  mass = 1800.0

  # Everything default: four corner pontoons, Archimedes at full strength, and
  # the damping that makes it settle rather than resonate.
  [node.components.Buoyancy]

[[node]]
name = "Camera"
parent = "Lanternhead"
transform = { pos = [30.0, 10.30, 39.0], rot_euler = [-1.0, 0.0, 0.0] }

  # **Yaw is 0 on purpose**, so the composition does not depend on a rotation
  # convention nobody has rendered. 58 degrees is wide enough to hold the quay,
  # the harbour and the headland without the lanterns becoming specks.
  [node.components.Camera]
  fov_y_degrees = 58.0
