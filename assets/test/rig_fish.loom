# **A fish, played from the cockpit of the JIB VI.** The demo hub with the boat
# out in open water, the player standing on the helm mat, and a reference angler
# at the rod instead of a human.
#
# `extends`, not a copy: the rig, the rails, the supplies, the boat, her decks
# and the rod in its holder all come from `assets/games/deeper_demo.loom`.
# **Three things differ** — where the boat is, where the player is, and the
# presence of a `Pilot` node.
#
# ---------------------------------------------------------------------------
# WHY THIS SCENE HAS A PILOT AND `rig_drive.loom` REFUSES ONE
# ---------------------------------------------------------------------------
#
# The rule `scripts/green.sh` states, and it cuts both ways: swap the pilot when
# the thing under test is *downstream* of a press, and use `loom sim --hold`
# when the thing under test **is the mapping from the press**.
#
# The helm is a mapping — `deeper_player.rhai` reads `move_z` and writes
# `helm_force` — so `rig_drive` holds keys and has no pilot. A **fight** is
# downstream: it is 200 lines of state machine that has to be played for twenty
# seconds with correctly-timed taps, and `--hold` is one constant for a whole
# run. Two runs with different constants cannot express "let go when it runs".
# So `deeper_rules.rhai` carries five closed-loop reference anglers and a scene
# picks one by containing a node named `Root/Pilot/<name>` — the same mechanism
# the five `fight_*.loom` benches use, pointed at the demo for the first time.
#
# **What the pilot does NOT prove, and what does.** With a policy live the fight
# fabricates its own reel and press and never reads an `angler` event, so this
# scene says nothing about whether a keypress reaches the rod. That claim is
# made on the shipped demo, with real input:
#
#   loom sim assets/games/deeper_demo.loom --ticks 900 --hold "move_z=1,fire=1"
#     --assert "events.bite >= 1"
#
# — walk aboard holding W and the button, and the rod casts and a fish bites.
# It is a held button, so the fight sees exactly one press and the hook is never
# set; `events.spooked >= 1` is the other half of that same sentence.
#
# ---------------------------------------------------------------------------
# WHAT IT MEASURES — three claims
# ---------------------------------------------------------------------------
#
#   # 1. the fight reaches the demo's rules at all, and it is won
#   loom sim assets/test/rig_fish.loom --ticks 1500 \
#     --assert "events.hooked >= 1" --assert "events.landed >= 1"
#
#   # 2. the fish goes in the hold, beside the supplies, and is drawn there
#   loom sim assets/test/rig_fish.loom --ticks 1500 --assert "state.fish >= 1"
#
#   # 3. and the hub is not a bench: a landing is something you do again.
#   #    `OVER_TICKS` is 180, so by 1800 the rod is back and `status` has
#   #    stopped saying the game is over.
#   loom sim assets/test/rig_fish.loom --ticks 1800 \
#     --assert "status == playing" --assert "state.fish >= 1"
#
# The bench pins (`landed_tick == 1345`) are **not** repeated here. They belong
# to `fight_skilled.loom`, which is the fight with nothing else in the frame;
# this scene runs a whole hub around it and a number pinned in two places is a
# number that gets re-pinned in one.
#
# ---------------------------------------------------------------------------
# WHY SHE IS OUT IN OPEN WATER
# ---------------------------------------------------------------------------
#
# The same reason `rig_drive.loom` is: a berth is a wall on one side. She is
# also the frame this scene exists to be looked at in — the rod in its holder
# on the port bulwark, loading up against an empty sea, seen from the helmsman's
# own eye:
#
#   loom render assets/test/rig_fish.loom --sim 900 --out /tmp/rod.png
[scene]
format = 1
id = "5d3f81c0-9a47-4e62-b0d5-13f7ea2c9865"

[[prefab]]
key = "demo"
id = "b2a43f8f-314a-4d92-b4aa-322411869fcd"
path = "../games/deeper_demo.loom"

[[node]]
name = "Rig"
extends = "demo"

[[node]]
name = "Boat"
parent = "Rig"
transform = { pos = [3.0, 0.0, -40.0] }

# Boat-local (-7.00, -, -1.80): the port side of the aft cockpit and the middle
# of `HelmMat`, which is `rig_drive.loom`'s station exactly.
[[node]]
name = "Player"
parent = "Rig"
transform = { pos = [-4.00, 1.62, -41.80] }

# The angler at the rod. One word — see the header. Under `Rig` rather than
# under a second root, because a scene has exactly one root (`multiple_roots`)
# and this one's is the hub's; `deeper_rules.rhai` looks under both prefixes.
[[node]]
name = "Pilot"
parent = "Rig"

[[node]]
name = "skilled"
parent = "Rig/Pilot"
