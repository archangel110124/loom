# Five people standing still on a boat, for an hour of ticks.
#
# **This scene asks one question and it is not "can you walk here".** It is:
# does someone who is doing nothing stay where they were put, while the deck
# under them heaves, rolls and pitches on the sea. Walking is
# `jib_vi_walk.loom`, deliberately a different file — drift and traverse
# measured in one scene would be two tools measured as one, and the boat is
# already a place where a legitimate motion and a defect look alike.
#
# **Every rider is scriptless on purpose.** A movement model that re-derives a
# target velocity every tick crushes a slow drift and hides it; `fall_only` is
# gravity and nothing else, so whatever the deck does to a passive capsule is
# what this measures. It is the worst case and it is the honest one.
#
# **Every rider is parented to the Boat, which is the whole trick.** A
# character's world position on this hull swings tens of centimetres a second
# with the waves, so no global axis can express "it stayed put".
# `drive_characters` writes each character's position back into its node in the
# *parent's* frame every tick, so a rider parented here reads its boat-frame
# position directly, and `--assert Sea/Boat/<name>.local_x` is drift with the
# boat's own motion already subtracted (ADR 0060).
#
# The five stations are chosen for lever arm, because the carry a rider needs
# is `linvel + omega x r` and `r` is what varies:
#
#   AftCockpit   (-8.9, 0)     8.9 m aft of the roll/pitch axes
#   Centre       ( 0.0, +2.1)  amidships, the smallest lever there is
#   PortRail     ( 0.0, -2.3)  the beam, where roll is fastest
#   Foredeck     ( 5.5,  0)    5.5 m forward, where pitch is fastest
#   BridgeDeck   (-3.0, +1.5)  3 m *above* both axes, and the only station a
#                              translation-only fix fails — the horizontal
#                              component of omega x r is five times the
#                              centreline's there
#
# **Do not accept a build measured at the centreline alone.** That station
# passes almost anything.
#
# Read it with, per rider and per axis:
#
#   loom sim assets/test/jib_vi_drift.loom --ticks 3600 \
#     --assert "Sea/Boat/PortRail.local_x > 9999"
#
# and take `actual` off the failure — that is the boat-frame position at the
# end. Sweep the tick count for the peak-to-peak excursion.
#
# Everything except the riders is `jib_vi_painted.loom` unchanged, including the
# wind at 3.5. The harder sea is a copy of this file with `speed` raised; it is
# not authored here because a scene that measures a bound should measure one
# sea, and 3.5 is the one the hull's whole header was characterised on.

[scene]
format = 1
id = "b41d7c92-6ae0-4f13-9c85-2e7d05a1f3b6"

[[asset]]
key = "hull_white"
path = "../meshes/jib_vi_hull_white.obj"

[[asset]]
key = "navy"
path = "../meshes/jib_vi_navy.obj"

[[asset]]
key = "deck_grey"
path = "../meshes/jib_vi_deck_grey.obj"

[[asset]]
key = "wood_trim"
path = "../meshes/jib_vi_wood_trim.obj"

[[asset]]
key = "glass"
path = "../meshes/jib_vi_glass.obj"

[[asset]]
key = "metal"
