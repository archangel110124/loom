# Five people standing still on a boat, for an hour of ticks.
#
# **This scene asks one question and it is not "can you walk here".** It is:
# does someone who is doing nothing stay where they were put, while the deck
# under them heaves, rolls and pitches on the sea. Walking is
# `jib_vi_walk.loom`, deliberately a different file — drift and traverse
# measured in one scene would be two tools measured as one, and the boat is
# already a place where a legitimate motion and a defect look alike.
#
# **Every rider is scriptless on purpose.** A movement model that re-derives a
# target velocity every tick crushes a slow drift and hides it; `fall_only` is
# gravity and nothing else, so whatever the deck does to a passive capsule is
# what this measures. It is the worst case and it is the honest one.
#
# **Every rider is parented to the Boat, which is the whole trick.** A
# character's world position on this hull swings tens of centimetres a second
# with the waves, so no global axis can express "it stayed put".
# `drive_characters` writes each character's position back into its node in the
# *parent's* frame every tick, so a rider parented here reads its boat-frame
# position directly, and `--assert Sea/Boat/<name>.local_x` is drift with the
# boat's own motion already subtracted (ADR 0060).
#
# The five stations are chosen for lever arm, because the carry a rider needs
# is `linvel + omega x r` and `r` is what varies:
#
#   AftCockpit   (-8.9, 0)     8.9 m aft of the roll/pitch axes
#   Centre       ( 0.0, +2.1)  amidships, the smallest lever there is
#   PortRail     ( 0.0, -2.3)  the beam, where roll is fastest
#   Foredeck     ( 5.5,  0)    5.5 m forward, where pitch is fastest
#   BridgeDeck   (-3.0, -2.1)  3 m *above* both axes, and the only station a
#                              translation-only fix fails — the horizontal
#                              component of omega x r is five times the
#                              centreline's there. Outboard at z = -2.1
#                              because the hardtop comes down to 4.80 over a
#                              deck at 3.08 and a 1.9 m capsule does not fit
#                              under it — the bridge deck is walkable round its
#                              perimeter, not across it.
#
# **Do not accept a build measured at the centreline alone.** That station
# passes almost anything.
#
# Read it with, per rider and per axis:
#
#   loom sim assets/test/jib_vi_drift.loom --ticks 3600 \
#     --assert "Sea/Boat/PortRail.local_x > 9999"
#
# and take `actual` off the failure — that is the boat-frame position at the
# end. Sweep the tick count for the peak-to-peak excursion.
#
# Everything except the riders is `jib_vi_painted.loom` unchanged, including the
# wind at 3.5. The harder sea is a copy of this file with `speed` raised; it is
# not authored here because a scene that measures a bound should measure one
# sea, and 3.5 is the one the hull's whole header was characterised on.
#
# **What it currently measures**, boat-frame, ticks 60 to 3600:
#
#              net drift      peak-to-peak
#   wind 0     0 mm exactly   0 mm exactly, every station
#   wind 3.5   0.1 to 4 mm    7 mm in x, 18 mm in z, every station
#   wind 12    0.47 to 1.00 m
#
# Per station at wind 3.5, net: AftCockpit 3 mm, Centre 4 mm, PortRail 3 mm,
# Foredeck 3 mm, BridgeDeck 0.1 mm. Against the acceptance bounds of 50 mm net
# and 30 mm peak-to-peak, that is an order of magnitude of margin, and the
# bridge deck — three metres above both axes, where the horizontal part of
# omega x r is five times the centreline's — is the best of the five rather
# than the worst.
#
# **The wind 12 row is not a pass, is not claimed as one, and is not a
# coordinate error.** At that sea
# this hull heaves through 2.3 m while its horizontal position moves 5 cm, and
# a standing capsule's height swings 0.23 m — riders are genuinely thrown clear
# of the deck and land again, and a rider in the air is a rider not being
# carried. Raising `speed` here reproduces it. The fix is not in the carry;
# see ADR 0060.
#
# Before any of this, the same run at wind 3.5 put two of these five riders
# **13 km away** and a third 7.5 m off, and the same run at wind 12 put all five
# about 900 m astern.

[scene]
format = 1
id = "b41d7c92-6ae0-4f13-9c85-2e7d05a1f3b6"

[[asset]]
key = "hull_white"
path = "../meshes/jib_vi_hull_white.obj"

[[asset]]
key = "navy"
path = "../meshes/jib_vi_navy.obj"

[[asset]]
key = "deck_grey"
path = "../meshes/jib_vi_deck_grey.obj"

[[asset]]
key = "wood_trim"
path = "../meshes/jib_vi_wood_trim.obj"

[[asset]]
key = "glass"
path = "../meshes/jib_vi_glass.obj"

[[asset]]
key = "metal"
path = "../meshes/jib_vi_metal.obj"

[[asset]]
key = "gold"
path = "../meshes/jib_vi_gold.obj"

[[asset]]
key = "orange"
path = "../meshes/jib_vi_orange.obj"

[[asset]]
key = "red"
path = "../meshes/jib_vi_red.obj"

[[asset]]
key = "box"
path = "box"

[[asset]]
key = "capsule"
path = "capsule"

[[node]]
name = "Sea"

  [node.components.Environment]
  sun_direction = [0.34, 0.58, -0.74]
  sun_strength = 1.3
  sun_color = [1.0, 0.97, 0.90]
  ambient = 0.55
  sky_zenith = [0.16, 0.31, 0.55]
  sky_horizon = [0.66, 0.74, 0.80]
  fog_density = 0.0016
  fog_falloff = 0.05

  [node.components.Wind]
  direction_degrees = 20.0
  speed = 3.5
  gustiness = 0.25
  turbulence = 0.15

[[node]]
name = "Water"
parent = "Sea"

  [node.components.WaterBody]
  kind = "ocean"
  surface_height = 0.0
  density = 1000.0
  drag = 2.0

[[node]]
name = "Boat"
parent = "Sea"
transform = { pos = [0.0, 0.40, 0.0] }

  [node.components.RigidBody]
  dynamic = true
  # **57.636 tonnes: the hull's own measured displacement below her designed
  # waterline** — `../prefabs/jib_vi.loom` has the provenance and the choice of
  # waterline. It replaced 43,776 kg, which was a ratio applied to a guess and
  # was 24% light.
  mass = 57636.0

  [node.components.BoxCollider]
  half_extents = [9.53, 1.66, 3.30]

  [node.components.Buoyancy]
  coefficient = 1.0
  # Defaults, stated rather than inherited, because these scenes are about
  # stability and the damping is half of that: an analytic wave field has no
  # dissipation of its own, so an undamped pontoon gains amplitude every wave
  # until the boat launches.
  damp_linear = 4.0
  damp_quadratic = 1.0

  # **Sixteen pontoons, copied verbatim from `../prefabs/jib_vi.loom`, which
  # is where they were solved and where the reasoning for them lives** — eight
  # equal-volume slabs of the hull's own section curve, one sphere pair per
  # slab reproducing that slab's displacement *and* its waterplane area, the
  # whole set shifted 2.2994 m forward so the centre of buoyancy lands on the
  # centre of gravity the engine puts at the node origin. Read that file's
  # header before changing anything here, and change both together.
  #
  # **Order is the sum order** — stern to bow, port then starboard — because
  # `loom_water::buoyancy::solve` sums in it and float addition is not
  # associative.
  # Slab 0.
  [[node.components.Buoyancy.pontoons]]
  offset = [-5.9109, 0.2683, -1.1518]
  radius = 1.3462
  [[node.components.Buoyancy.pontoons]]
  offset = [-5.9109, 0.2683, 1.1518]
  radius = 1.3462
  # Slab 1.
  [[node.components.Buoyancy.pontoons]]
  offset = [-3.859, -0.0247, -1.2271]
  radius = 1.1859
  [[node.components.Buoyancy.pontoons]]
  offset = [-3.859, -0.0247, 1.2271]
  radius = 1.1859
  # Slab 2.
  [[node.components.Buoyancy.pontoons]]
  offset = [-2.1885, -0.1309, -1.2711]
  radius = 1.1364
  [[node.components.Buoyancy.pontoons]]
  offset = [-2.1885, -0.1309, 1.2711]
  radius = 1.1364
  # Slab 3.
  [[node.components.Buoyancy.pontoons]]
  offset = [-0.6905, -0.1917, -1.2959]
  radius = 1.1104
  [[node.components.Buoyancy.pontoons]]
  offset = [-0.6905, -0.1917, 1.2959]
  radius = 1.1104
  # Slab 4.
  [[node.components.Buoyancy.pontoons]]
  offset = [0.7407, -0.2109, -1.2908]
  radius = 1.1025
  [[node.components.Buoyancy.pontoons]]
  offset = [0.7407, -0.2109, 1.2908]
  radius = 1.1025
  # Slab 5.
  [[node.components.Buoyancy.pontoons]]
  offset = [2.1844, -0.2104, -1.2481]
  radius = 1.1027
  [[node.components.Buoyancy.pontoons]]
  offset = [2.1844, -0.2104, 1.2481]
  radius = 1.1027
  # Slab 6.
  [[node.components.Buoyancy.pontoons]]
  offset = [3.7571, -0.1602, -1.1291]
  radius = 1.1236
  [[node.components.Buoyancy.pontoons]]
  offset = [3.7571, -0.1602, 1.1291]
  radius = 1.1236
  # Slab 7.
  [[node.components.Buoyancy.pontoons]]
  offset = [5.9667, 0.058, -0.7255]
  radius = 1.2278
  [[node.components.Buoyancy.pontoons]]
  offset = [5.9667, 0.058, 0.7255]
  radius = 1.2278

# --- the hull's parts, drawn ------------------------------------------------

