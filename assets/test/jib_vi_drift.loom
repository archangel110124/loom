[[asset]]
key = "capsule"
path = "capsule"

[[node]]
name = "Sea"

  [node.components.Environment]
  sun_direction = [0.34, 0.58, -0.74]
  sun_strength = 1.3
  sun_color = [1.0, 0.97, 0.90]
  ambient = 0.55
  sky_zenith = [0.16, 0.31, 0.55]
  sky_horizon = [0.66, 0.74, 0.80]
  fog_density = 0.0016
  fog_falloff = 0.05

  [node.components.Wind]
  direction_degrees = 20.0
  speed = 3.5
  gustiness = 0.25
  turbulence = 0.15

[[node]]
name = "Water"
parent = "Sea"

  [node.components.WaterBody]
  kind = "ocean"
  surface_height = 0.0
  density = 1000.0
  drag = 2.0

[[node]]
name = "Boat"
parent = "Sea"
transform = { pos = [0.0, 0.40, 0.0] }

  [node.components.RigidBody]
  dynamic = true
  mass = 43776.0

  [node.components.BoxCollider]
  half_extents = [9.53, 1.66, 3.30]

  [node.components.Buoyancy]
  coefficient = 1.0
  damp_linear = 4.0
  damp_quadratic = 1.0

  [[node.components.Buoyancy.pontoons]]
  offset = [-7.5, -0.247, -1.836]
  radius = 1.093
  [[node.components.Buoyancy.pontoons]]
  offset = [-7.5, -0.247, 1.836]
  radius = 1.093
  [[node.components.Buoyancy.pontoons]]
