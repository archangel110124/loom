# The gleamsprat, in the engine that has to draw it.
#
# The creature's whole identity is specular: a chrome shell with one small
# matte coral part. That is a claim about *rendering*, so a Blender turntable
# cannot settle it — Cycles gives a mirror a full studio to reflect and Loom
# does not. Loom's TLAS holds meshes only (ADR 0019), so a gleamsprat reflects
# the sky, the posts and its neighbours, and **it does not reflect the water it
# is swimming in**. This scene is built to show exactly that difference: the
# posts exist so the mirror has something to be a mirror *of*, and the water is
# here so the absence of it in the reflection is visible rather than theoretical.
#
# Two meshes rather than one because Loom colours per node and never reads the
# `.mtl`. Neither file carries a `g`/`o` tag, so `file.obj#Group` cannot be
# typed against them and `loom_asset`'s recentring branch can never fire — the
# defect that took the boat apart. They share an origin at the nose tip, so the
# two children sit at identity and only the parent ever moves.
# **The swim is a vertex deform and the acceleration structure does not know
# about it.** Every ray — reflection, shadow, RTAO — sees the rest pose. That
# is a real cost and it is bounded here rather than argued about: the wave's
# envelope does not start until 58% of the way down the body and the chrome
# shell ends at 63%, so the mirror moves 0.23 mm while the fringe moves 16 mm.
# A neighbour's reflection is wrong by a quarter of a millimetre on a 161 mm
# animal. Refitting the BLAS would cost `ALLOW_UPDATE`, one BLAS per instance
# and a device stall per build, to fix that. It is not worth it, it is not
# built, and ADR 0062 carries the trigger that would reopen it.
#
# **The beat is dorsoventral (model Y) and that is a rendering decision, not
# an anatomical one.** `rot_euler = [0, 90, 0]` maps model +X onto world -Z,
# which is this camera's own view axis, so a lateral beat is edge-on and reads
# as foreshortening rather than as motion. If this scene's camera ever moves,
# re-render sixteen frames before trusting `beat`.
#
# **The two golden rows are 126 ticks apart, and a rate error is why.** A still
# pins the shape of the wave and says nothing about its speed; `weather.z` is
# `--sim N / 60` headless and a free-running wall clock in `loom run`, so a
# frequency that drifts is invisible in the viewer AND in any one reference.
# 1% off 3 Hz is 1.3 degrees of phase at tick 7 and 24 degrees at tick 133.
#
[scene]
format = 1
id = "2e253013-8b70-4ccd-a562-9f1d6b00301a"

[[asset]]
key = "gleamsprat_chrome"
id = "64281021-45d8-4f8c-ad11-796a1b05a0d3"
path = "../meshes/gleamsprat_chrome.obj"

[[asset]]
key = "gleamsprat_coral"
id = "d5e35506-95ac-420c-b5bf-36e5b831f1f7"
path = "../meshes/gleamsprat_coral.obj"

[[node]]
name = "Lagoon"

  # Bright and high, because a mirror is lit by what surrounds it rather than
  # by its own albedo. A dim sky renders chrome as flat grey and says nothing
  # about the model.
  [node.components.Environment]
  sun_direction = [0.35, 0.55, 0.75]
  sun_strength = 1.4
  sun_color = [1.0, 0.96, 0.88]
  ambient = 0.55
  sky_zenith = [0.16, 0.34, 0.58]
  sky_horizon = [0.66, 0.74, 0.78]
  fog_density = 0.004
  fog_falloff = 0.05

  # **A lagoon is sheltered, and without this one it was an open sea.** A
  # `WaterBody` that lists no waves gets sixteen derived from the wind
  # spectrum, and a scene that authors no `Wind` gets the default 5.5 m/s
  # breeze — which on this body means a swell running from -0.66 m to +0.30 m.
  # The animal is 0.16 m long and floats at 0.13, and the camera sits at 0.20,
  # so for most of any run longer than a second or so the camera was INSIDE the
  # water and the whole frame was the green underwater medium.
  #
  # Nobody had seen it because this scene was in no gate and had never been
  # rendered at a tick other than zero. Measured with
  # `loom sim --assert "water@0.0,0.50.height"` over 400 ticks at the eye:
  #
  #     wind 5.5 m/s (the default)   -0.664 .. +0.297
  #     wind 2.5                     -0.105 .. +0.062
  #     wind 2.0  <- authored        -0.049 .. +0.041
  #     wind 1.0                     -0.005 .. +0.005
  #
  # 2.0 m/s keeps a visible ripple on the surface — which the chrome needs,
  # because a mirror on dead-flat water reflects one flat band — while leaving
  # the lowest fish in the school 4 cm of clearance. Fetch is what builds a
  # wave and a lagoon has none, so this is the physical story as well as the
  # framing fix.
  [node.components.Wind]
  speed = 2.0
  gustiness = 0.2
  turbulence = 0.1

[[node]]
name = "Water"
parent = "Lagoon"

  [node.components.WaterBody]
  kind = "ocean"
  surface_height = 0.0
  density = 1025.0

# Three posts. They are not scenery: they are the only thing in the scene
# with a silhouette the chrome can pick up, and without them the "is it a
# mirror or is it grey plastic" question has no evidence either way.
[[node]]
name = "PostNear"
parent = "Lagoon"
transform = { pos = [-0.30, 0.07, -0.62], scale = [0.012, 0.07, 0.012] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

  [node.components.Material]
  albedo = [0.28, 0.22, 0.18]
  roughness = 0.85

[[node]]
name = "PostFar"
parent = "Lagoon"
transform = { pos = [0.34, 0.08, -0.78], scale = [0.012, 0.08, 0.012] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

  [node.components.Material]
  albedo = [0.30, 0.24, 0.19]
  roughness = 0.85

[[node]]
name = "PostBack"
parent = "Lagoon"
transform = { pos = [0.02, 0.06, -1.20], scale = [0.012, 0.06, 0.012] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

  [node.components.Material]
  albedo = [0.26, 0.21, 0.17]
  roughness = 0.85

# ---------------------------------------------------------------- hero fish
#
# Rotated 90° about Y so the nose (authored at +Z) points +X and the animal is
# broadside to a camera sitting on +Z. Turning the fish rather than the camera
# keeps the camera on the same simple axis every other test scene uses.
[[node]]
name = "Hero"
parent = "Lagoon"
transform = { pos = [0.0, 0.13, 0.0], rot_euler = [0.0, 90.0, 0.0] }

  # The swim. One travelling wave down the body, in this node's own frame,
  # shared by every mesh beneath it — the chrome shell and the coral fringe are
  # one animal and must agree about where the tail is.
  #
  # **`span_start = 0.58` is the whole shape of this creature.** The chrome
  # shell runs s 0.000-0.630 and the coral fringe s 0.544-1.000, measured off
  # the two OBJ files against the union body length 0.161171 m. Below 0.58 the
  # shell visibly squashes, which is wrong for a rigid metal pod. Above it the
  # shell moves 0.23 mm and the fringe moves 16 mm, which is the animal.
  #
  # It also means the two paired flank fins do not move at all. They are
  # free-floating pieces of the coral mesh — 121 vertices each, at s 0.267 to
  # 0.407 — and a shared one-dimensional shear would have slid them sideways in
  # lockstep as rigid slabs, which is the clearest "this is a shader" tell
  # there is. The envelope removes it rather than deferring it. The coral file
  # welds into five components, not one: the fringe, both fins and two ventral
  # bits, and only the fringe is behind 0.58.
  #
  # `amplitude` is a fraction of body length, not metres, so 0.10 is a tenth of
  # the animal and reads as large without knowing how big the animal is. The
  # load-time refusal is on peak surface *slope* rather than on amplitude,
  # because shortening `wavelength` steepens the shear just as much: these
  # settings author 1.73 against a ceiling of 3.0.
  #
  # `phase` is authored rather than hashed off the world origin. A hash is how
  # `windBend` de-syncs trees, and trees do not move; the moment this fish
  # travels, a hashed phase would re-hash every tick and the animal would
  # vibrate instead of swim.
  [node.components.Deform]
  nose = "+z"
  beat = "y"
  amplitude = 0.10
  wavelength = 0.50
  frequency = 3.0
  phase = 0.0
  span_start = 0.58

  [[node]]
  name = "HeroBody"
  parent = "Lagoon/Hero"

    [node.components.MeshRenderer]
    mesh = { asset = "gleamsprat_chrome" }

    # roughness 0.15, and it is the load-bearing number in the whole asset.
    # Below 0.10 a mirror reads as a bathroom fitting; this is *wet* chrome.
    [node.components.Material]
    albedo = [0.92, 0.94, 0.96]
    metallic = 1.0
    roughness = 0.15

  [[node]]
  name = "HeroTrim"
  parent = "Lagoon/Hero"

    # Coral-pink and matte is a shell's siphon. Red, dark or glossy is a
    # wound, which is a different creature in a different zone entirely.
    [node.components.MeshRenderer]
    mesh = { asset = "gleamsprat_coral" }

    [node.components.Material]
    albedo = [0.97, 0.55, 0.48]
    metallic = 0.0
    roughness = 0.85

# ------------------------------------------------------------------- school
#
# Four more at increasing range, so one frame carries the distance ramp the
# Blender contact sheet had to fake with a montage. The yaw of each is
# different because a school that agrees about its heading is the unison-sway
# failure grass already paid for once.
[[node]]
name = "FishA"
parent = "Lagoon"
transform = { pos = [-0.44, 0.11, -0.42], rot_euler = [0.0, 104.0, -3.0] }


  # **The frequencies differ, not only the phases, and that is the load-bearing
  # half.** A fixed phase offset is choreography: five animals beating at one
  # rate hold their relative pose forever and the eye locks onto the pattern in
  # about four seconds. Detuned oscillators drift apart and never repeat, which
  # is what a school does. Measured: forcing this school into unison moves 0.43%
  # of the gate frame at worst channel 176, so a still catches it.
  [node.components.Deform]
  nose = "+z"
  beat = "y"
  amplitude = 0.094
  wavelength = 0.52
  frequency = 2.7
  phase = 0.37
  span_start = 0.58

  [[node]]
  name = "FishABody"
  parent = "Lagoon/FishA"

    [node.components.MeshRenderer]
    mesh = { asset = "gleamsprat_chrome" }

    [node.components.Material]
    albedo = [0.92, 0.94, 0.96]
    metallic = 1.0
    roughness = 0.15

  [[node]]
  name = "FishATrim"
  parent = "Lagoon/FishA"

    [node.components.MeshRenderer]
    mesh = { asset = "gleamsprat_coral" }

    [node.components.Material]
    albedo = [0.97, 0.55, 0.48]
    metallic = 0.0
    roughness = 0.85

[[node]]
name = "FishB"
parent = "Lagoon"
transform = { pos = [0.52, 0.10, -0.70], rot_euler = [0.0, 72.0, 2.0] }

  [node.components.Deform]
  nose = "+z"
  beat = "y"
  amplitude = 0.106
  wavelength = 0.48
  frequency = 3.2
  phase = 0.61
  span_start = 0.58

  [[node]]
  name = "FishBBody"
  parent = "Lagoon/FishB"

    [node.components.MeshRenderer]
    mesh = { asset = "gleamsprat_chrome" }

    [node.components.Material]
    albedo = [0.92, 0.94, 0.96]
    metallic = 1.0
    roughness = 0.15

  [[node]]
  name = "FishBTrim"
  parent = "Lagoon/FishB"

    [node.components.MeshRenderer]
    mesh = { asset = "gleamsprat_coral" }

    [node.components.Material]
    albedo = [0.97, 0.55, 0.48]
    metallic = 0.0
    roughness = 0.85

[[node]]
name = "FishC"
parent = "Lagoon"
transform = { pos = [-0.18, 0.09, -1.05], rot_euler = [0.0, 96.0, 0.0] }

  [node.components.Deform]
  nose = "+z"
  beat = "y"
  amplitude = 0.087
  wavelength = 0.51
  frequency = 2.9
  phase = 0.19
  span_start = 0.58

  [[node]]
  name = "FishCBody"
  parent = "Lagoon/FishC"

    [node.components.MeshRenderer]
    mesh = { asset = "gleamsprat_chrome" }

    [node.components.Material]
    albedo = [0.92, 0.94, 0.96]
    metallic = 1.0
    roughness = 0.15

  [[node]]
  name = "FishCTrim"
  parent = "Lagoon/FishC"

    [node.components.MeshRenderer]
    mesh = { asset = "gleamsprat_coral" }

    [node.components.Material]
    albedo = [0.97, 0.55, 0.48]
    metallic = 0.0
    roughness = 0.85

[[node]]
name = "FishD"
parent = "Lagoon"
transform = { pos = [0.30, 0.08, -1.55], rot_euler = [0.0, 84.0, 0.0] }

  [node.components.Deform]
  nose = "+z"
  beat = "y"
  amplitude = 0.100
  wavelength = 0.49
  frequency = 3.4
  phase = 0.83
  span_start = 0.58

  [[node]]
  name = "FishDBody"
  parent = "Lagoon/FishD"

    [node.components.MeshRenderer]
    mesh = { asset = "gleamsprat_chrome" }

    [node.components.Material]
    albedo = [0.92, 0.94, 0.96]
    metallic = 1.0
    roughness = 0.15

  [[node]]
  name = "FishDTrim"
  parent = "Lagoon/FishD"

    [node.components.MeshRenderer]
    mesh = { asset = "gleamsprat_coral" }

    [node.components.Material]
    albedo = [0.97, 0.55, 0.48]
    metallic = 0.0
    roughness = 0.85

# The fish is 0.16 m long, so the camera is 0.5 m away and everything about
# this framing is small. `fov_y` is narrow for the same reason: a wide lens at
# half a metre distorts a 16 cm animal into a caricature of itself.
[[node]]
name = "Camera"
parent = "Lagoon"
transform = { pos = [0.0, 0.20, 0.50], rot_euler = [-8.0, 0.0, 0.0] }

  [node.components.Camera]
  fov_y_degrees = 40.0
