# Night, lit by a fire and by nothing else.
#
# **This is the scene that proves `Light` does something.** The component has
# been in the schema, documented and prefab-tested since early on, and until
# now nothing read it — a knob wired to nothing. A scene could be authored
# black, and then the only way to see anything in it was to turn the sun back
# on, which is not night.
#
# Everything that normally lights a scene is zero here: no sun, no ambient, no
# sky. Stub the fire's `Light` and the frame goes to almost nothing, which is
# what makes this a real gate rather than a picture of a fire.

[scene]
format = 1
id = "7b21f9d4-06c8-4a37-95e1-c3f40b8a76d2"

# **The reserved alias the fire looks for.** Every additive particle in a frame
# samples the same sheet, so the flipbook is per-scene rather than per-emitter
# — see `stamp_flipbook`. Generated by `tools/texture/flipbook.py`, which walks
# a closed loop through one 3D noise field so consecutive frames are related
# and frame 63 joins back onto frame 0.
[[asset]]
key = "fire_flipbook"
id = "d5a71c68-3e04-49b2-8f16-70c3ea852b91"
path = "../textures/fire_flipbook.png"

[[node]]
name = "Night"

  # **Every light source off.** `ambient` is the knob `Environment` documents
  # as the one that makes a scene dark, and the sky is the other half — a black
  # sky still lights nothing, but a blue one lights everything faintly blue and
  # that is what stops a scene ever reading as night.
  [node.components.Environment]
  sun_direction = [0.0, 1.0, 0.0]
  sun_strength = 0.0
  sun_color = [0.0, 0.0, 0.0]
  ambient = 0.0
  sky_zenith = [0.008, 0.010, 0.020]
  sky_horizon = [0.014, 0.016, 0.026]
  fog_density = 0.006
  fog_falloff = 0.03

  [node.components.Wind]
  direction_degrees = 40.0
  speed = 1.4
  gustiness = 1.6
  turbulence = 1.2

[[node]]
name = "Ground"
parent = "Night"

  [node.components.VoxelVolume]
  voxel_size = 0.15
  chunks = [5, 2, 5]

  [[node.components.VoxelVolume.ops]]
  kind = "box"
  center = [12.0, 2.0, 12.0]
  half_extents = [13.0, 2.0, 13.0]
  mode = "union"

  # A shallow scoop, so the firelight has curvature to fall across rather than
  # a flat plane that shades as one value.
  [[node.components.VoxelVolume.ops]]
  kind = "sphere"
  center = [12.0, 6.4, 12.0]
  radius = 2.6
  mode = "subtract"

  [node.components.Material]
  albedo = [0.42, 0.36, 0.30]
  roughness = 0.95
  porosity = 0.6

# Three stones round the pit, to catch the light at different angles. A single
# flat surface cannot show whether a point light falls off correctly.
[[node]]
name = "StoneA"
parent = "Night"
transform = { pos = [10.4, 4.15, 12.6], scale = [0.5, 0.35, 0.45] }

  [node.components.MeshRenderer]
  mesh = { asset = "sphere" }

  [node.components.Material]
  albedo = [0.5, 0.47, 0.44]
  roughness = 0.9

[[node]]
name = "StoneB"
parent = "Night"
transform = { pos = [13.5, 4.15, 11.4], scale = [0.45, 0.3, 0.4] }

  [node.components.MeshRenderer]
  mesh = { asset = "sphere" }

  [node.components.Material]
  albedo = [0.48, 0.45, 0.42]
  roughness = 0.9

[[node]]
name = "Log"
parent = "Night"
transform = { pos = [12.4, 4.05, 13.3], rot_euler = [0.0, 24.0, 0.0], scale = [0.9, 0.16, 0.16] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

  [node.components.Material]
  albedo = [0.20, 0.14, 0.10]
  roughness = 0.95

# **The fire's light.** Warm and low: a real flame is around 1800 K, which is
# far oranger than the "warm white" a lamp means. Placed a little above the
# fuel, where the luminous part of a flame actually is.
[[node]]
name = "Firelight"
parent = "Night"
transform = { pos = [12.0, 4.6, 12.0] }

  [node.components.Light]
  intensity = 22.0
  color = [1.0, 0.52, 0.18]

# The flame itself. Additive, so it reads as emission rather than as a lit
# surface — the same blend the explosion fire uses.
[[node]]
name = "Flame"
parent = "Night"
transform = { pos = [12.0, 5.55, 12.2] }

  # **One static quad, and the flame lives inside it.** Not a stack of
  # sprites: the colour target is 8-bit and additive blending clamps at 1.0
  # with no rolloff, so overlapping sprites pin red after about three layers
  # and the middle of any sprite fire is white however the sprites are shaped.
  # That is what made the last attempt a fireball. One quad has an overdraw of
  # exactly one, so the colour ramp survives everywhere.
  #
  # `lifetime` is long but BOUNDED. `cargo xtask validate` renders every scene
  # with no `--sim`, and the emitter is warmed up for two lifetimes' worth of
  # ticks — so a nominally infinite life costs millions of ticks per render.
  [node.components.ParticleEmitter]
  burst = 1
  rate = 0.0
  lifetime = 110.0
  lifetime_jitter = 0.0
  speed = 0.0
  spread_degrees = 0.0
  radius = 0.0
  gravity = 0.0
  drag = 0.0
  turbulence = 0.0
  wind_response = 0.0
  # The quad's side. The flame occupies the middle of it and the corners are
  # discarded, so this is comfortably larger than the fire.
  size = [2.8, 2.8]
  alpha = [1.0, 1.0]
  # Only the alpha and the sign of red matter to a flame; the ramp lives in the
  # shader, where it can be capped below 1.0 so nothing clips.
  color_start = [1.0, 1.0, 1.0]
  color_end = [1.0, 1.0, 1.0]
  additive = true
  flame = true

[[node]]
name = "Camera"
parent = "Night"
transform = { pos = [12.0, 5.4, 17.4], rot_euler = [-9.0, 0.0, 0.0] }

  [node.components.Camera]
  fov_y_degrees = 55.0
