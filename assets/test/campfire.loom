# Night, lit by a fire and by nothing else.
#
# **This is the scene that proves `Light` does something.** The component has
# been in the schema, documented and prefab-tested since early on, and until
# now nothing read it — a knob wired to nothing. A scene could be authored
# black, and then the only way to see anything in it was to turn the sun back
# on, which is not night.
#
# Everything that normally lights a scene is zero here: no sun, no ambient, no
# sky. Stub the fire's `Light` and the frame goes to almost nothing, which is
# what makes this a real gate rather than a picture of a fire.

[scene]
format = 1
id = "7b21f9d4-06c8-4a37-95e1-c3f40b8a76d2"

# **The reserved alias the fire looks for.** Every additive particle in a frame
# samples the same sheet, so the flipbook is per-scene rather than per-emitter
# — see `stamp_flipbook`. Generated by `tools/texture/flipbook.py`, which walks
# a closed loop through one 3D noise field so consecutive frames are related
# and frame 63 joins back onto frame 0.
[[asset]]
key = "fire_flipbook"
id = "d5a71c68-3e04-49b2-8f16-70c3ea852b91"
path = "../textures/fire_flipbook.png"

[[node]]
name = "Night"

  # **Every light source off.** `ambient` is the knob `Environment` documents
  # as the one that makes a scene dark, and the sky is the other half — a black
  # sky still lights nothing, but a blue one lights everything faintly blue and
  # that is what stops a scene ever reading as night.
  [node.components.Environment]
  sun_direction = [0.0, 1.0, 0.0]
  sun_strength = 0.0
  sun_color = [0.0, 0.0, 0.0]
  ambient = 0.0
  sky_zenith = [0.008, 0.010, 0.020]
  sky_horizon = [0.014, 0.016, 0.026]
  fog_density = 0.006
  fog_falloff = 0.03

  [node.components.Wind]
  direction_degrees = 40.0
  speed = 1.4
  gustiness = 1.6
  turbulence = 1.2

[[node]]
name = "Ground"
parent = "Night"

  [node.components.VoxelVolume]
  voxel_size = 0.15
  chunks = [5, 2, 5]

  [[node.components.VoxelVolume.ops]]
  kind = "box"
  center = [12.0, 2.0, 12.0]
  half_extents = [13.0, 2.0, 13.0]
  mode = "union"

  # A shallow scoop, so the firelight has curvature to fall across rather than
  # a flat plane that shades as one value.
  [[node.components.VoxelVolume.ops]]
  kind = "sphere"
  center = [12.0, 6.4, 12.0]
  radius = 2.6
  mode = "subtract"

  [node.components.Material]
  albedo = [0.42, 0.36, 0.30]
  roughness = 0.95
  porosity = 0.6

# Three stones round the pit, to catch the light at different angles. A single
# flat surface cannot show whether a point light falls off correctly.
[[node]]
name = "StoneA"
parent = "Night"
transform = { pos = [10.4, 4.15, 12.6], scale = [0.5, 0.35, 0.45] }

  [node.components.MeshRenderer]
  mesh = { asset = "sphere" }

  [node.components.Material]
  albedo = [0.5, 0.47, 0.44]
  roughness = 0.9

[[node]]
name = "StoneB"
parent = "Night"
transform = { pos = [13.5, 4.15, 11.4], scale = [0.45, 0.3, 0.4] }

  [node.components.MeshRenderer]
  mesh = { asset = "sphere" }

  [node.components.Material]
  albedo = [0.48, 0.45, 0.42]
  roughness = 0.9

[[node]]
name = "Log"
parent = "Night"
transform = { pos = [12.4, 4.05, 13.3], rot_euler = [0.0, 24.0, 0.0], scale = [0.9, 0.16, 0.16] }

  [node.components.MeshRenderer]
  mesh = { asset = "box" }

  [node.components.Material]
  albedo = [0.20, 0.14, 0.10]
  roughness = 0.95

# **The fire's light.** Warm and low: a real flame is around 1800 K, which is
# far oranger than the "warm white" a lamp means. Placed a little above the
# fuel, where the luminous part of a flame actually is.
[[node]]
name = "Firelight"
parent = "Night"
transform = { pos = [12.1, 4.7, 13.3] }

  # **3.0, and both 1.35 and the 22 the post-stack plan asked for are wrong.**
  #
  # 1.35 was chosen to hide a ceiling: against a fixed-point target at 22, red
  # reached 1.0 by 1.77 m, green by 1.35 m and blue by 0.89 m, so the "soft
  # glow" was the channels leaving the clamp one at a time rather than any
  # falloff. ADR 0018 removed that reason — nothing clips now and the shoulder
  # compresses a triple by one factor, so those radii are simply where the
  # falloff is, with the hue intact across all of them.
  #
  # **But 22 is worse, and the measurement says why: the ground out-shines the
  # fire.** Brightest code in the flame against brightest code on ground well
  # away from it, at 640x400 after 240 ticks:
  #
  #     I      flame   ground   pool >= 200
  #     1.35     253       97           957
  #     3.0      253      141         4,675
  #     6.0      254      193        11,349
  #     12.0     254      243        24,696
  #
  # The flame's core is pinned near 253 by `fireRamp`'s own top rung whatever
  # the light does, so raising the light only closes the gap. By 12 the sand is
  # as bright as the fire, which is a floodlight on a beach.
  #
  # **The shoulder has very little discrimination above about 3x the knee** —
  # everything from linear 2.6 upward lands in sRGB 252-255 — so "spend the
  # range" has a practical ceiling for anything that must stay distinguishable.
  # 3.0 doubles the pool over 1.35 and keeps the fire the brightest thing in
  # the frame, which is what a fire is.
  [node.components.Light]
  intensity = 3.0
  color = [1.0, 0.52, 0.18]

# The flame itself. Additive, so it reads as emission rather than as a lit
# surface — the same blend the explosion fire uses.
[[node]]
name = "Flame"
parent = "Night"
transform = { pos = [12.1, 5.25, 13.3] }

  # **One static quad, and the flame is MARCHED through it.** Not a stack of
  # sprites, and no longer a level set on the quad's own plane either: the
  # fragment integrates the field along its view ray through the emitter's
  # inscribed sphere. One quad still has an overdraw of exactly one, which is
  # what lets the ramp survive everywhere.
  #
  # The clipping argument this comment used to make — an 8-bit target where
  # additive blending pins red after about three layers — was true and is void.
  # ADR 0018 replaced that target with an HDR float frame and a tonemap.
  #
  # `lifetime` is long but BOUNDED. `cargo xtask validate` renders every scene
  # with no `--sim`, and the emitter is warmed up for two lifetimes' worth of
  # ticks — so a nominally infinite life costs millions of ticks per render.
  [node.components.ParticleEmitter]
  burst = 1
  rate = 0.0
  lifetime = 110.0
  lifetime_jitter = 0.0
  speed = 0.0
  spread_degrees = 0.0
  radius = 0.0
  gravity = 0.0
  drag = 0.0
  turbulence = 0.0
  wind_response = 0.0
  # The quad's side. The flame occupies the middle of it and the corners are
  # discarded, so this is comfortably larger than the fire.
  size = [2.2, 2.2]
  alpha = [1.0, 1.0]
  # Only the alpha and the sign of red matter to a flame; the ramp lives in the
  # shader, where it can be capped below 1.0 so nothing clips.
  color_start = [1.0, 1.0, 1.0]
  color_end = [1.0, 1.0, 1.0]
  additive = true
  flame = true

# **The smoke, and it is born where the FLAME DIES rather than at the fuel.**
#
# The flame quad is centred at 5.25 and is 2.2 m tall, so its fuel line is at
# 4.15 and its ceiling at 6.35. Spawning at the emitter base is the commonest
# mistake in the book and reads as two effects standing in the same place; 6.0
# puts the first puff inside the top of the fire, so the flame hands over to the
# smoke instead of the two overlapping. The gap below that is bridged by the
# flame shader's own soot term, which is the same field under a lower ceiling
# and therefore cannot disagree with the flame about where the fire is.
#
# **Many thin puffs, not a few thick ones, and that is what "density
# accumulates" means in an alpha-blended path.** At 30 a second and alpha 0.60 a
# plume is half a dozen separately readable balls — the "N discs" tell, and no
# amount of shading fixes a thing you can count. Ninety-five a second at 0.26
# puts four or five overlapping on any ray, and `1 - (1 - 0.26)^5 = 0.78` is the
# same total opacity arrived at through a stack nobody can resolve.
#
# **The colour is soot, not grey.** `color_start` is 0.03 — three percent
# albedo, roughly what lampblack measures — and the plume is visible at all
# because the fire lights the side of it that faces the fire. That is the whole
# of "black smoke": the engine adds `pointLights` on the puff's sphere normal
# and the scene supplies an albedo dark enough for the far side to stay black.
# Author it at 0.3 and it is grey smoke with a warm edge, which is what every
# plume in this repo was.
[[node]]
name = "Smoke"
parent = "Night"
transform = { pos = [12.1, 6.0, 13.3] }

  [node.components.ParticleEmitter]
  rate = 95.0
  lifetime = 3.2
  lifetime_jitter = 0.4
  speed = 1.15
  spread_degrees = 20.0
  radius = 0.11
  gravity = 0.9
  drag = 0.55
  turbulence = 1.1
  turbulence_scale = 0.35
  wind_response = 2.2
  size = [0.22, 1.55]
  alpha = [0.26, 0.0]
  color_start = [0.030, 0.027, 0.025]
  color_end = [0.014, 0.013, 0.015]
  seed = 4211

[[node]]
name = "Camera"
parent = "Night"
transform = { pos = [12.0, 5.4, 17.4], rot_euler = [-9.0, 0.0, 0.0] }

  [node.components.Camera]
  fov_y_degrees = 55.0
